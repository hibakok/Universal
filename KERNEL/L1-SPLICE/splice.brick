; UNIVERSAL / BRICK v2 / слой L1 / модуль M1-SPLICE (склейка SPLICE v1, SPEC/10)
; Само-исходник splice.exe: сборка корня с директивами !include в плоский текст.
; Сборка: enc.exe splice.b2 splice.brick; brick.exe splice.brick body.bin; pegen.exe body.bin splice.peg splice.exe
; Контракт: splice.exe <корень.b2> <выход.плоско>; не-директивные строки проходят без изменений.
; Регистры: RBX=база образа, R10=база outbuf, R12=курсор вывода, R13=уровень (0..7),
; RSI=курсор текста, R14/R15=начало/конец строки. Подпрограммы сохраняют
; RBX,RSI,R10,R12,R13,R14,R15,RBP; меняют RAX,RCX,RDX,RDI,R8,R9,R11.
; Исключение: handle_line/process_loop меняют RSI и R13 (спуск по уровням).
:entry
H 48 83 EC 38 ; K1-X021 кадр: тень + выравнивание вызовов
H 48 8D 1D $base ; K1-X021 RBX = RVA 0 (база образа)
H 48 C7 C1 F5 FF FF FF ; K1-X021 STD_OUTPUT_HANDLE (-11)
H FF 15 $iat_gsh ; K1-X021 GetStdHandle -> RAX
H 48 89 05 $hstdout ; K1-X021 сохранить хэндл stdout
:get_cmdline
H FF 15 $iat_gcl ; K1-C021 GetCommandLineA -> RAX
H 48 89 C7 ; K1-C021 RDI = курсор командной строки
:skip_argv0
H 0F B6 07 ; K1-C022 очередной символ argv0
H 80 F8 22 ; K1-C022 кавычка?
H 0F 85 $sa_unq ; K1-C022 путь без кавычек
H 48 FF C7 ; K1-C022 пропуск открывающей кавычки
:sa_qloop
H 0F B6 07 ; K1-C022
H 84 C0 ; K1-C022
H 0F 84 $noargs ; K1-C022 конец строки — аргументов нет
H 80 F8 22 ; K1-C022 закрывающая кавычка?
H 0F 84 $sa_adv ; K1-C022
H 48 FF C7 ; K1-C022
H E9 $sa_qloop ; K1-C022
:sa_unq
H 84 C0 ; K1-C022
H 0F 84 $noargs ; K1-C022
H 80 F8 20 ; K1-C022 пробел?
H 0F 84 $sa_delims ; K1-C022
