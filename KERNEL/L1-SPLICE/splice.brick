H 48 83 F8 FF ; K1-G021
H 0F 85 $ok6 ; K1-G021
H B9 05 00 00 00 ; K1-G021 ERR=OPEN OUT
H E8 $print_error ; K1-G022
:ok6
H 49 89 C7 ; K1-G021 R15 = хэндл выхода
H 4C 89 F9 ; K1-G021
H 4C 89 D2 ; K1-G021 буфер вывода
H 4D 89 E0 ; K1-G021
H 4D 29 D0 ; K1-G021 длина вывода
