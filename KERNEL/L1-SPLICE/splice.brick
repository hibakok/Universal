:pl_nolf
H 8B 05 $curline ; K1-S011 номер строки +1
H FF C0 ; K1-S011
H 89 05 $curline ; K1-S011
H E8 $handle_line ; K1-S012
H E9 $process_loop ; K1-S011
:pl_eof
H 4C 39 F6 ; K1-S011 пустой хвост без терминатора?
H 0F 84 $pl_filedone ; K1-S011
H 49 89 F7 ; K1-S011 последняя строка
H 8B 05 $curline ; K1-S011 номер строки +1
