DB 52 45 41 44 20 53 52 43 0D 0A
:err_bigsrc ; bigsrc
DB 55 2D 4C 31 2D 53 50 4C 49 43 45 20 45 52 52 3D ; bigsrc
DB 42 49 47 20 53 52 43 0D 0A
