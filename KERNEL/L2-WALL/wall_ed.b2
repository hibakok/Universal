; ===== K2-E025 get_ext: RCX = индекс earr -> имя (RDX, R8) + scr (RAX = длина) =====
:get_ext
M mov rax, rcx ;E025
M shl rax, 3 ;E025
M lea rdx, [rip+$earr] ;E025
M add rdx, rax ;E025
M mov r9, [rdx] ;E025
M mov rcx, r9 ;E025
M shl rcx, 5 ;E025
M mov rax, r9 ;E025
M shl rax, 3 ;E025
M add rcx, rax ;E025
M lea rax, [rip+$ntab] ;E025
M add rcx, rax ;E025
M mov rdx, [rcx] ;E025
M mov r8, [rcx+8] ;E025
M call $lower_copy ;E012
M ret ;E025
