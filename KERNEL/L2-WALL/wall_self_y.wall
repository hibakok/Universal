; wall_self_y.wall — проход 2 каркаса wall.wall (E6.4d-4/3a..3c-2/3)
; Паспорт: KERNEL/L2-WALL/wall_self_y.wall | слой L2 | роль: реинкарнация
; ветви Y (эмитция, SPEC/11 п.8) компилятора WALL на WALL v2 —
; K2-Y001 pass2 + эмиттеры K2-E015 emit_header / K2-E026 emit_imports /
; K2-E016 emit_entry (срез A, E6.4d-4/3a) + срез B (E6.4d-4/3b):
; K2-Y002 p2_line (цикл строк по карте текстов smem + диспетчер kw —
; форма wall.exe), K2-Y00A p2_funchdr (заголовок func: ftab-раскладка +
; пролог E018 + push bstk {func}), K2-Y003 p2s_var (верхний уровень —
; сброс last_ret), K2-Y004 p2s_end (закрытие func: эпилог E019, если
; не last_ret), K2-Y006/Y007/Y005 (if/while/else — МЕХАНИКА bstk:
; счётчики, push/mutation записей; guard-эмитция p_cond и метки
; E029-E02D — срез C-3) и K2-Y008 p2s_return (срез C-2/1: выражение —
; p_expr(1) эмит-режимом + «M mov rax, r10» + эпилог E019 сразу;
; голый return — только эпилог). Строки канона — по
; смещениям блоба sblob (таблица off/len — wall_self_blob.wall;
; ДЕСЯТИЧНЫЕ литералы). Канон кадров (пролог/эпилог) — эмиттеры части
; wall_self_f.wall.
; Срез C-1 (E6.4d-4/3c-1) замыкает хвост выхода: СЕКЦИИ ДАННЫХ —
; заголовки s_secstr/s_secglob только при непустой секции + вызовы
; emit_strdata/emit_globdata (K2-E027/E028 — часть wall_self_d.wall;
; как Y001 wall.exe: после цикла строк, до предела nlab)
; Срез C-2/1 (E6.4d-4/3c-2/1): КЛАСС ПОЛНОГО ВЫХОДА РАСШИРЕН на
; return <выражение> из чисел/имён (load/addr/len) / скобок / унарного
; '-' и операций + - | ^ & << >> * / % (p_expr/p_mul/p_mdm/p_unary
; эмит-плечами, chain_count — часть wall_self_ph.wall; pass2 ставит
; pc_mode = 1, pass1 — 0). Источники с прочими статами тел (присваивания,
; вызовы, if/while с телами, setb, astore, break/continue) и выражениями
; с getb/индексацией/вызовами компилируются с кодом 0, но их эмитция
; неполна (вне класса среза; bstk-механика сохраняет целостность
; стека блоков). p2_funchdr ставит раскладку текущей функции из ftab в
; глобали st_p2maxd/st_p2maxc/st_p2nbase (аналог 180C8/180D0/180C0
; wall.exe — потребители: адреса T/C/S-слотов эмиттеров) и окно локалей
; lay_lo/lay_hi (аналог 180F0/180F8 — local_find в emit_addr/len/load).
; Счётчик меток выхода nlab (предел 2000, строка 0)
; проверяется в конце прохода — как Y001 wall.exe.
; Срез C-2/3 (E6.4d-4/3c-2/3): диспетчер p2_line дополнен плечами
; kwi == 9 (setb -> p2s_setb) и именами (цепочка kw-плеч падает в
; p2_namestmt — как Y002 wall.exe; break/continue 12/13 — пропуск
; до среза C-3) — УТВЕРЖДЕНИЯ эмитции (K2-Y009/K2-Y00B/E02D) —
; НОВАЯ часть wall_self_t.wall.

; проход 2: сброс счётчиков; пролог; цикл строк по smem; предел nlab
func pass2
  var i
  var t0
  var t1
  outcur = 0
  nlab = 0
  curline = 0
  st_bcnt = 0
  ifseq = 0
  st_ifcnt = 0
  st_infunc = 0
  st_lret = 0
  st_fbase = 0
  pc_mode = 1
  emit_header()
  emit_imports()
  emit_entry()
  i = 1
  while i <= nlentries
    curline = i
    t0 = getq(smem + 16 * i)
    t1 = getq(smem + 16 * i + 8)
    p2_line(t0, t0 + t1)
    i = i + 1
  end
  ; секции данных (K2-E027/E028, срез C-1): заголовок + тело — только
  ; при непустой секции (как Y001 wall.exe); после цикла строк и до
  ; предела nlab (метки :имя — внутри emit_strdata/emit_globdata)
  if scount > 0
    out_line(1739, 36)
    emit_strdata()
  end
  if vcount > 0
    out_line(1552, 95)
    emit_globdata()
  end
  if nlab > 2000
    curline = 0
    fail_format(curline)
  end
  return 0
end

; диспетчер строки прохода 2 (K2-Y002): pos — начало текста строки
; (смещение в srcbuf), le — конец; текст строки -> cmt_ptr/cmt_len
; (комментарии статов — как [181A0/181A8] wall.exe; карта текстов
; хранит строку без пробелов/табов по краям и без «;»-хвоста);
; kw-плечи — форма wall.exe Y002 (func — раньше проверки «в функции»;
; вне функции строки — только объявления, эмитции нет; не-имя —
; стенка, недостижимо: проход 1 уже отверг — у wall.exe там int3);
; setb (9) — p2s_setb, имя-утверждение — p2_namestmt (срез C-2/3),
; break/continue — пропуск до среза C-3
func p2_line(pos, le)
  var k
  var kwi
  cmt_ptr = pos
  cmt_len = le - pos
  k = tok_next(pos, le)
  if k == 4
    return 0
  end
  if k != 1
    fail_format(curline)
  end
  kwi = kw_lookup(tokptr, tokend - tokptr)
  if kwi == 3
    return p2_funchdr(tokend, le)
  end
  if st_infunc != 0
    if kwi == 0
      return p2s_var(tokend, le)
    end
    if kwi == 4
      return p2s_end(tokend, le)
    end
    if kwi == 5
      return p2s_else(tokend, le)
    end
    if kwi == 6
      return p2s_if(tokend, le)
    end
    if kwi == 7
      return p2s_while(tokend, le)
    end
    if kwi == 8
      return p2s_return(tokend, le)
    end
    if kwi == 9
      return p2s_setb(tokend, le)
    end
    if kwi == 12
      return 0
    end
    if kwi == 13
      return 0
    end
    ; имя-утверждение (kwi == -1 и kw-имена вне плеч — цепочка
    ; kw-плеч падает в p2_namestmt, как Y002 wall.exe); setb —
    ; p2s_setb; break/continue (12/13) — guard-эмитция среза C-3
    ; (пропуск: bstk эти статы не трогают — целостность стека
    ; блоков сохраняется)
    return p2_namestmt(tokend, le)
  end
  return 0
end

; заголовок func в проходе 2 (K2-Y00A): имя -> ntab -> мета = fidx;
; curf/fname; пролог E018; push bstk {kind 1}; параметры строки
; пропускаются (карта текстов — по записям, не по токенам)
func p2_funchdr(pos, le)
  var nptr
  var nln
  var fidx
  pos = want_id(pos, le)
  nptr = tokptr
  nln = tokend - tokptr
  fidx = names_find(nptr, nln)
  fidx = getq(tabmem + 40 * fidx + 24)
  curf = fidx
  ; раскладка текущей функции из ftab (ставит Y00A wall.exe в
  ; 180C8/180D0/180C0/180F0/180F8): maxd/maxc/nbase — адреса T/C/S-
  ; слотов эмиттеров, окно lay — local_find (emit_addr/emit_len/
  ; emit_load части wall_self_g.wall)
  st_p2maxd = getq(tabmem + 2228224 + curf * 80 + 24)
  st_p2maxc = getq(tabmem + 2228224 + curf * 80 + 32)
  st_p2nbase = getq(tabmem + 2228224 + curf * 80 + 72)
  lay_lo = getq(tabmem + 2228224 + curf * 80 + 48)
  lay_hi = getq(tabmem + 2228224 + curf * 80 + 56)
  st_fptr = nptr
  st_flen = nln
  emit_prologue()
  st_fbase = st_bcnt
  stq(tabmem + 4587584 + st_bcnt * 32, 1)
  stq(tabmem + 4587584 + st_bcnt * 32 + 8, 0)
  stq(tabmem + 4587584 + st_bcnt * 32 + 16, 0)
  st_bcnt = st_bcnt + 1
  st_infunc = 1
  st_lret = 0
  return 0
end

; локаль в проходе 2 (K2-Y003): строка не эмитится; если стек блоков
; пуст до записи функции (bstk == fbase+1 — верхний уровень тела),
; last_ret сбрасывается (как Y003 wall.exe)
func p2s_var(pos, le)
  if st_bcnt == st_fbase + 1
    st_lret = 0
  end
  return 0
end

; закрытие блока end в проходе 2 (K2-Y004): pop bstk; func — эпилог
; E019, если не last_ret (последний return уже эмитил), сброс
; «в функции»; while (обратный jmp + :_w<ke>) и if/else (:_if<ke>)
; — срез C (эмиттеры E02A/E02B/E02C + srctxt из строки цикла)
func p2s_end(pos, le)
  var kind
  st_bcnt = st_bcnt - 1
  kind = getq(tabmem + 4587584 + st_bcnt * 32)
  if kind == 1
    if st_lret == 0
      emit_epilogue()
    end
    st_infunc = 0
    st_lret = 0
    return 0
  end
  return 0
end

; if в проходе 2 (K2-Y006, МЕХАНИКА среза B): ifseq++ (счётчик
; прохода 2 — сбрасывается в pass2, как 18120 wall.exe), счётчик
; if/while k++; e = ifarr[ifseq] читает СТАТИЧЕСКУЮ ветвь (срез C —
; guard-эмитция p_cond с E029/E036-E038); push bstk {2, k, ifseq,
; lineidx}; верхний уровень: last_ret = 0
func p2s_if(pos, le)
  ifseq = ifseq + 1
  st_ifcnt = st_ifcnt + 1
  stq(tabmem + 4587584 + st_bcnt * 32, 2)
  stq(tabmem + 4587584 + st_bcnt * 32 + 8, st_ifcnt)
  stq(tabmem + 4587584 + st_bcnt * 32 + 16, ifseq)
  stq(tabmem + 4587584 + st_bcnt * 32 + 24, curline)
  st_bcnt = st_bcnt + 1
  if st_bcnt == st_fbase + 1
    st_lret = 0
  end
  return 0
end

; while в проходе 2 (K2-Y007, МЕХАНИКА среза B): счётчик if/while k++
; (:_w<k> + guard — срез C); push bstk {4, k, 0, lineidx}; верхний
; уровень: last_ret = 0
func p2s_while(pos, le)
  st_ifcnt = st_ifcnt + 1
  stq(tabmem + 4587584 + st_bcnt * 32, 4)
  stq(tabmem + 4587584 + st_bcnt * 32 + 8, st_ifcnt)
  stq(tabmem + 4587584 + st_bcnt * 32 + 16, 0)
  stq(tabmem + 4587584 + st_bcnt * 32 + 24, curline)
  st_bcnt = st_bcnt + 1
  if st_bcnt == st_fbase + 1
    st_lret = 0
  end
  return 0
end

; else в проходе 2 (K2-Y005, МЕХАНИКА среза B): верхняя запись bstk
; kind 2 -> 3, мутация на месте (k/seq сохраняются; jmp $_if<ke> +
; :_if<k> и srctxt из строки if — срез C); проверка «выше if» уже
; сделана проходом 1 (p1s_else)
func p2s_else(pos, le)
  var k
  var seq
  st_bcnt = st_bcnt - 1
  k = getq(tabmem + 4587584 + st_bcnt * 32 + 8)
  seq = getq(tabmem + 4587584 + st_bcnt * 32 + 16)
  stq(tabmem + 4587584 + st_bcnt * 32, 3)
  stq(tabmem + 4587584 + st_bcnt * 32 + 8, k)
  stq(tabmem + 4587584 + st_bcnt * 32 + 16, seq)
  st_bcnt = st_bcnt + 1
  return 0
end

; return в проходе 2 (K2-Y008, срез C-2/1): выражение — p_expr(1)
; эмит-режимом (канон: значение в r10) + «M mov rax, r10» с комментарием
; текущей строки, затем эпилог E019 (как для голого return, так и после
; выражения); верхний уровень тела: last_ret = 1 (эпилог конца функции
; не дублируется — канон SPEC/11 п.8)
func p2s_return(pos, le)
  pcur = pos
  ple = le
  if tok_next(pcur, ple) != 4
    p_expr(1)
    out_str(1416, 14)
    emit_cmt()
  end
  emit_epilogue()
  if st_bcnt == st_fbase + 1
    st_lret = 1
  end
  return 0
end

; 2 строки заголовка (K2-E015): версия — по флагу v2flag; счётчики
func emit_header
  if v2flag == 0
    out_line(804, 90)
  else
    out_line(1900, 90)
  end
  out_str(713, 20)
  out_dec(nlines)
  out_str(733, 29)
  out_dec(fcount)
  out_str(762, 7)
  out_dec(ecount)
  out_str(769, 7)
  out_dec(scount)
  out_str(776, 28)
  out_dec(vcount)
  out_ch(10)
  return 0
end

; область импортов 0x200 (K2-E026, SPEC/11 п.6)
func emit_imports
  var i
  var j
  var n
  out_line(1647, 92)
  out_line(1137, 5)
  nlab = nlab + 1
  if ecount > 0
    out_line(914, 70)
  else
    out_line(984, 38)
  end
  out_line(1022, 32)
  out_line(1132, 5)
  nlab = nlab + 1
  i = 0
  while i < ecount
    get_ext(i)
    out_str(908, 6)
    out_copy(scrbuf, ext_nlen)
    out_ch(10)
    nlab = nlab + 1
    out_str(95, 10)
    out_copy(scrbuf, ext_nlen)
    out_ch(10)
    i = i + 1
  end
  out_str(92, 3)
  n = 9 - ecount
  if n > 0
    out_str(1855, 1)
    while n > 1
      out_ch(32)
      out_str(1855, 1)
      n = n - 1
    end
  end
  out_ch(10)
  out_line(1142, 6)
  nlab = nlab + 1
  out_str(92, 3)
  i = 0
  while i < 9
    if i > 0
      out_ch(32)
    end
    if i < ecount
      get_ext(i)
      out_str(901, 7)
      out_copy(scrbuf, ext_nlen)
    else
      out_str(1855, 1)
    end
    i = i + 1
  end
  out_ch(10)
  if ecount > 0
    out_line(1087, 5)
    nlab = nlab + 1
    out_line(32, 60)
    out_line(109, 31)
    i = 0
    while i < 8
      if i < ecount
        get_ext(i)
        out_str(894, 7)
        out_copy(scrbuf, ext_nlen)
        out_ch(10)
        nlab = nlab + 1
        out_str(29, 3)
        j = 0
        while j < 34
          if j >= 2
            if j - 2 < ext_nlen
              out_hex2(getb(srcbuf + ext_nptr, j - 2))
            else
              out_hex2(0)
            end
          else
            out_hex2(0)
          end
          j = j + 1
          if j < 34
            out_ch(32)
          end
        end
        out_str(1509, 4)
        out_copy(srcbuf + ext_nptr, ext_nlen)
        out_str(1513, 1)
        out_ch(10)
      else
        out_line(663, 50)
      end
      i = i + 1
    end
    out_line(224, 58)
  else
    out_line(140, 84)
  end
  return 0
end

; секция кода + вход (K2-E016, SPEC/11 п.7)
func emit_entry
  out_line(1536, 16)
  out_line(1125, 7)
  nlab = nlab + 1
  out_line(288, 85)
  out_line(373, 40)
  out_line(413, 81)
  return 0
end
