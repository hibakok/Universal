; wall_self_p1s.wall — утверждения прохода 1 каркаса wall.wall (E6.4d-2/4, E6.4d-3/1..3/2)
; Паспорт: KERNEL/L2-WALL/wall_self_p1s.wall | слой L2 | роль: реинкарнация
; ветви статов прохода 1 (K2-S006..S00F, wall_p1s.b2) на самом языке
; WALL v2. E6.4d-2/4: K2-S007 p1s_end — закрытие блока end:
; at_end, при fdepth == 0 — лишний end (ERR=FORMAT текущей строки);
; pop bstk (запись 32 Б {kind, k, ifseq, lineidx} — дефект №15; в
; каркасе до E6.4d-3/3 записи kind 1 — func (пушит S004 части pd) и
; kind 2/4 — if/while (будут пушить S009/S00A));
; kind 1 — финальная запись ftab[curf]: maxd, maxc, flags (бит 0 —
; st_setb, бит 1 — st_ext5), loccnt, nslots — и fcur = 0 (функция
; закрыта); kind 2/3 (if/while/else) — проход 1 у wall.exe больше
; ничего не делает.
; E6.4d-3/1: K2-S006 p1s_var — локальное объявление var имя [n]:
; want_id + chk_name, опциональный [n] (arr_size P019: 1..4096,
; ставит v2flag), at_end, дубликат в окне текущей функции
; [st_locoff, st_locoff + st_loccnt) (побайтовое сравнение larr,
; как fh_param части pd), конфликт с глобальными (names_find),
; larr-запись 32 Б {ptr, len, size} под индексом lcount, lcount++,
; st_loccnt++, st_nslots += size — порядок проверок == wall.exe ==
; оракул parse (имя, [n], at_end, дубликат, глобаль).
; E6.4d-3/2: K2-S00B p1s_return — return [выр]: выражение есть —
; p_expr(1) (уровни — часть ph) и maxd = max(maxd, need); нет — сразу
; at_end (плечо p1r_noexpr). K2-S00C p1s_setb — setb(выр, выр, выр):
; три p_expr(1) c maxd-обновлением между want_sym1 '(' ',' ',' ')',
; at_end, st_setb = 1 (флаг S-слотов). K2-S00D p1_namestmt —
; утверждение-имя (вызов / astore / присваивание): имя сохраняется
; ДО потребления; заглядывание следующего токена: '(' — вызов
; (p_args(1) + call_stats части pa — maxc/ext5, at_end); '[' — astore
; (pp_pcount части pp — k пар; astore_chk части pa — цель допустима;
; k > 1 — база-цепочка pp_prim0(k) + pp_pairs(1, k-1, 0) = need
; базы; последняя пара '[' выр ']' '=' выр ПОРОЗНЬ; maxd = max по
; базе/индексу/значению; st_setb = 1); иначе — присваивание: '='
; p_expr(1), maxd, at_end. Прочие статы (S008 else, S009 if, S00A
; while, S00F break/continue — bstk-механика) — следующий под-шаг
; E6.4d-3/3; у wall.exe их kw-индексы (5/6/7/C/D) идут в собственные
; плечи kwstmt ДО namestmt — в каркасе до E6.4d-3/3 они проваливаются
; в p1_namestmt (kw-имя как обычное имя) и на классе корпуса дают
; ERR=FORMAT той же строки; патологические «KW = выр» / «KW(арг)»
; namestmt принимает — источники вне класса (см. _expect_line и
; VERIFY-E6D).
; bstk — в куче tabmem+4587584, 3072x32 (как bstk wall.exe 0x18000/32;
; ёмкость 3072 записей — дефект №15: площадь та же, записи шире).

; локальное объявление: var имя ['[' n ']'] (K2-S006); pos — курсор
; за ключевым словом var (его лекснул диспетчер p1_line части p1).
; Дубликат в окне — local_find по копии окна st в lay (предикат тот же,
; что у инлайн-скана p1v_scan wall.exe: длина + побайтовое сравнение;
; экономия меток выхода)
func p1s_var(pos, le)
  var nptr
  var nln
  var size
  pos = want_id(pos, le)
  chk_name(0)
  nptr = tokptr
  nln = tokend - tokptr
  size = arr_size(pos, le)
  at_end(aspos, le)
  lay_lo = st_locoff
  lay_hi = st_loccnt
  if local_find(nptr, nln) != -1
    fail_format(curline)
  end
  if names_find(nptr, nln) != -1
    fail_format(curline)
  end
  stq(tabmem + 3539008 + lcount * 32, nptr)
  stq(tabmem + 3539008 + lcount * 32 + 8, nln)
  stq(tabmem + 3539008 + lcount * 32 + 16, size)
  lcount = lcount + 1
  st_loccnt = st_loccnt + 1
  st_nslots = st_nslots + size
  return 0
end

; закрытие блока: end (K2-S007); pos — курсор за ключевым словом
func p1s_end(pos, le)
  var kind
  var flags
  at_end(pos, le)
  if fdepth == 0
    fail_format(curline)
  end
  fdepth = fdepth - 1
  kind = getq(tabmem + 4587584 + fdepth * 32)
  if kind == 1
    stq(tabmem + 2228224 + curf * 80 + 24, st_maxd)
    stq(tabmem + 2228224 + curf * 80 + 32, st_maxc)
    flags = 0
    if st_setb != 0
      flags = 1
    end
    if st_ext5 != 0
      flags = flags + 2
    end
    stq(tabmem + 2228224 + curf * 80 + 40, flags)
    stq(tabmem + 2228224 + curf * 80 + 56, st_loccnt)
    stq(tabmem + 2228224 + curf * 80 + 72, st_nslots)
    fcur = 0
  end
  return 0
end

; return [выр] (K2-S00B); pos — курсор за ключевым словом return
func p1s_return(pos, le)
  var need
  pcur = pos
  ple = le
  if tok_next(pcur, ple) != 4
    need = p_expr(1)
    st_maxd = max2(st_maxd, need)
  end
  at_end(pcur, le)
  return 0
end

; setb(выр, выр, выр) (K2-S00C); pos — курсор за ключевым словом setb
func p1s_setb(pos, le)
  var need
  pcur = pos
  ple = le
  pcur = want_sym1(40, pcur, ple)
  need = p_expr(1)
  st_maxd = max2(st_maxd, need)
  pcur = want_sym1(44, pcur, ple)
  need = p_expr(1)
  st_maxd = max2(st_maxd, need)
  pcur = want_sym1(44, pcur, ple)
  need = p_expr(1)
  st_maxd = max2(st_maxd, need)
  pcur = want_sym1(41, pcur, ple)
  at_end(pcur, le)
  st_setb = 1
  return 0
end

; утверждение-имя: вызов / astore / присваивание (K2-S00D); pos —
; курсор ЗА именем (имя — в tokptr/tokend на входе, как tok_ptr/
; tok_end wall.exe)
func p1_namestmt(pos, le)
  var iptr
  var ilen
  var k
  var nbase
  iptr = tokptr
  ilen = tokend - tokptr
  pcur = pos
  ple = le
  if tok_next(pcur, ple) == 2 && tokend - tokptr == 1 && getb(srcbuf, tokptr) == 40
    ; вызов-утверждение: имя(аргументы)
    pcur = tokend
    p_args(1)
    call_stats(iptr, ilen)
    at_end(pcur, le)
    return 0
  end
  if tok_next(pcur, ple) == 2 && tokend - tokptr == 1 && getb(srcbuf, tokptr) == 91
    ; astore: имя[выр]... = выр
    k = pp_pcount()
    astore_chk(iptr, ilen)
    nbase = 0
    if k > 1
      ; база-цепочка: перепознание prim на глубине k + пары 1..k-1
      pcur = iptr
      pp_prim0(k)
      nbase = pp_pairs(1, k - 1, 0)
    end
    ; последняя пара и значение — порознь (S-стейджинг)
    pcur = want_sym1(91, pcur, ple)
    st_maxd = max2(st_maxd, p_expr(1))
    pcur = want_sym1(93, pcur, ple)
    pcur = want_sym1(61, pcur, ple)
    st_maxd = max2(st_maxd, p_expr(1))
    at_end(pcur, le)
    st_maxd = max2(st_maxd, nbase)
    st_setb = 1
    return 0
  end
  ; присваивание: имя = выр
  pcur = want_sym1(61, pcur, ple)
  st_maxd = max2(st_maxd, p_expr(1))
  at_end(pcur, le)
  return 0
end
