; wall_self_pd.wall — объявления прохода 1 каркаса wall.wall (E6.4d-2/3)
; Паспорт: KERNEL/L2-WALL/wall_self_pd.wall | слой L2 | роль: реинкарнация
; K2-S003 p1_decl (wall_pd.b2) на самом языке WALL v2: разбор строки
; объявления в режиме до первой func — var (скаляр или массив [n] с
; 1..4096 — вид 5), str (имя = 'литерал'; litptr/litlen — содержимое
; без кавычек, в sarr), ext (имя <= 31 байта, без учёта регистра;
; earr, <= 8 — SPEC/11 п.6). Курсор pos — за ключевым словом (его
; лекснул диспетчер p1_line части p1). Ошибки — fail_format(curline):
; код 6 ERR=FORMAT AT=XXXX, строки == wall.exe == оракул parse.
; Порядок проверок == wall.exe (важно для номера строки ошибки):
; var: want_id, chk_name, [n], at_end, дубликат, запись;
; str: want_id, chk_name, '=', литерал (вид 3), at_end, дубликат;
; ext: want_id, chk_name, <= 31, at_end, дубликат-ci, <= 8.
; Отличия от wall.exe (эквивалентность выхода сохранена):
; 1) нет str_dlen/E013: длина литерала <= 512 проверена в проходе 0
;    (slen при накоплении, как оракул _lex); у wall.exe — в проходе 1;
;    литерал не переходит границу строк — выход тот же;
; 2) таблицы значений (varr/sarr/earr) — в куче tabmem со смещениями
;    (1310720/1835008/3538944), записи {…} как у wall.exe; ntab-индекс
;    записи = ncount - 1 после names_add (мета — старый счётчик таблицы,
;    как r9 у wall.exe: vcount/scount/ecount до инкремента).

; разбор объявления: kwi — индекс ключевого слова (0 var, 1 str, 2 ext;
; иное/не-ключевое имя — ERR=FORMAT), pos — курсор за ключевым словом
func p1_decl(kwi, pos, le)
  var nptr
  var nln
  var litptr
  var litln
  var size
  var kind
  if kwi == 0
    pos = want_id(pos, le)
    chk_name(0)
    nptr = tokptr
    nln = tokend - tokptr
    size = arr_size(pos, le)
    at_end(aspos, le)
    if names_find(nptr, nln) != -1
      fail_format(curline)
    end
    if asflag == 1
      kind = 5
    else
      kind = 1
    end
    names_add(nptr, nln, kind, vcount)
    stq(tabmem + 1310720 + vcount * 16, ncount - 1)
    stq(tabmem + 1310720 + vcount * 16 + 8, size)
    vcount = vcount + 1
    return 0
  end
  if kwi == 1
    pos = want_id(pos, le)
    chk_name(0)
    nptr = tokptr
    nln = tokend - tokptr
    pos = want_sym1(61, pos, le)
    if tok_next(pos, le) != 3
      fail_format(curline)
    end
    litptr = tokptr
    litln = tokend - tokptr - 1
    at_end(tokend, le)
    if names_find(nptr, nln) != -1
      fail_format(curline)
    end
    names_add(nptr, nln, 2, scount)
    stq(tabmem + 1835008 + scount * 24, ncount - 1)
    stq(tabmem + 1835008 + scount * 24 + 8, litptr)
    stq(tabmem + 1835008 + scount * 24 + 16, litln)
    scount = scount + 1
    return 0
  end
  if kwi == 2
    pos = want_id(pos, le)
    chk_name(1)
    if tokend - tokptr > 31
      fail_format(curline)
    end
    nptr = tokptr
    nln = tokend - tokptr
    at_end(pos, le)
    if names_find_ci(nptr, nln) != -1
      fail_format(curline)
    end
    if ecount >= 8
      fail_format(curline)
    end
    names_add(nptr, nln, 3, ecount)
    stq(tabmem + 3538944 + ecount * 8, ncount - 1)
    ecount = ecount + 1
    return 0
  end
  fail_format(curline)
  return 0
end
