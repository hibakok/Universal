; wall_self_p1.wall — каркас прохода 1 каркаса wall.wall (E6.4d-2/3..2/4, E6.4d-3/1)
; Паспорт: KERNEL/L2-WALL/wall_self_p1.wall | слой L2 | роль: реинкарнация
; K2-S001 pass1 + K2-S002 p1_line (wall_p1.b2) и K2-N004 set_lastline
; (wall_n.b2) на самом языке WALL v2. Цикл строк идёт по карте текстов
; smem (записи 1..nlentries — {смещение, длина}, читатели getq/getb),
; а не повторным разбиением, как line_next у wall.exe: записи те же
; (проход 0), curline = номер записи до разбора строки. Диспетчер —
; финальная форма wall.exe (E6.4d-3/1): пустая строка — пропуск;
; не-имя — ERR=FORMAT; func — p1_funchdr части pd (ЗАГОЛОВКИ РЕАЛИЗОВАНЫ;
; плече раньше fcur — quirk wall.exe: «func g» внутри тела — новый
; заголовок); тело функции (fcur) — var — локальное объявление
; (p1s_var части p1s: E6.4d-3/1 РЕАЛИЗОВАНО), end закрывает func
; (p1s_end части p1s: финальная запись ftab, fcur = 0), прочие статы —
; ERR=FORMAT (S008+ — следующие под-шаги E6.4d-3); между func
; (seenfunc) — ERR=FORMAT; объявления (до func) — p1_decl части pd. Пост-проверки: незакрытый блок
; (fdepth/fcur) и ровно одна main без параметров (ftab; main
; с параметрами — ошибка в строке заголовка main; имя сравнивается
; по смещению в srcbuf — getb(srcbuf, np+k), np — СМЕЩЕНИЕ из ftab).
; v2flag — флаг v2 (массивы/статы; ставит arr_size), обнуляется здесь;
; читается проходом 2 (шаги E6.4d-3+). lcount — счётчик larr (параметры;
; обнуляется здесь, как [r13+18138] wall.exe).

; curline := последняя непустая | nlentries (K2-N004)
func set_lastline
  if lastnonempty != 0
    curline = lastnonempty
  else
    curline = nlentries
  end
  return 0
end

; диспетчер строки прохода 1: текст строки [pos, pos+len) из smem
func p1_line(pos, le)
  var k
  var kwi
  k = tok_next(pos, le)
  if k == 4
    return 0
  end
  if k != 1
    fail_format(curline)
  end
  kwi = kw_lookup(tokptr, tokend - tokptr)
  if kwi == 3
    return p1_funchdr(tokend, le)
  end
  if fcur != 0
    if kwi == 0
      return p1s_var(tokend, le)
    end
    if kwi == 4
      return p1s_end(tokend, le)
    end
    fail_format(curline)
  end
  if seenfunc != 0
    fail_format(curline)
  end
  return p1_decl(kwi, tokend, le)
end

; проход 1: цикл по записям карты текстов + пост-проверки
func pass1
  var i
  var t0
  var t1
  var np
  var nl
  var mcount
  var mline
  var mparams
  ncount = 0
  fcount = 0
  lcount = 0
  scount = 0
  vcount = 0
  ecount = 0
  fdepth = 0
  seenfunc = 0
  fcur = 0
  v2flag = 0
  i = 1
  while i <= nlentries
    curline = i
    t0 = getq(smem + 16 * i)
    t1 = getq(smem + 16 * i + 8)
    p1_line(t0, t0 + t1)
    i = i + 1
  end
  if fdepth != 0
    set_lastline()
    fail_format(curline)
  end
  if fcur != 0
    set_lastline()
    fail_format(curline)
  end
  i = 0
  mcount = 0
  while i < fcount
    np = getq(tabmem + 2228224 + 80 * i)
    nl = getq(tabmem + 2228224 + 80 * i + 8)
    if nl == 4
      if getb(srcbuf, np) == 109 && getb(srcbuf, np + 1) == 97 && getb(srcbuf, np + 2) == 105 && getb(srcbuf, np + 3) == 110
        mline = getq(tabmem + 2228224 + 80 * i + 64)
        mparams = getq(tabmem + 2228224 + 80 * i + 16)
        mcount = mcount + 1
      end
    end
    i = i + 1
  end
  if mcount == 1
    if mparams == 0
      return 0
    end
    curline = mline
    fail_format(curline)
  end
  set_lastline()
  fail_format(curline)
  return 0
end
