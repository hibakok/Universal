M mov ecx, 43 ;P010
M call $out_str ;E003
M mov rax, [rbp-28] ;P010
M call $out_hex ;E005
M mov ecx, 58 ;P010
M call $out_str ;E003
M call $emit_cmt ;E009
M mov rcx, [rbp-18] ;P010
M add rcx, 1 ;P010
M call $p_mul ;P011
M mov ecx, 4D ;P010
M call $out_str ;E003
M call $emit_cmt ;E009
M mov ecx, 45 ;P010
M call $out_str ;E003
M mov rax, [r13+180C0] ;P010
M add rax, [rbp-18] ;P010
M shl rax, 3 ;P010
M call $out_hex ;E005
M mov byte [r12], 5D ;P010
M inc r12 ;P010
