M jbe $p2_ret ;Y001
M xor eax, eax ;Y001
M mov [r13+18020], rax ;Y001
M call $fail_format ;G002
:p2_ret
M mov rsp, rbp ;Y001
M pop rbp ;Y001
M ret ;Y001
