M mov rcx, [r13+18070] ;P014
M call $lex_tok ;L001
M cmp eax, 2 ;P014
M jne $pa_first ;P014
M mov rax, [r13+18068] ;P014
M sub rax, [r13+18060] ;P014
M cmp rax, 1 ;P014
M jne $pa_first ;P014
M mov rcx, [r13+18060] ;P014
M movzx eax, byte [rcx] ;P014
M cmp al, 29 ;P014
M je $pa_close ;P014
:pa_first
M mov rcx, [rbp-8] ;P014
M call $p_expr ;P010
M call $pa_stage ;P017
:pa_loop
M mov rcx, [r13+18070] ;P014
M call $lex_tok ;L001
M cmp eax, 2 ;P014
M jne $pa_close_want ;P014
M mov rax, [r13+18068] ;P014
M sub rax, [r13+18060] ;P014
M cmp rax, 1 ;P014
M jne $pa_close_want ;P014
M mov rcx, [r13+18060] ;P014
M movzx eax, byte [rcx] ;P014
M cmp al, 2C ;P014
M jne $pa_close_want ;P014
M mov rcx, [r13+18068] ;P014
M mov [r13+18070], rcx ;P014
M mov rcx, [rbp-8] ;P014
M call $p_expr ;P010
M call $pa_stage ;P017
M jmp $pa_loop ;P014
:pa_close
M mov rcx, [r13+18068] ;P014
M mov [r13+18070], rcx ;P014
M jmp $pa_ret ;P014
:pa_close_want
M mov ecx, 29 ;P014
M call $want_sym1 ;P001
:pa_ret
M mov rsp, rbp ;P014
M pop rbp ;P014
M ret ;P014
; ===== K2-P017 pa_stage: стейджинг одного аргумента (после p_expr) =====
; RAX = need; значение — в r10 (эмит). i-й аргумент -> C-слот c(i);
; 5-й аргумент ext-вызова -> S5 (флаг pc_extflg установлен вызывающим).
:pa_stage
M mov rdx, [r13+181E8] ;P017
M inc rdx ;P017
M mov [r13+181E8], rdx ;P017
M mov [r13+181F8], rax ;P017
M mov rax, [r13+18080] ;P017
M test rax, rax ;P017
M jz $pas_st ;P017
M mov ecx, 43 ;P017
M call $out_str ;E003
