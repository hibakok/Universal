M add rax, [r13+180C8] ;P017
M mov rcx, [r13+18088] ;P017
M test rcx, rcx ;P017
M jz $pas_cslot ;P017
M mov rcx, [r13+181E8] ;P017
M cmp rcx, 5 ;P017
M jne $pas_cslot ;P017
; S5 = s(3) = nbase+maxd+maxc+4
M add rax, [r13+180D0] ;P017
M add rax, 4 ;P017
M jmp $pas_emitoff ;P017
:pas_cslot
M add rax, [r13+181E8] ;P017
:pas_emitoff
M shl rax, 3 ;P017
M call $out_hex ;E005
M mov ecx, 58 ;P017
M call $out_str ;E003
M call $emit_cmt ;E009
:pas_st
M mov rax, [r13+181F8] ;P017
M cmp [r13+181F0], rax ;P017
M jge $pas_ret ;P017
M mov [r13+181F0], rax ;P017
:pas_ret
M ret ;P017
