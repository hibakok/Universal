; UNIVERSAL / BRICK v2 / слой L2 / модуль M2-WALL — аргументы и вызовы
; ===== K2-P014 p_args: аргументы вызова до ')' включительно; RCX = d =====
; '(' уже поглощено. tmp5 = число аргументов; tmp6 = max need.
:p_args
M push rbp ;P014
M mov rbp, rsp ;P014
M sub rsp, 20 ;P014
M mov [rbp-8], rcx ;P014
M xor eax, eax ;P014
