; UNIVERSAL / BRICK v2 / слой L2 / модуль M2-WALL — аргументы и вызовы
; ===== K2-P014 p_args: аргументы вызова до ')' включительно; RCX = d =====
; '(' уже поглощено. Фикс №19 (E6.4d-4/2): счётчики — в РАМКЕ (d, base,
; cnt, mx, eflg, need), вложенные вызовы в аргументах не затирают
; состояние объемлющего. Глобальные: pc_cact [18050] — вложенность
; (0 = верхний вызов), pc_staged [181F8] — застейджено аргументов самым
; внутренним АКТИВНЫМ вызовом (вход: base := pc_staged, если вложен),
; pc_cbase [18078] и tmp5 [181E8] — база/счёт ТОЛЬКО ЧТО закрытого
; вызова (читают P015/P016). Выход: RAX = max need аргументов.
:p_args
M push rbp ;P014
M mov rbp, rsp ;P014
M sub rsp, 30 ;P014
M mov [rbp-8], rcx ;P014 d
M mov rax, [r13+18050] ;P014
M test rax, rax ;P014
M jz $pa_top ;P014
M mov rax, [r13+181F8] ;P014
M jmp $pa_base ;P014
:pa_top
M xor eax, eax ;P014
:pa_base
M mov [rbp-10], rax ;P014 base
M mov rax, [r13+18050] ;P014
M inc rax ;P014
M mov [r13+18050], rax ;P014 pc_cact++
M mov rax, [r13+18088] ;P014
M mov [rbp-28], rax ;P014 eflg (снять ДО вложенных вызовов)
M xor eax, eax ;P014
M mov [r13+181F8], rax ;P014 pc_staged := 0
M mov [rbp-18], rax ;P014 cnt := 0
M mov [rbp-20], rax ;P014 mx := 0
M mov rcx, [r13+18070] ;P014
M call $lex_tok ;L001
M cmp eax, 2 ;P014
M jne $pa_first ;P014
M mov rax, [r13+18068] ;P014
M sub rax, [r13+18060] ;P014
M cmp rax, 1 ;P014
M jne $pa_first ;P014
M mov rcx, [r13+18060] ;P014
M movzx eax, byte [rcx] ;P014
M cmp al, 29 ;P014
M je $pa_close ;P014
:pa_first
M mov rcx, [rbp-8] ;P014
M call $p_expr ;P010
M mov [rbp-30], rax ;P014 need
M mov rcx, [rbp-10] ;P014 base
M mov rdx, [rbp-18] ;P014 cnt
M mov r8, [rbp-28] ;P014 eflg
M call $pa_stage ;P017
M mov rax, [rbp-18] ;P014
M inc rax ;P014
M mov [rbp-18], rax ;P014 cnt++
M mov [r13+181F8], rax ;P014 pc_staged := cnt
M mov rax, [rbp-30] ;P014
M cmp [rbp-20], rax ;P014
M jge $pa_l1 ;P014
M mov [rbp-20], rax ;P014 mx = max(mx, need)
:pa_l1
M jmp $pa_loop ;P014
:pa_loop
M mov rcx, [r13+18070] ;P014
M call $lex_tok ;L001
M cmp eax, 2 ;P014
M jne $pa_close_want ;P014
M mov rax, [r13+18068] ;P014
M sub rax, [r13+18060] ;P014
M cmp rax, 1 ;P014
M jne $pa_close_want ;P014
M mov rcx, [r13+18060] ;P014
M movzx eax, byte [rcx] ;P014
M cmp al, 2C ;P014
M jne $pa_close_want ;P014
M mov rcx, [r13+18068] ;P014
M mov [r13+18070], rcx ;P014 потребить ','
M mov rcx, [rbp-8] ;P014
M call $p_expr ;P010
M mov [rbp-30], rax ;P014 need
M mov rcx, [rbp-10] ;P014
M mov rdx, [rbp-18] ;P014
M mov r8, [rbp-28] ;P014
M call $pa_stage ;P017
M mov rax, [rbp-18] ;P014
M inc rax ;P014
M mov [rbp-18], rax ;P014
M mov [r13+181F8], rax ;P014
M mov rax, [rbp-30] ;P014
M cmp [rbp-20], rax ;P014
M jge $pa_l2 ;P014
M mov [rbp-20], rax ;P014
:pa_l2
M jmp $pa_loop ;P014
:pa_close
M mov rcx, [r13+18068] ;P014
M mov [r13+18070], rcx ;P014
M jmp $pa_ret ;P014
:pa_close_want
M mov ecx, 29 ;P014
M call $want_sym1 ;P001
:pa_ret
M mov rax, [rbp-18] ;P014
M mov [r13+181E8], rax ;P014 tmp5 := cnt (для P015/P016)
M mov rax, [rbp-10] ;P014
M mov [r13+18078], rax ;P014 pc_cbase := base (для P015/P016)
M mov [r13+181F8], rax ;P014 pc_staged := base (восстановить объемлющему)
M mov rax, [r13+18050] ;P014
M dec rax ;P014
M mov [r13+18050], rax ;P014 pc_cact--
M mov rax, [rbp-20] ;P014 RAX = mx (need вызова)
M mov rsp, rbp ;P014
M pop rbp ;P014
M ret ;P014
; ===== K2-P017 pa_stage: эмит стейджинга одного аргумента (после p_expr) =====
; RCX = base, RDX = cnt (до инкремента), R8 = extflg; значение — в r10
; (эмит). Аргумент #(cnt+1) -> C-слот (base+cnt+1) — SPEC/11 п.5/8
; (фикс №19); 5-й аргумент ext-вызова -> S5 (фиксированный слот).
; Стат-режим: не эмитит (счёт — в рамке P014).
:pa_stage
M push rbp ;P017
M mov rbp, rsp ;P017
M sub rsp, 20 ;P017
M mov [rbp-8], rcx ;P017 base
M mov [rbp-10], rdx ;P017 cnt
M mov [rbp-18], r8 ;P017 eflg
M mov rax, [r13+18080] ;P017
M test rax, rax ;P017
M jz $pas_ret ;P017
M mov ecx, 43 ;P017
M call $out_str ;E003
M mov rax, [rbp-18] ;P017
M test rax, rax ;P017
M jz $pas_cslot ;P017
M mov rax, [rbp-10] ;P017
M cmp rax, 4 ;P017
M jne $pas_cslot ;P017
M mov rax, [r13+180C0] ;P017 S5 = nbase+maxd+maxc+4
M add rax, [r13+180C8] ;P017
M add rax, [r13+180D0] ;P017
M add rax, 4 ;P017
M jmp $pas_emitoff ;P017
:pas_cslot
M mov rax, [r13+180C0] ;P017
M add rax, [r13+180C8] ;P017
M add rax, [rbp-8] ;P017 base
M add rax, [rbp-10] ;P017 cnt
M inc rax ;P017 1-базовый номер слота
:pas_emitoff
M shl rax, 3 ;P017
M call $out_hex ;E005
M mov ecx, 58 ;P017
M call $out_str ;E003
M call $emit_cmt ;E009
:pas_ret
M mov rsp, rbp ;P017
M pop rbp ;P017
M ret ;P017
; ===== K2-P015 p_call_tail: загрузки + вызов; имя (RDX, R8), RCX = want =====
; Фикс №19: загрузки аргументов — из C-слотов (pc_cbase + i).
:p_call_tail
M push rbp ;P015
M mov rbp, rsp ;P015
M sub rsp, 28 ;P015
M mov [rbp-8], rcx ;P015
M mov [rbp-10], rdx ;P015
M mov [rbp-18], r8 ;P015
M mov rcx, rdx ;P015
M mov rdx, r8 ;P015
M call $names_find ;P006
M cmp rax, -1 ;P015
M je $pct_unknown ;P015
M mov rcx, rax ;P015
M shl rcx, 5 ;P015
M mov rdx, rax ;P015
M shl rdx, 3 ;P015
M add rcx, rdx ;P015
M lea rdx, [r13+1183D8] ;P015
M add rcx, rdx ;P015
M mov rax, [rcx+10] ;P015
M cmp rax, 4 ;P015
M je $pct_func ;P015
M cmp rax, 3 ;P015
M je $pct_ext ;P015
M jmp $pct_notfunc ;P015
:pct_func
M mov rdx, [rcx+18] ;P015
M mov rax, rdx ;P015
M shl rax, 6 ;P015
M mov rcx, rdx ;P015
M shl rcx, 4 ;P015 ×80 (срез 4)
M add rax, rcx ;P015
M lea rcx, [r13+2583D8] ;P015
M add rcx, rax ;P015
M mov rax, [rcx+10] ;P015
M cmp rax, [r13+181E8] ;P015
M jne $pct_arity ;P015
M xor eax, eax ;P015
M mov [rbp-20], rax ;P015 индекс загрузки (r8 затирается вызовами)
:pct_fload
M mov rax, [rbp-20] ;P015
M cmp rax, [r13+181E8] ;P015
M jae $pct_fcall ;P015
M mov ecx, 40 ;P015
M call $out_str ;E003
M mov rax, [rbp-20] ;P015
M shl rax, 3 ;P015
M lea rdx, [rip+$argtab] ;P015
M add rdx, rax ;P015
M mov eax, [rdx] ;P015
M lea rcx, [rip+$strblob] ;P015
M add rax, rcx ;P015
M mov r9d, [rdx+4] ;P015
M mov rdx, rax ;P015
M mov r8, r9 ;P015
M call $out_copy ;E002
M mov ecx, 3 ;P015
M call $out_str ;E003
M mov rax, [r13+180C0] ;P015
M add rax, [r13+180C8] ;P015
M add rax, [r13+18078] ;P015 pc_cbase (фикс №19)
M mov rcx, [rbp-20] ;P015
M lea rax, [rax+rcx+1] ;P015
M shl rax, 3 ;P015
M call $out_hex ;E005
M mov byte [r12], 5D ;P015
M inc r12 ;P015
M call $emit_cmt ;E009
M mov rax, [rbp-20] ;P015
M inc rax ;P015
M mov [rbp-20], rax ;P015
M jmp $pct_fload ;P015
:pct_fcall
M mov ecx, 3B ;P015
M call $out_str ;E003
M mov rdx, [rbp-10] ;P015
M mov r8, [rbp-18] ;P015
M call $out_copy ;E002
M call $emit_cmt ;E009
M mov rax, [rbp-8] ;P015
M test rax, rax ;P015
M jz $pct_ret ;P015
M mov ecx, 4C ;P015
M call $out_str ;E003
M call $emit_cmt ;E009
M jmp $pct_ret ;P015
:pct_ext
M mov rax, [r13+181E8] ;P015
M cmp rax, 5 ;P015
M ja $pct_ext6 ;P015
M xor eax, eax ;P015
M mov [rbp-20], rax ;P015 индекс загрузки
:pct_eload
M mov rax, [rbp-20] ;P015
M cmp rax, [r13+181E8] ;P015
M jae $pct_eload_done ;P015
M cmp rax, 4 ;P015
M jae $pct_eload_done ;P015
M mov ecx, 40 ;P015
M call $out_str ;E003
M mov rax, [rbp-20] ;P015
M shl rax, 3 ;P015
M lea rdx, [rip+$argtab] ;P015
M add rdx, rax ;P015
M mov eax, [rdx] ;P015
M lea rcx, [rip+$strblob] ;P015
M add rax, rcx ;P015
M mov r9d, [rdx+4] ;P015
M mov rdx, rax ;P015
