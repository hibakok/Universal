; ===== K2-P016 call_stats: статы вызова; RCX = ptr, RDX = len =====
; Фикс №19: maxc = max(maxc, pc_cbase + n) — вложенные вызовы считают
; C-слоты от своей базы (одновременное использование объемлющего).
:call_stats
M call $names_find ;P006
M cmp rax, -1 ;P016
M je $cs_funcish ;P016
M mov rcx, rax ;P016
M shl rcx, 5 ;P016
M mov rdx, rax ;P016
M shl rdx, 3 ;P016
M add rcx, rdx ;P016
M lea rdx, [r13+1183D8] ;P016
M add rcx, rdx ;P016
M mov rax, [rcx+10] ;P016
M cmp rax, 3 ;P016
M je $cs_ext ;P016
:cs_funcish
M mov rax, [r13+181E8] ;P016
M add rax, [r13+18078] ;P016 + pc_cbase (фикс №19)
M cmp rax, [r13+18098] ;P016
M jbe $cs_ret ;P016
M mov [r13+18098], rax ;P016
M jmp $cs_ret ;P016
:cs_ext
M mov rax, [r13+181E8] ;P016
M cmp rax, 4 ;P016
M jbe $cs_e4 ;P016
M mov eax, 4 ;P016
:cs_e4
M add rax, [r13+18078] ;P016 + pc_cbase (фикс №19)
M cmp rax, [r13+18098] ;P016
M jbe $cs_e_ret ;P016
M mov [r13+18098], rax ;P016
:cs_e_ret
M mov rax, [r13+181E8] ;P016
M cmp rax, 5 ;P016
M jne $cs_ret ;P016
M mov eax, 1 ;P016
M mov [r13+180A8], rax ;P016
:cs_ret
M ret ;P016
