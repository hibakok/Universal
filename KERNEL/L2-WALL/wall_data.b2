; ===== K2-D010 таблица импортов kernel32.dll =====
DZ 1 ; выравнивание чётности RVA hint-записей (инвариант 7 SPEC/04)
:idt
DD $intt 0 0 $dll_name $iat ; описатель импорта
DZ 14 ; терминатор IDT
:iat
:iat_gsh
DQ $hint_gsh ; GetStdHandle
:iat_wf
DQ $hint_wf ; WriteFile
:iat_ep
DQ $hint_ep ; ExitProcess
:iat_gcl
DQ $hint_gcl ; GetCommandLineA
:iat_cf
DQ $hint_cf ; CreateFileA
:iat_rf
DQ $hint_rf ; ReadFile
:iat_ch
DQ $hint_ch ; CloseHandle
DQ 0 ; терминатор
:intt
DQ $hint_gsh $hint_wf $hint_ep $hint_gcl $hint_cf $hint_rf $hint_ch 0
:dll_name
DB 6B 65 72 6E 65 6C 33 32 2E 64 6C 6C 00 ; kernel32.dll
DZ 1 ; чётность RVA hint-записей
:hint_gsh
DB 00 00 47 65 74 53 74 64 48 61 6E 64 6C 65 00 ; GetStdHandle
DZ 1
:hint_wf
DB 00 00 57 72 69 74 65 46 69 6C 65 00 ; WriteFile
:hint_ep
DB 00 00 45 78 69 74 50 72 6F 63 65 73 73 00 ; ExitProcess
:hint_gcl
DB 00 00 47 65 74 43 6F 6D 6D 61 6E 64 4C 69 6E 65 ; GetCommandLineA
DB 41 00
:hint_cf
DB 00 00 43 72 65 61 74 65 46 69 6C 65 41 00 ; CreateFileA
:hint_rf
DB 00 00 52 65 61 64 46 69 6C 65 00 ; ReadFile
DZ 1
:hint_ch
DB 00 00 43 6C 6F 73 65 48 61 6E 64 6C 65 00 ; CloseHandle

; ===== K2-D011 виртуальные нули (bss) =====
:scalars
DBZ 18208 ; bstk[4096x24] + 65 скаляров (база R13)
:fname_in
DBZ 80
:fname_out
DBZ 80
:linebuf
DBZ 40
:scr
DBZ 80
:sm_arr
DBZ 100010
:ntab
DBZ 140000
:ftab
DBZ 120000
:larr
DBZ 100000
:sarr
DBZ C0000
:varr
DBZ 40000
:earr
DBZ 40
:ifarr
DBZ 8000
:filebuf
DBZ 21000
:outbuf
DBZ 200000

