; wall_self_pa.wall — аргументы, вызовы и astore-проверка каркаса wall.wall (E6.4d-3/2, E6.4d-4/3c-2/2)
; Паспорт: KERNEL/L2-WALL/wall_self_pa.wall | слой: L2 | роль: реинкарнация
; механики вызовов и проверки цели astore компилятора (K2-P014 p_args +
; K2-P017 pa_stage + K2-P015 p_call_tail + K2-P016 call_stats из
; wall_pa.b2; K2-P01D astore_chk из wall_pi.b2) на самом языке WALL v2 —
; СТАТ-режим прохода 1 (плечо pc_mode == 0: счёт/maxc — call_stats,
; pa_stage/p_call_tail не эмитят) и ЭМИТ-режим прохода 2 (срез C-2/2:
; pa_stage — стейджинг «M mov [rbp-X], r10» каждого аргумента в C-слот
; C(base+cnt+1) (фикс №19), 5-й аргумент ext-вызова — в S5; p_call_tail
; — загрузки ARGREG из C(pc_cbase+i), «M call $имя» / «M call [rip+
; $_iat_имя]», want != 0 -> «M mov r10, rax»; helper emit_argload —
; строка «M mov <reg>, [rbp-X]», reg = rcx/rdx/r8/r9 — if-цепочкой по
; индексу (образец — emit_prologue части f); строки канона — блоб sblob
; по смещениям, wall_self_blob.wall: s_movm 1267/11, s_r10 1514/6,
; s_mmov 1224/6, s_argpost 15/7, s_mcall 1165/8, s_mcalliat 1173/18,
; s_mr10rax 1388/14, s_movr10m 1289/16, s_msp20 1477/19, s_rcx 1524/3,
; s_rdx 1527/3, s_r8 1520/2, s_r9 1522/2, ']' — out_ch(93)).
; p_args (фикс №19, зеркалит E6.4d-4/2 wall.exe): '(' уже поглощено
; вызывающим; пустые «()» — потребить ')'; иначе выр и цикл ',' выр;
; завершение — want ')'. После КАЖДОГО выражения — pa_stage(base, cnt,
; eflg): в эмите — строка стейджинга, в стате — пустой вызов (проверка
; pc_mode внутри, как P014 wall.exe — точки вызова едины). Счёт/max
; need — ЛОКАЛИ рамки (вложенные вызовы в аргументах не затирают
; состояние объемлющего — как рамка P014 wall.exe); глобали-интерфейсы:
; pc_argcnt — счёт только что закрытого вызова, pc_argmax — его max
; need (need самого вызова), pc_cbase — его база C-слотов, pc_staged —
; base+staged самым внутренним АКТИВНЫМ вызовом (ДЕФЕКТ №21,
; E6.4d-4/3c-2/2: ДО фикса — только счёт без базы: двойная вложенность
; (вызов в аргументах вызова с base > 0) получала базу 0 и затирала
; C-слоты объемлющего; фикс синхронно в wall_pa.b2 P014; вход
; вложенного: base := pc_staged при pc_cact > 0), pc_cact — вложенность.
; Выход: max need аргументов (как assign — потребность стейджинга
; T-слотов). p_call_tail(want, имя): func (вид 4) — арность ==
; pc_argcnt (иначе ERR=FORMAT), загрузки ARGREG[0..argcnt) из
; C(pc_cbase+i), «M call $имя»; ext (вид 3) — argcnt <= 5, загрузки
; min(argcnt, 4), при 5 — «M mov r10, [rbp-S5]» + «M mov [rsp+20],
; r10», вызов «M call [rip+$_iat_<нижний регистр>]» (lower_copy в
; scrbuf); прочее/неизвестное — ERR=FORMAT; want != 0 — хвостовой
; «M mov r10, rax». Вызывается из pp_prim0 (вызов в выражении, срез
; C-2/2); вызов-утверждение — срез C-2/3 (Y00B p2_namestmt).
; call_stats(имя): вид имени в ntab; ext (вид 3) — maxc =
; max(maxc, pc_cbase + min(argcnt, 4)), при argcnt == 5 — st_ext5 = 1
; (S5-слот); НЕ ext (вкл. неизвестное имя — проверка в проходе 2) —
; maxc = max(maxc, pc_cbase + argcnt): вложенные вызовы считают
; C-слоты от своей базы — одновременное использование объемлющего.
; astore_chk(имя): копия окна ст локалей в окно lay (st_locoff/
; st_loccnt -> lay_lo/lay_hi — как проход 1 wall.exe; проход 2
; использует уже выставленное lay-окно); локаль/параметр — ок;
; глобаль вида 1 (var) или 5 (массив) — ок; str/func/ext/неизвестное
; — ERR=FORMAT (неизвестное и str/func/ext поймает и оракул parse —
; «строка неизменяема» / «не переменная» / «неизвестное имя»).

; аргументы вызова до ')' включительно; d — глубина (K2-P014, фикс №19)
func p_args(d)
  var need
  var base
  var cnt
  var mx
  var eflg
  if pc_cact > 0
    base = pc_staged
  else
    base = 0
  end
  pc_cact = pc_cact + 1
  eflg = pc_extflg
  pc_staged = base
  cnt = 0
  mx = 0
  if tok_next(pcur, ple) == 2 && tokend - tokptr == 1 && getb(srcbuf, tokptr) == 41
    pcur = tokend
  else
    need = p_expr(d)
    pa_stage(base, cnt, eflg)
    cnt = cnt + 1
    pc_staged = base + cnt
    mx = max2(mx, need)
    while tok_is1(44) == 1
      pcur = tokend
      need = p_expr(d)
      pa_stage(base, cnt, eflg)
      cnt = cnt + 1
      pc_staged = base + cnt
      mx = max2(mx, need)
    end
    pcur = want_sym1(41, pcur, ple)
  end
  pc_argcnt = cnt
  pc_argmax = mx
  pc_cbase = base
  pc_staged = base
  pc_cact = pc_cact - 1
  return mx
end

; эмит стейджинга одного аргумента после p_expr (K2-P017): base — база
; C-слотов вызова, cnt — счёт ДО инкремента, eflg — ext-флаг; значение
; аргумента — в r10. Аргумент #(cnt+1) -> C-слот (base+cnt+1) —
; SPEC/11 п.5/8 (фикс №19); 5-й аргумент ext-вызова (eflg != 0 &&
; cnt == 4) -> S5 = nbase+maxd+maxc+4. Стат-режим — выход (счёт — рамка
; p_args, как P017 wall.exe)
func pa_stage(base, cnt, eflg)
  var slot
  if pc_mode == 0
    return 0
  end
  slot = st_p2nbase + st_p2maxd + base + cnt + 1
  if eflg != 0
    if cnt == 4
      slot = st_p2nbase + st_p2maxd + st_p2maxc + 4
    end
  end
  out_str(1267, 11)
  out_hex(8 * slot)
  out_str(1514, 6)
  emit_cmt()
  return 0
end

; строка загрузки аргумента (helper K2-P015): «M mov <ARGREG[i]>,
; [rbp-X]», X = 8*(nbase+maxd+pc_cbase+i+1) — C-слот C(base+i+1) фикс
; №19; имя регистра — if-цепочкой по индексу (rcx/rdx/r8/r9)
func emit_argload(i)
  out_str(1224, 6)
  if i == 0
    out_str(1524, 3)
  else
    if i == 1
      out_str(1527, 3)
    else
      if i == 2
        out_str(1520, 2)
      else
        out_str(1522, 2)
      end
    end
  end
  out_str(15, 7)
  out_hex(8 * (st_p2nbase + st_p2maxd + pc_cbase + i + 1))
  out_ch(93)
  emit_cmt()
  return 0
end

; загрузки + вызов (K2-P015): want != 0 — вызов в выражении (хвост
; «M mov r10, rax»); iptr/ilen — имя. Арности/вид имени — проверка
; здесь (проход 2); загрузки — из C-слотов pc_cbase+i (фикс №19)
func p_call_tail(want, iptr, ilen)
  var n
  var kind
  var meta
  var i
  n = names_find(iptr, ilen)
  if n == -1
    fail_format(curline)
  end
  kind = getq(tabmem + 40 * n + 16)
  meta = getq(tabmem + 40 * n + 24)
  if kind == 4
    ; наша функция: арность == счёт аргументов
    if getq(tabmem + 2228224 + meta * 80 + 16) != pc_argcnt
      fail_format(curline)
    end
    i = 0
    while i < pc_argcnt
      emit_argload(i)
      i = i + 1
    end
    out_str(1165, 8)
    out_copy(srcbuf + iptr, ilen)
    emit_cmt()
    if want != 0
      out_str(1388, 14)
      emit_cmt()
    end
    return 0
  end
  if kind == 3
    ; ext: <= 5 аргументов; 5-й — [rsp+20] через S5
    if pc_argcnt > 5
      fail_format(curline)
    end
    i = 0
    while i < pc_argcnt && i < 4
      emit_argload(i)
      i = i + 1
    end
    if pc_argcnt == 5
      out_str(1289, 16)
      out_hex(8 * (st_p2nbase + st_p2maxd + st_p2maxc + 4))
      out_ch(93)
      emit_cmt()
      out_str(1477, 19)
      emit_cmt()
    end
    out_str(1173, 18)
    lower_copy(scrbuf, srcbuf + iptr, ilen)
    out_copy(scrbuf, ilen)
    out_ch(93)
    emit_cmt()
    if want != 0
      out_str(1388, 14)
      emit_cmt()
    end
    return 0
  end
  fail_format(curline)
  return 0
end

; статы вызова: ptr/len имени (K2-P016, фикс №19: базы C-слотов)
func call_stats(iptr, ilen)
  var n
  var kind
  var m
  kind = 0
  n = names_find(iptr, ilen)
  if n != -1
    kind = getq(tabmem + n * 40 + 16)
  end
  if kind == 3
    m = pc_argcnt
    if m > 4
      m = 4
    end
    m = m + pc_cbase
    st_maxc = max2(st_maxc, m)
    if pc_argcnt == 5
      st_ext5 = 1
    end
  else
    st_maxc = max2(st_maxc, pc_cbase + pc_argcnt)
  end
  return 0
end

; имя-цель astore допустимо (K2-P01D): ptr/len имени
func astore_chk(iptr, ilen)
  var n
  var kind
  lay_lo = st_locoff
  lay_hi = st_loccnt
  if local_find(iptr, ilen) != -1
    return 0
  end
  n = names_find(iptr, ilen)
  if n == -1
    fail_format(curline)
  end
  kind = getq(tabmem + 40 * n + 16)
  if kind == 1 || kind == 5
    return 0
  end
  fail_format(curline)
  return 0
end
