; wall.wall — самохостинг компилятора WALL (этап E6.4d; корень с разрезом)
; Паспорт: KERNEL/L2-WALL/wall.wall | слой L2 | роль: само-исходник
; компилятора WALL, переписываемый с BRICK v2 (wall_*.b2, 20 частей) на
; сам язык WALL v2 (SPEC/11). Рост по ветвям: сервисный слой, затем
; проходы 0/1/2. Разрез — механизм SPEC/10 (как у enc.b2/brick.brick):
; корень держит объявления и main, части — функции по ветвям.
; Сборка (полный круг, все инструменты ядра):
;   splice.exe wall.wall wall_s.flat
;   wall.exe wall_s.flat wall_s.b2
;   enc.exe wall_s.b2 wall_s.brick
;   brick.exe wall_s.brick wall_s.bin
;   pegen.exe wall_s.bin wall_s.peg wall_s.exe
; Контракт: CLI-поведение == wall.exe байт-в-байт на всех путях (usage,
; длинное имя, файлы, предел входа, ошибки лексера) и кодах 0/2..9
; (SPEC/11). E6.4d-2/2: проход 0 (wall_self_n.wall) — разбиение строк
; LF/CRLF/CR + полная лексика + карта текстов smem; ошибки лексера дают
; ERR=FORMAT AT=XXXX (код 6), номера строк == wall.exe == оракул _lex.
; E6.4d-2/3: проход 1 (wall_self_p1/pd/pe.wall) — читатели карты
; (getq/getb), диспетчер p1_line + kwtab (s_kws), объявления
; var/str/ext (p1_decl: ntab/varr/sarr/earr в куче tabmem) и
; пост-проверка main; ошибки разбора == wall.exe == оракул parse на
; классе источников без обработки func (источники с func до S004/S006+
; останавливаются с ERR=FORMAT на первом func — задокументированное
; отличие каркаса; см. TESTS + VERIFY-E6D.md).
; E6.4d-2/4: заголовки func (S004 p1_funchdr + S00E fh_param части pd:
; имя, <= 4 параметров, дубликаты, larr, bstk push kind 1, ftab 80 Б)
; и закрытие func плечом end (S007 p1s_end части p1s: финальная запись
; ftab, fcur = 0).
; E6.4d-3/1: локальные объявления в телах (S006 p1s_var части p1s:
; имя, [n] 1..4096, дубликат в окне [st_locoff, st_locoff+
; st_loccnt), конфликт с глобальными, larr, st_nslots).
; E6.4d-3/2: выражения в СТАТ-режиме (части ph — уровни P010/P011/
; P01A/P012; pp — первичные + индексация P013/P013a/P01B/P01C/P01E;
; pa — аргументы/вызовы/astore-проверка P014/P017/P016/P01D) и статы
; тел S00B return / S00C setb / S00D namestmt (часть p1s) + плечи
; диспетчера (часть p1).
; E6.4d-3/3: статы bstk-группы — S009 p1s_if + S00A p1s_while
; (условие — p_cond P018 СТАТ-плечо в НОВОЙ части pc: сравнения
; ==/!=/</<=/>/>=, конъюнкты '&&' / дизъюнкты '||' с v2flag, maxd =
; 1 + max(need_l, need_r) на каждое сравнение; m-скан и guard-эмит
; — проход 2) + S008 p1s_else (bstk kind 2 -> 3, ifarr[seq] = 1) +
; S00F p1s_brk break/continue (скан bstk до while, v2flag); пуш
; bstk {2/4, 0, ifseq}; ifarr — окно tabmem+4685888 32768 qword
; (ёмкость == ifarr wall.exe 0x8000 байт; проверки переполнения нет,
; как у wall.exe); сброс ifseq в pass1 (как [r13+18118] S001).
; E6.4d-4/3a: проход 2, срез A — ПРОЛОГ эмитции (части blob/e/y):
; блоб канона SPEC/11 п.8 (wall_self_blob.wall — hex-литералы sd0..sd7,
; 2048 Б; кириллица байтов >= 0x80 невыразима в str-литерале) декодируется
; blob_dec в окно sblob = outmem+0 области outmem; примитивы вывода
; (wall_self_e.wall: out_ch/copy/str/line, out_hex/hex2/dec, lower_copy,
; get_ext — реинкарнации K2-E001..E008/E012/E025; курсор — глобаль outcur,
; не r12) и пролог прохода 2 (wall_self_y.wall: pass2 + emit_header/
; emit_imports/emit_entry — K2-Y001(начало)/E015/E026/E016): 2 строки
; заголовка (v1/v2 по v2flag, счётчики), область импортов 0x200 (SPEC/11
; п.6), секция кода + :_entry. Статы/функции/секции данных — срезы B+;
; канарейка: выход == префиксу оракула до конца строки int3 (T-E6-52).
; E6.4d-4/3b: проход 2, срез B — ФУНКЦИИ: цикл строк по карте
; текстов (p2_line части y — диспетчер kw формы wall.exe),
; заголовки func (p2_funchdr: ftab-раскладка + пролог E018 + push
; bstk {func}), закрытие end (p2s_end: эпилог E019, если не
; last_ret), локали var (p2s_var — сброс last_ret), return
; (p2s_return — эпилог; эмитция выражения — срез C), механика
; bstk для if/while/else (счётчики, push/мутация; guard-эмитция —
; срез C) и предел nlab 2000 (строка 0); эмиттеры кадров — НОВАЯ
; часть wall_self_f.wall (E010/E011/E017/E018/E019). Класс среза
; B: тела только с var/голым return/end — выход == оракулу
; байт-в-байт (при глобальных str/var — точный префикс до секции
; данных); прочие статы дают код 0 без эмитции (вне класса).
; E6.4d-4/3c-1: проход 2, срез C часть 1 — СЕКЦИИ ДАННЫХ (хвост
; выхода): примитивы emit_cmt E009 + str_dlen E013 + str_emit E014
; (часть wall_self_e.wall) и НОВАЯ часть wall_self_d.wall —
; emit_strdata E027 (строки: «:имя» + DB <= 16 / «DZ 0») +
; emit_globdata E028 (глобальные var: «:имя» + «DZ 8n»); глобали
; cmt_ptr/cmt_len (текст строки для комментариев — ставит p2_line
; текущей строки и set_cmt строки объявления); класс срезов A+B
; стал давать ПОЛНЫЙ выход оракула и при глобальных str/var.
; E6.4d-4/3c-2/1: проход 2, срез C часть 2 шаг 1 — ВЫРАЖЕНИЯ
; эмит-режимом (глобаль pc_mode: 0 — стат прохода 1 / 1 — эмит
; прохода 2): НОВАЯ часть wall_self_g.wall — эмиттеры E020 emit_alu
; / E021 emit_shift / E022 emit_addr / E023 emit_len / E024
; emit_load / E034 emit_imul / E035 emit_divmod + emit_tstore/
; emit_tload (T-склад уровней); wall_self_ph.wall — chain_count P009
; + mul_peek + эмит-плечи p_expr/p_mul/p_mdm/p_unary (механика
; tdepth = d+K-1 без AST — как wall.exe); wall_self_pp.wall — эмит-
; плечи pp_prim0 (число / имя / &имя / len); p2_funchdr ставит
; раскладку из ftab (st_p2maxd/st_p2maxc/st_p2nbase + окно lay);
; p2s_return Y008 — выражение + «M mov rax, r10». Класс полного
; выхода: тела из var / return <выражение из чисел, имён (load/
; addr/len), скобок, унарного '-' и операций + - | ^ & << >>
; * / %> / end; прочие статы и выражения (вызовы, getb, индексация)
; — код 0, эмитция неполна (срезы C-2/2+).
; Выходной .b2 при успехе — пролог эмитции (срез A: заголовок/
; импорты/вход; срез B: функции) + секции данных (срез C-1:
; строки/глобальные var) — остальные статы/выражения — срезы C+.
; Отличие по API: wall.exe открывает файлы 7-аргументным CreateFileA —
; WALL v2 ограничивает ext-вызов 5 аргументами (SPEC/11 п.3), здесь
; CreateFile2 (имя LPCWSTR -> widen() в UTF-16; pCreateExParams NULL —
; документировано). Куча — GlobalAlloc(GMEM_FIXED=0): srcbuf 262145
; (буфер входа 256 КиБ — E6.4g-4, поднят синхронно с wall.exe, чей
; filebuf перенесён в хвост bss; ОДИН ReadFile с лимитом 262145 —
; решение BIG SRC эквивалентно wall.exe) и smem 1048592 (карта текстов
; прохода 0; ёмкость 65537 записей — как sm_arr wall.exe).
; Отказ распределения (NULL) сведён в общий путь ERR=READ SRC (код 5):
; у wall.exe аналога нет (статический bss); практически недостижим.
; При передаче &глобали в DWORD-аргумент API (srclen/written) глобаль
; предварительно обнуляется: API пишет только младшие 4 байта ячейки.
; Пределы: 8 ext (SPEC/11 п.9 — область импортов 0x200 заполнена),
; метки/тело — в пределах brick (проверяет полный круг батареи).

ext GetStdHandle
ext WriteFile
ext ExitProcess
ext GetCommandLineA
ext CreateFile2
ext ReadFile
ext CloseHandle
ext GlobalAlloc

var hstdout
var cmdline
var written
var wlen
var arg1[64]
var arg2[64]
var w1[64]
var w2[64]
var srcbuf
var smem
var srclen
var lineidx
var curline
var nlentries
var nlines
var lastnonempty
var fmtbuf[8]
var tabmem
var tokptr
var tokend
var tokval
var aspos
var asflag
var v2flag
var ncount
var fcount
var scount
var vcount
var ecount
var fdepth
var ifseq
var seenfunc
var fcur
var lcount
var curf
var st_locoff
var st_loccnt
var st_nslots
var st_maxd
var st_maxc
var st_setb
var st_ext5
var pcur
var ple
var pc_mode
var pc_argcnt
var pc_argmax
var pc_extflg
var pc_cact
var pc_cbase
var pc_staged
var lay_lo
var lay_hi
var lf_size
var outmem
var outbuf
var outcur
var scrbuf
var nlab
var ext_nptr
var ext_nlen
var st_infunc
var st_lret
var st_bcnt
var st_fbase
var st_ifcnt
var st_fptr
var st_flen
var cmt_ptr
var cmt_len
var st_p2nbase
var st_p2maxd
var st_p2maxc

str s_use = 'U-L2-WALL CMDS: WALL <SRC.WALL> <OUT.B2>\r\n'
str s_long = 'U-L2-WALL ERR=LONG NAME\r\n'
str s_osrc = 'U-L2-WALL ERR=OPEN SRC\r\n'
str s_rsrc = 'U-L2-WALL ERR=READ SRC\r\n'
str s_big = 'U-L2-WALL ERR=BIG SRC\r\n'
str s_oout = 'U-L2-WALL ERR=OPEN OUT\r\n'
str s_wout = 'U-L2-WALL ERR=WRITE OUT\r\n'
str s_fmt = 'U-L2-WALL ERR=FORMAT AT='
str s_hexd = '0123456789ABCDEF'
str s_sym2 = '==!=<=>=<<>>&&||'
str s_sym1 = '()=,-+<>|&^![]*/%'
str s_kws = 'var str ext func end else if while return setb getb len break continue'

!include wall_self_blob.wall
!include wall_self_c.wall
!include wall_self_n.wall
!include wall_self_pe.wall
!include wall_self_ph.wall
!include wall_self_pp.wall
!include wall_self_pa.wall
!include wall_self_pc.wall
!include wall_self_pd.wall
!include wall_self_p1.wall
!include wall_self_p1s.wall
!include wall_self_e.wall
!include wall_self_d.wall
!include wall_self_f.wall
!include wall_self_g.wall
!include wall_self_y.wall

func main
  var i
  var fh
  var rc
  var nlen1
  var nlen2
  hstdout = GetStdHandle(-11)
  cmdline = GetCommandLineA()
  i = skip0()
  i = read_arg(arg1, i)
  nlen1 = wlen
  i = read_arg(arg2, i)
  nlen2 = wlen
  widen(w1, arg1, nlen1)
  widen(w2, arg2, nlen2)
  fh = CreateFile2(w1, 1 << 31, 0, 3, 0)
  if fh == -1
    print_error(s_osrc, len(s_osrc), 4)
  end
  srcbuf = GlobalAlloc(0, 262145)
  if srcbuf == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  srclen = 0
  rc = ReadFile(fh, srcbuf, 262145, &srclen, 0)
  if rc == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  if srclen >= 262145
    print_error(s_big, len(s_big), 7)
  end
  CloseHandle(fh)
  smem = GlobalAlloc(0, 1048592)
  if smem == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  ; таблицы прохода 1: ntab 32768x40 + varr 32768x16 + sarr 16384x24
  ; + ftab 16384x80 + earr 8x8 + larr 32768x32 (параметры/локали — S004)
  ; + bstk 3072x32 (стек блоков — S004/S007/S009/S00A)
  ; + ifarr 32768x8 (флаги else по ifseq — S008/S009; E6.4d-3/3)
  ; = 4948032 (смещения — wall_self_pe.wall / wall_self_pd.wall /
  ; wall_self_p1s.wall)
  tabmem = GlobalAlloc(0, 4948032)
  if tabmem == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  ; область вывода эмитции (E6.4d-4/3a): sblob 2048 (блоб канона —
  ; декодируется init_blob) + scr 64 (нижний регистр имён ext) +
  ; outbuf 2097152 (2 МиБ — максимум вывода big_source x3, как wall.exe)
  outmem = GlobalAlloc(0, 2103264)
  if outmem == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  scrbuf = outmem + 2048
  outbuf = outmem + 2112
  init_blob()
  pass0()
  pass1()
  pass2()
  fh = CreateFile2(w2, 1073741824, 0, 2, 0)
  if fh == -1
    print_error(s_oout, len(s_oout), 8)
  end
  rc = WriteFile(fh, outbuf, outcur, &written, 0)
  if rc == 0
    print_error(s_wout, len(s_wout), 9)
  end
  CloseHandle(fh)
  ExitProcess(0)
end
