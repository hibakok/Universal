; wall.wall — самохостинг компилятора WALL (этап E6.4d, шаг 1: каркас CLI)
; Паспорт: KERNEL/L2-WALL/wall.wall | слой L2 | роль: само-исходник
; компилятора WALL, переписываемый с BRICK v2 (wall_*.b2, 20 частей) на
; сам язык WALL v2 (SPEC/11). Рост по ветвям: сначала сервисный слой
; (аргументы, файлы, сообщения ошибок), затем проходы 0/1/2.
; Сборка (полный круг, все инструменты ядра):
;   wall.exe wall.wall wall_s.b2
;   enc.exe wall_s.b2 wall_s.brick
;   brick.exe wall_s.brick wall_s.bin
;   pegen.exe wall_s.bin wall_s.peg wall_s.exe
; Контракт каркаса: CLI-поведение == wall.exe байт-в-байт на всех путях
; ошибок (usage/длинное имя/файлы/предел входа) и кодах возврата
; 0/2/3/4/5/7/8/9 (SPEC/11). Компиляция ещё не реализована: при успехе
; выходной .b2 пуст (наполнение — шаги E6.4d-2+).
; Отличие по API: wall.exe (BRICK v2) открывает файлы 7-аргументным
; CreateFileA — WALL v2 ограничивает ext-вызов 5 аргументами (SPEC/11
; п.3), поэтому здесь CreateFile2 (kernel32, имя LPCWSTR, параметры —
; NULL; документировано; см. lab_win._api_createfile2). Расширение имени
; в UTF-16 — widen(). Чтение — ReadFile кусками по 32768 в head[4096]
; со счётчиком: решение BIG SRC (>= 131073 байта) эквивалентно
; wall.exe (ReadFile с лимитом 0x20001 одним вызовом). При передаче
; &локали в DWORD-аргумент API (got) локаль предварительно обнуляется:
; API пишет только младшие 4 байта ячейки.
; Пределы: 7 ext (из 8), 3 функции + main, все сообщения байт-в-байт
; из errtab/strblob wall_data.b2 (проверено dev-тестом wall_self_test).

ext GetStdHandle
ext WriteFile
ext ExitProcess
ext GetCommandLineA
ext CreateFile2
ext ReadFile
ext CloseHandle

var hstdout
var cmdline
var written
var wlen
var arg1[64]
var arg2[64]
var w1[64]
var w2[64]
var head[4096]
var outbuf[64]

str s_use = 'U-L2-WALL CMDS: WALL <SRC.WALL> <OUT.B2>\r\n'
str s_long = 'U-L2-WALL ERR=LONG NAME\r\n'
str s_osrc = 'U-L2-WALL ERR=OPEN SRC\r\n'
str s_rsrc = 'U-L2-WALL ERR=READ SRC\r\n'
str s_big = 'U-L2-WALL ERR=BIG SRC\r\n'
str s_oout = 'U-L2-WALL ERR=OPEN OUT\r\n'
str s_wout = 'U-L2-WALL ERR=WRITE OUT\r\n'

; печать сообщения (msg: адрес, mlen: длина) и выход с кодом code;
; аналог K2-G003 print_error + errtab
func print_error(msg, mlen, code)
  WriteFile(hstdout, msg, mlen, &written, 0)
  ExitProcess(code)
end

; пропуск argv0 (кавычки/пробелы/табы, как K2-C001) + разделителей;
; на конце командной строки — usage и выход 2; возвращает индекс слова 1
func skip0
  var i
  var c
  var q
  var u
  var d
  i = 0
  c = getb(cmdline, 0)
  if c == 34
    i = i + 1
    q = 1
    while q == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 34
        q = 0
        i = i + 1
      else
        i = i + 1
      end
    end
  else
    u = 1
    while u == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 32
        u = 0
      else
        if c == 9
          u = 0
        else
          i = i + 1
        end
      end
    end
  end
  d = 1
  while d == 1
    c = getb(cmdline, i)
    if c == 0
      print_error(s_use, len(s_use), 2)
    end
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        d = 0
      end
    end
  end
  return i
end

; чтение слова с позиции i в байтовый буфер dst (<= 127 байт + NUL);
; пустое слово (NUL после разделителей) — usage и выход 2 (na_miss);
; слово >= 128 байт — LONG NAME и выход 3 (cwd_long, K2-C003);
; длина слова — в глобальную wlen; возвращает позицию после слова
func read_arg(dst, i)
  var c
  var k
  var s
  var w
  s = 1
  while s == 1
    c = getb(cmdline, i)
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        s = 0
      end
    end
  end
  c = getb(cmdline, i)
  if c == 0
    print_error(s_use, len(s_use), 2)
  end
  k = 0
  w = 1
  while w == 1
    c = getb(cmdline, i)
    if c == 0
      w = 0
    else
      if c == 32
        w = 0
      else
        if c == 9
          w = 0
        else
          if k >= 127
            print_error(s_long, len(s_long), 3)
          end
          setb(dst, k, c)
          k = k + 1
          i = i + 1
        end
      end
    end
  end
  wlen = k
  setb(dst, k, 0)
  return i
end

; ANSI-имя (n байтов по адресу src) -> UTF-16LE по адресу dst + терминатор
func widen(dst, src, n)
  var k
  var c
  k = 0
  while k < n
    c = getb(src, k)
    setb(dst, 2 * k, c)
    setb(dst, 2 * k + 1, 0)
    k = k + 1
  end
  setb(dst, 2 * n, 0)
  setb(dst, 2 * n + 1, 0)
  return 0
end

func main
  var i
  var fh
  var total
  var bad
  var cont
  var rc
  var got
  var nlen1
  var nlen2
  hstdout = GetStdHandle(-11)
  cmdline = GetCommandLineA()
  i = skip0()
  i = read_arg(arg1, i)
  nlen1 = wlen
  i = read_arg(arg2, i)
  nlen2 = wlen
  widen(w1, arg1, nlen1)
  widen(w2, arg2, nlen2)
  fh = CreateFile2(w1, 1 << 31, 0, 3, 0)
  if fh == -1
    print_error(s_osrc, len(s_osrc), 4)
  end
  total = 0
  bad = 0
  cont = 1
  while cont == 1
    got = 0
    rc = ReadFile(fh, head, 32768, &got, 0)
    if rc == 0
      bad = 1
      cont = 0
    else
      total = total + got
      if total >= 131073
        bad = 2
        cont = 0
      else
        if got == 0
          cont = 0
        end
      end
    end
  end
  if bad == 1
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  if bad == 2
    print_error(s_big, len(s_big), 7)
  end
  CloseHandle(fh)
  fh = CreateFile2(w2, 1073741824, 0, 2, 0)
  if fh == -1
    print_error(s_oout, len(s_oout), 8)
  end
  rc = WriteFile(fh, outbuf, 0, &written, 0)
  if rc == 0
    print_error(s_wout, len(s_wout), 9)
  end
  CloseHandle(fh)
  ExitProcess(0)
end
