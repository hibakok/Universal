; wall.wall — самохостинг компилятора WALL (этап E6.4d; корень с разрезом)
; Паспорт: KERNEL/L2-WALL/wall.wall | слой L2 | роль: само-исходник
; компилятора WALL, переписываемый с BRICK v2 (wall_*.b2, 20 частей) на
; сам язык WALL v2 (SPEC/11). Рост по ветвям: сервисный слой, затем
; проходы 0/1/2. Разрез — механизм SPEC/10 (как у enc.b2/brick.brick):
; корень держит объявления и main, части — функции по ветвям.
; Сборка (полный круг, все инструменты ядра):
;   splice.exe wall.wall wall_s.flat
;   wall.exe wall_s.flat wall_s.b2
;   enc.exe wall_s.b2 wall_s.brick
;   brick.exe wall_s.brick wall_s.bin
;   pegen.exe wall_s.bin wall_s.peg wall_s.exe
; Контракт: CLI-поведение == wall.exe байт-в-байт на всех путях (usage,
; длинное имя, файлы, предел входа, ошибки лексера) и кодах 0/2..9
; (SPEC/11). E6.4d-2/2: проход 0 (wall_self_n.wall) — разбиение строк
; LF/CRLF/CR + полная лексика + карта текстов smem; ошибки лексера дают
; ERR=FORMAT AT=XXXX (код 6), номера строк == wall.exe == оракул _lex.
; E6.4d-2/3: проход 1 (wall_self_p1/pd/pe.wall) — читатели карты
; (getq/getb), диспетчер p1_line + kwtab (s_kws), объявления
; var/str/ext (p1_decl: ntab/varr/sarr/earr в куче tabmem) и
; пост-проверка main; ошибки разбора == wall.exe == оракул parse на
; классе источников без обработки func (источники с func до S004/S006+
; останавливаются с ERR=FORMAT на первом func — задокументированное
; отличие каркаса; см. TESTS + VERIFY-E6D.md).
; Выходной .b2 при успехе пока ПУСТ — эмитция прохода 2 последует
; (шаги E6.4d-3+).
; Отличие по API: wall.exe открывает файлы 7-аргументным CreateFileA —
; WALL v2 ограничивает ext-вызов 5 аргументами (SPEC/11 п.3), здесь
; CreateFile2 (имя LPCWSTR -> widen() в UTF-16; pCreateExParams NULL —
; документировано). Куча — GlobalAlloc(GMEM_FIXED=0): srcbuf 131073
; (буфер входа; ОДИН ReadFile с лимитом 131073 — решение BIG SRC
; эквивалентно wall.exe) и smem 1048592 (карта текстов прохода 0;
; ёмкость 65537 записей — максимум строк входа 128 КиБ, как sm_arr).
; Отказ распределения (NULL) сведён в общий путь ERR=READ SRC (код 5):
; у wall.exe аналога нет (статический bss); практически недостижим.
; При передаче &глобали в DWORD-аргумент API (srclen/written) глобаль
; предварительно обнуляется: API пишет только младшие 4 байта ячейки.
; Пределы: 8 ext (SPEC/11 п.9 — область импортов 0x200 заполнена),
; метки/тело — в пределах brick (проверяет полный круг батареи).

ext GetStdHandle
ext WriteFile
ext ExitProcess
ext GetCommandLineA
ext CreateFile2
ext ReadFile
ext CloseHandle
ext GlobalAlloc

var hstdout
var cmdline
var written
var wlen
var arg1[64]
var arg2[64]
var w1[64]
var w2[64]
var srcbuf
var smem
var srclen
var lineidx
var curline
var nlentries
var nlines
var lastnonempty
var outbuf[64]
var fmtbuf[8]
var tabmem
var tokptr
var tokend
var tokval
var aspos
var asflag
var v2flag
var ncount
var fcount
var scount
var vcount
var ecount
var fdepth
var seenfunc
var fcur

str s_use = 'U-L2-WALL CMDS: WALL <SRC.WALL> <OUT.B2>\r\n'
str s_long = 'U-L2-WALL ERR=LONG NAME\r\n'
str s_osrc = 'U-L2-WALL ERR=OPEN SRC\r\n'
str s_rsrc = 'U-L2-WALL ERR=READ SRC\r\n'
str s_big = 'U-L2-WALL ERR=BIG SRC\r\n'
str s_oout = 'U-L2-WALL ERR=OPEN OUT\r\n'
str s_wout = 'U-L2-WALL ERR=WRITE OUT\r\n'
str s_fmt = 'U-L2-WALL ERR=FORMAT AT='
str s_hexd = '0123456789ABCDEF'
str s_sym2 = '==!=<=>=<<>&&||'
str s_sym1 = '()=,-+<>|&^![]*/%'
str s_kws = 'var str ext func end else if while return setb getb len break continue'

!include wall_self_c.wall
!include wall_self_n.wall
!include wall_self_pe.wall
!include wall_self_pd.wall
!include wall_self_p1.wall

func main
  var i
  var fh
  var rc
  var nlen1
  var nlen2
  hstdout = GetStdHandle(-11)
  cmdline = GetCommandLineA()
  i = skip0()
  i = read_arg(arg1, i)
  nlen1 = wlen
  i = read_arg(arg2, i)
  nlen2 = wlen
  widen(w1, arg1, nlen1)
  widen(w2, arg2, nlen2)
  fh = CreateFile2(w1, 1 << 31, 0, 3, 0)
  if fh == -1
    print_error(s_osrc, len(s_osrc), 4)
  end
  srcbuf = GlobalAlloc(0, 131073)
  if srcbuf == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  srclen = 0
  rc = ReadFile(fh, srcbuf, 131073, &srclen, 0)
  if rc == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  if srclen >= 131073
    print_error(s_big, len(s_big), 7)
  end
  CloseHandle(fh)
  smem = GlobalAlloc(0, 1048592)
  if smem == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  ; таблицы прохода 1: ntab 32768x40 + varr 32768x16 + sarr 16384x24
  ; + ftab 16384x80 + earr 8x8 = 3539008 (смещения — wall_self_pe.wall)
  tabmem = GlobalAlloc(0, 3539008)
  if tabmem == 0
    print_error(s_rsrc, len(s_rsrc), 5)
  end
  pass0()
  pass1()
  fh = CreateFile2(w2, 1073741824, 0, 2, 0)
  if fh == -1
    print_error(s_oout, len(s_oout), 8)
  end
  rc = WriteFile(fh, outbuf, 0, &written, 0)
  if rc == 0
    print_error(s_wout, len(s_wout), 9)
  end
  CloseHandle(fh)
  ExitProcess(0)
end
