; ===== K2-P018 p_cond: условие if/while — цепочки && / || (v2, срез 3) =====
; Вход (проход 2): RCX = pfx (0=if, 1=while), RDX = e (суффикс lfalse),
; R8 = k (сквозной счётчик if/while). В проходе 1 параметры не задаются
; и не читаются (pc_mode=0). Разбор: дизъюнкты по '||', внутри дизъюнкта —
; сравнения по '&&' (SPEC/11 п.2); операнды на глубине 2, T1-склад.
; Статы (проход 1): maxd = max(maxd, 1+max(need_l, need_r)) КАЖДОГО
; сравнения; флаг v2 [r13+18190] при && / || (как * / % в p_mdm).
; Эмит (проход 2), guard-канон SPEC/11 п.8: каждое сравнение + j<инв>
; на lfail (d<i+1> при i<m, иначе lfalse); после дизъюнкта i<m —
; "M jmp $<pfx><k>t" + метка d<i+1>; при m>1 — финальная метка t.
; m=1 (одно сравнение или чистая &&-цепочка) — ни d/t-меток, ни jmp:
; выход байт-в-байт как v1. m — предподсчёт числа '||' в строке
; (скан без потребления, паттерн P009).
:p_cond
M push rbp ;P018
M mov rbp, rsp ;P018
M sub rsp, 60 ;P018
M mov [rbp-28], rcx ;P018 pfx
M mov [rbp-30], rdx ;P018 e
M mov [rbp-38], r8 ;P018 k
M mov eax, 1 ;P018
M mov [rbp-48], rax ;P018 i = 1 (дизъюнкт)
M mov [rbp-40], rax ;P018 m = 1 (дизъюнктов)
M mov rax, [r13+18080] ;P018
M test rax, rax ;P018
M jz $pcd_cmp ;P018 статы: m не нужен
M mov rax, [r13+18070] ;P018
M mov [rbp-50], rax ;P018 скан-курсор
:pcd_scan
M mov rcx, [rbp-50] ;P018
M call $lex_tok ;L001
