; KERNEL/L4-LIB/lib_m.uva — ветвь M библиотеки L4: память (SPEC/14 п. 4)
; Кирпичи: K4-M001 mem_copy / K4-M002 mem_fill. Карточки — MAP/M4-LIB.md;
; ABI — SPEC/14 п. 3.
; Часть (SPEC/14 п. 2): только инструкции, метки и комментарии; .mem/.data
; принадлежат программе-потребителю; !include — ПОСЛЕ кода программы
; (вход программы — смещение 0, кирпичи вызываются по меткам lib_*).
; ЗАВИСИМОСТЕЙ НЕТ: кирпичи ветви M атомарны (карточки) — программа
; включает lib_m.uva ОДНУ (автономная ветвь — прецедент S, E8.2c).
; СТЕК НЕ ИСПОЛЬЗУЕТСЯ: аргументов r1..r3 + временной r4 (байт/шаг)
; достаточно; r13 (sp) программа ставить НЕ обязана — кирпич его
; не трогает (ABI: сохраняемые r5..r15 не трогаем вовсе).
; КОНСОЛЬ НЕ ТРОГАЕТСЯ: r14 (devbase) не нужен ни одному кирпичу —
; эффект наблюдается в RAM программы (диффтесты — по r.mem, T-E8-22/23).
; Копирование — ПО ВОЗРАСТАНИЮ адресов (формула SPEC/14 п. 4): байт
; источника читается ДО записи в ту же ячейку, поэтому перекрытие
; «вперёд» (dst > src) размножает уже записанный байт, «назад»
; (dst < src) — источник не повреждается. n = 0 — цикл не выполняется
; (jnz не входит в тело) — эффекта нет.

lib_mem_copy:                     ; K4-M001: r1 = dst, r2 = src, r3 = n
    jnz r3, lib_mem_copy_body     ; n != 0 — следующий байт; n = 0 — выход
    ret
lib_mem_copy_body:
    ldb r4, r2                    ; r4 = RAM[src] (sext8; stb вернёт AND 255)
    stb r1+0, r4                  ; RAM[dst] := байт — адреса возрастают
    const r4, 1                   ; шаг — временная r4 (ABI)
    add r1, r1, r4                ; dst = dst + 1
    add r2, r2, r4                ; src = src + 1
    sub r3, r3, r4                ; n = n − 1
    jmp lib_mem_copy              ; назад к счётчику (метка входа = голова)

lib_mem_fill:                     ; K4-M002: r1 = dst, r2 = байт, r3 = n
    jnz r3, lib_mem_fill_body     ; n != 0 — следующий байт; n = 0 — выход
    ret
lib_mem_fill_body:
    stb r1+0, r2                  ; RAM[dst] := r2 AND 255 (SPEC/12 п. 5)
    const r4, 1                   ; шаг — временная r4 (ABI)
    add r1, r1, r4                ; dst = dst + 1
    sub r3, r3, r4                ; n = n − 1
    jmp lib_mem_fill              ; назад к счётчику (метка входа = голова)
