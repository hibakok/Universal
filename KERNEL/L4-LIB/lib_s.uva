; KERNEL/L4-LIB/lib_s.uva — ветвь S библиотеки L4: строки (SPEC/14 п. 4)
; Кирпичи: K4-S001 str_len / K4-S002 str_out. Карточки — MAP/M4-LIB.md;
; ABI — SPEC/14 п. 3.
; Часть (SPEC/14 п. 2): только инструкции, метки и комментарии; .mem/.data
; принадлежат программе-потребителю; !include — ПОСЛЕ кода программы
; (вход программы — смещение 0, кирпичи вызываются по меткам lib_*).
; ЗАВИСИМОСТЕЙ НЕТ: кирпичи ветви S атомарны (карточки) — ветвь C
; не вызывается, программа включает lib_s.uva ОДНУ (первая автономная
; ветвь после C).
; СТЕК НЕ ИСПОЛЬЗУЕТСЯ (в отличие от ветви N): четырёх временных r1..r4
; достаточно (addr/p/шаг/байт), r13 (sp) программа ставить НЕ обязана —
; кирпич его не трогает (ABI: сохраняемые r5..r15 не трогаем вовсе).
; lib_str_len консоль НЕ трогает — r14 не нужен; lib_str_out — печатающий
; кирпич: нужна программа, установившая r14 = memsize до вызова.
; Конец строки — ПЕРВЫЙ нулевой байт (хвост после него невидим);
; строка без NUL тянется до края RAM (нулевые байты за .data) — при
; выходе за [0, memsize) действует защита машины (SPEC/12 п. 7).

lib_str_len:                     ; K4-S001: r1 = addr -> r1 = длина
    const r3, 1                  ; шаг — временная r3 (ABI)
    mov r2, r1                   ; p = addr (r2 — временная; r1 = база)
lib_str_len_loop:
    ldb r4, r2                   ; r4 = RAM[p]
    jnz r4, lib_str_len_next     ; байт != 0 — дальше
    jmp lib_str_len_done         ; первый 0 — конец строки
lib_str_len_next:
    add r2, r2, r3               ; p = p + 1
    jmp lib_str_len_loop
lib_str_len_done:
    sub r1, r2, r1               ; r1 = len = p - addr
    ret

lib_str_out:                     ; K4-S002: r1 = addr -> консоль += строка
    const r3, 1                  ; шаг — временная r3 (ABI)
    mov r2, r1                   ; p = addr (r2 — временная)
lib_str_out_loop:
    ldb r4, r2                   ; r4 = RAM[p]
    jnz r4, lib_str_out_put      ; байт != 0 — печать
    jmp lib_str_out_done         ; первый 0 — конец
lib_str_out_put:
    stb r14+0, r4                ; консоль += байт (окно устройств)
    add r2, r2, r3               ; p = p + 1
    jmp lib_str_out_loop
lib_str_out_done:
    ret
