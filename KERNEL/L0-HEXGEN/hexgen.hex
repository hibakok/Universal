; UNIVERSAL / ATOM v1 / слой L0 / модуль M0-HEXGEN
; Исходник hexgen.exe. Каждый байт назначен явно (ведомость
; e3_ledger: кодировки инструкций назначены явно, сборка лишь
; разрешает rip-смещения и длины переходов).
; Формат: @<смещение> <байты> ; <пояснение>
; Директива Z <от> <до> — диапазон байтов 00 [от, до).
; Виртуальные нули (fname/filebuf/imagebuf) в файл не входят —
; они объявлены VirtualSize секции (см. BYTECODE.md §2).

@0000 4D 5A ; DOS: сигнатура MZ
@0002 90 00 ; DOS: байт на последней странице
@0004 03 00 ; DOS: страниц в файле
@0006 00 00 ; DOS: релокаций
@0008 04 00 ; DOS: размер заголовка в параграфах
@000A 00 00 ; DOS: минимум доп. памяти
@000C FF FF ; DOS: максимум доп. памяти
@000E 00 00 ; DOS: сегмент SS
@0010 B8 00 ; DOS: указатель SP
@0012 00 00 ; DOS: контрольная сумма
@0014 00 00 ; DOS: указатель IP
@0016 00 00 ; DOS: сегмент CS
@0018 40 00 ; DOS: таблица релокаций = 0x40
@001A 00 00 ; DOS: оверлей
Z 001C 003C
@003C 80 00 00 00 ; DOS: e_lfanew = 0x80 (смещение PE)
@0040 55 6E 69 76 65 72 73 61 6C 20 4C 30 20 68 65 78 67 65 6E 2E 20 4E 6F 20 44 4F 53 20 73 75 70 70 6F 72 74 2E 0D 0A 24 ; DOS: заглушка, текст «Universal L0 hexgen. No DOS support.» (в Windows не исполняется)
Z 0067 0080
@0080 50 45 00 00 ; PE: сигнатура PE\0\0
@0084 64 86 ; COFF: машина = AMD64 (x86-64)
@0086 01 00 ; COFF: секций = 1
@0088 00 00 00 00 ; COFF: метка времени = 0
@008C 00 00 00 00 ; COFF: таблица символов = 0
@0090 00 00 00 00 ; COFF: число символов = 0
@0094 F0 00 ; COFF: размер опт. заголовка = 240 (PE32+)
@0096 22 00 ; COFF: признаки = EXECUTABLE|LARGE_ADDRESS_AWARE
@0098 0B 02 ; OH: магия 0x020B (PE32+, 64 бит)
@009A 01 00 ; OH: версия линкера 1.0
@009C 00 08 00 00 ; OH: SizeOfCode = 0x800
@00A0 00 00 00 00 ; OH: SizeOfInitializedData = 0x0
@00A4 00 00 00 00 ; OH: SizeOfUninitializedData = 0x0
@00A8 00 10 00 00 ; OH: точка входа RVA (K0-X031) = 0x1000
@00AC 00 10 00 00 ; OH: BaseOfCode = 0x1000
@00B0 00 00 00 40 01 00 00 00 ; OH: ImageBase = 0x140000000
@00B8 00 10 00 00 ; OH: SectionAlignment = 0x1000
@00BC 00 02 00 00 ; OH: FileAlignment = 0x200
@00C0 06 00 00 00 ; OH: версия ОС 6.0 = 0x6
@00C4 00 00 01 00 ; OH: версия образа 0.1 = 0x10000
@00C8 06 00 00 00 ; OH: версия подсистемы 6.0 = 0x6
@00CC 00 00 00 00 ; OH: Win32VersionValue = 0x0
@00D0 00 20 02 00 ; OH: SizeOfImage = 0x22000
@00D4 00 02 00 00 ; OH: SizeOfHeaders = 0x200
@00D8 00 00 00 00 ; OH: CheckSum = 0x0
@00DC 03 00 ; OH: подсистема = 3 (консоль)
@00DE 00 00 ; OH: DllCharacteristics = 0
@00E0 00 00 10 00 00 00 00 00 ; OH: стек резерв (1 МиБ) = 0x100000
@00E8 00 40 00 00 00 00 00 00 ; OH: стек фикс (4 КиБ) = 0x4000
@00F0 00 00 10 00 00 00 00 00 ; OH: куча резерв (1 МиБ) = 0x100000
@00F8 00 40 00 00 00 00 00 00 ; OH: куча фикс (4 КиБ) = 0x4000
@0100 00 00 00 00 ; OH: LoaderFlags = 0x0
@0104 10 00 00 00 ; OH: число каталогов данных = 0x10
@0108 00 00 00 00 00 00 00 00 ; DD[0] Export: пусто
@0110 60 16 00 00 28 00 00 00 ; OH: DD[1] Import: RVA IDT = 0x1660, размер 0x28
Z 0118 0168
@0168 88 16 00 00 40 00 00 00 ; OH: DD[12] IAT: RVA IAT = 0x1688, размер 0x40
Z 0170 0188
@0188 2E 74 65 78 74 00 00 00 ; SH: имя секции .text
@0190 80 08 02 00 ; SH: VirtualSize = 0x20880 (код+данные+импорты + виртуальные нули)
@0194 00 10 00 00 ; SH: VirtualAddress = 0x1000
@0198 00 08 00 00 ; SH: SizeOfRawData = 0x800 (файловая часть)
@019C 00 02 00 00 ; SH: PointerToRawData = 0x200
@01A0 00 00 00 00 ; SH: таблица релокаций = 0
@01A4 00 00 00 00 ; SH: таблица строк = 0
@01A8 00 00 00 00 ; SH: счётчики релокаций/строк = 0
@01AC 20 00 00 E0 ; SH: признаки = CODE|EXEC|READ|WRITE
Z 01B0 0200
