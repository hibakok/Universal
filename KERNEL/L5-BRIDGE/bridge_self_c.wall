; bridge_self_c.wall — сервисный слой моста bridge.wall (E9.2-1)
; Паспорт: KERNEL/L5-BRIDGE/bridge_self_c.wall | слой: L5 (исходник — WALL)
; | роль: ветвь C моста — печать сообщений (K5-C001 print_error), разбор
; командной строки (K5-C002 skip0 — argv0 с кавычками; K5-C003 read_arg —
; слово-аргумент, предел имени 127; K5-C004 check_end — ровно три
; аргумента: после третьего слова только разделители до NUL), расширение
; ANSI -> UTF-16LE (K5-C005 widen — CreateFile2, имя LPCWSTR;
; 7-аргументный CreateFileA недостижим из WALL, SPEC/11 п.3) и сборка
; факт-строки в буфер (K5-C006 copy_str — копия байтов; K5-C007 out_dec —
; десятичная запись без ведущих нулей; K5-C008 out_hex — 8 ЗАГЛАВНЫХ
; hex-цифр).
; Сообщения — байт-в-байт из строк s_* корня bridge.wall; коды выхода
; 2 (usage) и 3 (LONG NAME). Конвенции — реинкарнации K3-C001..C007 ядра
; kernel.wall (сервис один и тот же во всех инструментах на WALL).

; печать сообщения (msg: адрес, mlen: длина) и выход с кодом code
func print_error(msg, mlen, code)
  WriteFile(hstdout, msg, mlen, &written, 0)
  ExitProcess(code)
end

; пропуск argv0 (кавычки/пробелы/табы) + разделителей; на конце
; командной строки — usage и выход 2; возвращает индекс слова 1
func skip0
  var i
  var c
  var q
  var u
  var d
  i = 0
  c = getb(cmdline, 0)
  if c == 34
    i = i + 1
    q = 1
    while q == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 34
        q = 0
        i = i + 1
      else
        i = i + 1
      end
    end
  else
    u = 1
    while u == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 32
        u = 0
      else
        if c == 9
          u = 0
        else
          i = i + 1
        end
      end
    end
  end
  d = 1
  while d == 1
    c = getb(cmdline, i)
    if c == 0
      print_error(s_use, len(s_use), 2)
    end
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        d = 0
      end
    end
  end
  return i
end

; чтение слова с позиции i в байтовый буфер dst (<= 127 байт + NUL);
; пустое слово (NUL после разделителей) — usage и выход 2;
; слово >= 128 байт — LONG NAME и выход 3;
; длина слова — в глобальную wlen; возвращает позицию после слова
func read_arg(dst, i)
  var c
  var k
  var s
  var w
  s = 1
  while s == 1
    c = getb(cmdline, i)
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        s = 0
      end
    end
  end
  c = getb(cmdline, i)
  if c == 0
    print_error(s_use, len(s_use), 2)
  end
  k = 0
  w = 1
  while w == 1
    c = getb(cmdline, i)
    if c == 0
      w = 0
    else
      if c == 32
        w = 0
      else
        if c == 9
          w = 0
        else
          if k >= 127
            print_error(s_long, len(s_long), 3)
          end
          setb(dst, k, c)
          k = k + 1
          i = i + 1
        end
      end
    end
  end
  wlen = k
  setb(dst, k, 0)
  return i
end

; ровно три аргумента (вход .exe, выход .b2, выход .peg): после
; третьего слова — только разделители до NUL, иначе (четвёртое слово) —
; usage и выход 2; возвращает позицию конца
func check_end(i)
  var c
  var go
  go = 1
  while go == 1
    c = getb(cmdline, i)
    if c == 0
      go = 0
    else
      if c == 32
        i = i + 1
      else
        if c == 9
          i = i + 1
        else
          print_error(s_use, len(s_use), 2)
        end
      end
    end
  end
  return i
end

; ANSI-имя (n байтов по адресу src) -> UTF-16LE по адресу dst + терминатор
func widen(dst, src, n)
  var k
  var c
  k = 0
  while k < n
    c = getb(src, k)
    setb(dst, 2 * k, c)
    setb(dst, 2 * k + 1, 0)
    k = k + 1
  end
  setb(dst, 2 * n, 0)
  setb(dst, 2 * n + 1, 0)
  return 0
end

; копия n байтов с адреса src в dst с позиции k; возврат — k + n
func copy_str(dst, k, src, n)
  var j
  var c
  j = 0
  while j < n
    c = getb(src, j)
    setb(dst, k + j, c)
    j = j + 1
  end
  return k + n
end

; десятичная запись числа v (>= 0, < 2^31) в dst с позиции k,
; без ведущих нулей; возврат — новая позиция
func out_dec(dst, k, v)
  var t[20]
  var j
  var n
  n = 0
  if v == 0
    setb(dst, k, 48)
    return k + 1
  end
  while v > 0
    setb(t, n, 48 + v % 10)
    v = v / 10
    n = n + 1
  end
  j = 0
  while j < n
    setb(dst, k + j, getb(t, n - 1 - j))
    j = j + 1
  end
  return k + n
end

; 8 ЗАГЛАВНЫХ hex-цифр числа v (u32, 0 <= v < 2^32) в dst с позиции k,
; старшая цифра первой; возврат — k + 8
func out_hex(dst, k, v)
  var j
  var c
  j = 8
  while j > 0
    c = v & 15
    if c < 10
      c = c + 48
    else
      c = c + 55
    end
    setb(dst, k + j - 1, c)
    v = v >> 4
    j = j - 1
  end
  return k + 8
end
