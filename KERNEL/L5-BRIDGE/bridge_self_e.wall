; bridge_self_e.wall — примитивы эмиссии тела b2 (E9.2-3a/b)
; Паспорт: KERNEL/L5-BRIDGE/bridge_self_e.wall | слой: L5 (исходник — WALL)
; | роль: ветвь E моста — ПРИМИТИВЫ вывода .b2 (SPEC/15 п. 5/6/7):
; шапка (3 строки SPEC/15 — кириллица UTF-8 хранится HEX-текстом в
; литерале s_tpl корня (литералы WALL только ASCII 0x20..0x7E; идиома
; wall_self_blob — K2-E000 blob_dec) и декодируется в массив tplb при
; старте), инструкции — H-строки «H <байты> ; @<смещ4> <примечание>"
; (примечание == _note оракула: имена регистров по таблицам s_r64/
; s_r8/s_r16/s_r32 — смещения имён считаются при старте fill_offs,
; jcc — «j<cc> <цель>», знаковый hex imm/целей, [rip±d] знаковый dec,
; [mem], cl, счётчики), данные — DZ (пробег >= 3 нулей) и DB (<= 16
; байт; нулевой пробег короче 3 входит в DB). ДРАЙВЕР эмиссии (разрезы
; с метками l/d/iat_ + семантика DD/DQ + запись файла) — срез E9.2-3b
; в ветви L (bridge_self_l.wall, emit_body K5-L017); M-строки — E9.2-3c;
; PEG-выход — ветвь G (bridge_self_g.wall, E9.2-4). Предел вывода: outmem
; 16777216 Б кучи (16 МиБ, E9.5-1b — выделяет драйвер L; PEG v2
; доказуемо < ~9.2 МиБ, b2 реалистично <= ~6 МиБ) + ГВАРД app_ch
; (E9.5-1b): outcur >= 16777216 — ERR=BIG OUT (код 10) без частичных
; выходов (текст строится в куче ДО открытия файла) — патологические
; тела не могут молча повредить кучу; на допустимом классе
; недостижим (форма — единственное сравнение в воронке вывода).

; смещения NUL-разделённых имён (n имён) в блобе base -> массив offs
; (offs[i] — старт имени i; offs[n] — конец блоба)
func fill_offs(base, offs, n)
  var p
  var i
  p = 0
  i = 0
  while i < n
    offs[i] = p
    while getb(base, p) != 0
      p = p + 1
    end
    p = p + 1
    i = i + 1
  end
  offs[n] = p
  return 0
end

; стартовые таблицы: мнемоники (28), условия jcc (16), регистры
; 64/8/16/32 бит (16 имен каждый) — блобы s_* корня bridge.wall;
; слова размера kw (4 — byte/word/dword/qword с пробелом, E9.2-3c —
; ветвь M); шапки — HEX-литералы s_tpl (199 байт UTF-8) -> массив
; tplb (b2) и s_ptpl (72 байта) -> массив ptplb (PEG — E9.2-4,
; ветвь G); E9.4-4b-2: s_ftpl (194 байта) -> ftplb — ЧУЖАЯ шапка b2;
; E9.4-4b-3: s_gtpl (103 байта) -> gtplb — ШАПКА PEG v2 (ветвь G)
func init_tables
  fill_offs(s_mn, o_mn, 28)
  fill_offs(s_cc, o_cc, 16)
  fill_offs(s_r64, o_r64, 16)
  fill_offs(s_r8, o_r8, 16)
  fill_offs(s_r16, o_r16, 16)
  fill_offs(s_r32, o_r32, 16)
  fill_offs(s_kw, o_kw, 4)
  tpl_dec()
  ptpl_dec()
  ftpl_dec()
  gtpl_dec()
  return 0
end

; декод шаблона шапки: HEX-текст s_tpl (2 символа на байт) -> tplb
; (199 байт; идиома blob_dec wall.exe — K2-E000); hex-цифра: >57 —
; буква A..F (-55), иначе цифра (-48)
func tpl_dec
  var i
  var c
  var v
  i = 0
  while i < 199
    c = getb(s_tpl, 2 * i)
    if c > 57
      c = c - 55
    else
      c = c - 48
    end
    v = c * 16
    c = getb(s_tpl, 2 * i + 1)
    if c > 57
      c = c - 55
    else
      c = c - 48
    end
    setb(tplb, i, v + c)
    i = i + 1
  end
  return 0
end

; K5-E019 (E9.4-4b-2): декод шаблона ЧУЖОЙ шапки — HEX-текст s_ftpl
; -> ftplb (194 Б; как tpl_dec); куски: «; Исходник: чужой PE32+
; (секций » [0,51), «, DLL » [51,57), «; тело секции кода RVA »
; [57,94), «, » [94,96), « Б; !bss » [96,106), хвост «)\n; Круг:
; ...\n» [106,194) — первая строка шапки ОБЩАЯ с семьёй (tplb [0,54))
func ftpl_dec
  var i
  var c
  var v
  i = 0
  while i < 194
    c = getb(s_ftpl, 2 * i)
    if c > 57
      c = c - 55
    else
      c = c - 48
    end
    v = c * 16
    c = getb(s_ftpl, 2 * i + 1)
    if c > 57
      c = c - 55
    else
      c = c - 48
    end
    setb(ftplb, i, v + c)
    i = i + 1
  end
  return 0
end

; байт c в буфер вывода (outbuf/outcur — глобали); ГВАРД E9.5-1b:
; выход за предел outmem — ERR=BIG OUT (код 10) без частичных
; выходов (воронка ЕДИНАЯ для всех эмиссий b2/PEG — каждый байт
; вывода проходит здесь)
func app_ch(c)
  if outcur >= 16777216
    print_error(s_bout, len(s_bout), 10)
  end
  setb(outbuf, outcur, c)
  outcur = outcur + 1
  return 0
end

; имя из блоба base (таблица смещений offs, индекс idx) в вывод —
; до NUL
func app_name(base, offs, idx)
  var p
  p = offs[idx]
  while getb(base, p) != 0
    app_ch(getb(base, p))
    p = p + 1
  end
  return 0
end

; имя регистра idx (0..15) размера size (8/16/32/64) — выбор блоба
func app_reg(idx, size)
  if size == 8
    app_name(s_r8, o_r8, idx)
    return 0
  end
  if size == 16
    app_name(s_r16, o_r16, idx)
    return 0
  end
  if size == 64
    app_name(s_r64, o_r64, idx)
    return 0
  end
  app_name(s_r32, o_r32, idx)
  return 0
end

; ЗАГЛАВНЫЙ hex без ведущих нулей, v >= 0 (DZ-счёт, target/bss шапки)
func out_hexv(v)
  var t[20]
  var n
  var j
  var c
  if v == 0
    app_ch(48)
    return 0
  end
  n = 0
  while v > 0
    c = v & 15
    if c < 10
      c = c + 48
    else
      c = c + 55
    end
    setb(t, n, c)
    v = v >> 4
    n = n + 1
  end
  j = 0
  while j < n
    app_ch(getb(t, n - 1 - j))
    j = j + 1
  end
  return 0
end

; знаковый hex (imm, цель, счётчик): отрицательное — «-» + модуль
; (как _hx оракула; цели «%X» отрицательные — тот же вид)
func out_hxs(v)
  if v < 0
    app_ch(45)
    v = -v
  end
  out_hexv(v)
  return 0
end

; hex imm64 как БЕЗзнакового 64-битного (вид 7): отрицательное в
; WALL qword = битовый образ u64 -> +2^64 (2^64 = 16777216*256*2^32)
func out_hxu64(v)
  if v < 0
    v = v + 16777216 * 256 * 16777216 * 256
  end
  out_hexv(v)
  return 0
end

; ровно 2 ЗАГЛАВНЫЕ hex-цифры байта v (байты H/DB-строк)
func out_hex2(v)
  var c
  c = (v >> 4) & 15
  if c < 10
    c = c + 48
  else
    c = c + 55
  end
  app_ch(c)
  c = v & 15
  if c < 10
    c = c + 48
  else
    c = c + 55
  end
  app_ch(c)
  return 0
end

; минимум 4 ЗАГЛАВНЫЕ hex-цифры (смещения «@%04X»), v >= 0
func out_hex4m(v)
  var t[20]
  var n
  var j
  var c
  n = 0
  while v > 0
    c = v & 15
    if c < 10
      c = c + 48
    else
      c = c + 55
    end
    setb(t, n, c)
    v = v >> 4
    n = n + 1
  end
  if n == 0
    setb(t, 0, 48)
    n = 1
  end
  while n < 4
    setb(t, n, 48)
    n = n + 1
  end
  j = 0
  while j < n
    app_ch(getb(t, n - 1 - j))
    j = j + 1
  end
  return 0
end

; знаковый dec СО знаком («+»/«-»; смещения [rip%+d]); v != 0
func out_sdec(v)
  if v < 0
    app_ch(45)
    v = -v
  else
    app_ch(43)
  end
  outcur = out_dec(outbuf, outcur, v)
  return 0
end

; примечание H-строки одного операнда (слот 1/2) — == _note оракула:
; рег -> имя; память rip -> «[rip+d]» (0 -> «[rip]»), прочая ->
; «[mem]»; imm -> знаковый hex; imm-u64 -> беззнаковый; цель ->
; hex; cl -> «cl»; счётчик -> hex
func note_op(slot)
  var k
  var v
  var d
  if slot == 1
    k = da1k
    v = da1v
  else
    k = da2k
    v = da2v
  end
  if k == 1
    if slot == 1
      app_reg(da1r, da1s)
    else
      app_reg(da2r, da2s)
    end
    return 0
  end
  if k == 2
    if mripon == 1
      outcur = copy_str(outbuf, outcur, s_rip, len(s_rip))
      d = omrip + 4096
      if d != 0
        out_sdec(d)
      end
      app_ch(93)
    else
      outcur = copy_str(outbuf, outcur, s_mem, len(s_mem))
    end
    return 0
  end
  if k == 3 || k == 4 || k == 6
    out_hxs(v)
    return 0
  end
  if k == 7
    out_hxu64(v)
    return 0
  end
  if k == 5
    outcur = copy_str(outbuf, outcur, s_cl, len(s_cl))
  end
  return 0
end

; примечание H-строки — == _note оракула: jcc -> «j<cc> <цель>»;
; ret/int3/cdqe/cqo/cdq -> только имя; прочее -> имя + операнды через
; «, » (при 0 операндов — хвостовой пробел, как «%s %s» оракула)
func emit_note
  if dname == 0
    outcur = copy_str(outbuf, outcur, s_j, len(s_j))
    app_name(s_cc, o_cc, dcc)
    app_ch(32)
    out_hxs(da1v)
    return 0
  end
  app_name(s_mn, o_mn, dname)
  if dname == 15 || dname == 16 || dname == 12 || dname == 13 || dname == 14
    return 0
  end
  app_ch(32)
  if dargc >= 1
    note_op(1)
  end
  if dargc >= 2
    outcur = copy_str(outbuf, outcur, s_comma, len(s_comma))
    note_op(2)
  end
  return 0
end

; H-строка выжившей инструкции @ lo (смещение тела): повторный decode
; (детерминирован — спуск уже разобрал её), байты тела с rawptr+lo,
; « ; @<смещ4> » + примечание; сбой повтора = FAMILY (недостижимо)
func emit_h(lo)
  var j
  if decode_ins(lo) != 0
    fail_family()
  end
  outcur = copy_str(outbuf, outcur, s_h, len(s_h))
  j = 0
  while j < dlen
    if j > 0
      app_ch(32)
    end
    out_hex2(getb(exebuf, rawptr + lo + j))
    j = j + 1
  end
  outcur = copy_str(outbuf, outcur, s_at, len(s_at))
  out_hex4m(lo)
  app_ch(32)
  emit_note()
  app_ch(10)
  return 0
end

; данные сегмента [o, hi): DZ-пробег (>= 3 нулей) или DB-строка
; (<= 16 байт; нулевой пробег короче 3 входит в DB, разрывая строку
; перед пробегом >= 3) — == оракулу _emit_lines
func emit_data(o, hi)
  var z
  var zz
  var first
  while o < hi
    z = 0
    while o + z < hi && getb(exebuf, rawptr + o + z) == 0
      z = z + 1
    end
    if z >= 3
      outcur = copy_str(outbuf, outcur, s_dz, len(s_dz))
      out_hexv(z)
      outcur = copy_str(outbuf, outcur, s_at, len(s_at))
      out_hex4m(o)
      app_ch(10)
      o = o + z
    else
      first = o
      outcur = copy_str(outbuf, outcur, s_db, len(s_db))
      while o < hi && o - first < 16
        if getb(exebuf, rawptr + o) == 0
          zz = 0
          while o + zz < hi && getb(exebuf, rawptr + o + zz) == 0
            zz = zz + 1
          end
          if zz >= 3
            break
          end
        end
        if o > first
          app_ch(32)
        end
        out_hex2(getb(exebuf, rawptr + o))
        o = o + 1
      end
      outcur = copy_str(outbuf, outcur, s_at, len(s_at))
      out_hex4m(first)
      app_ch(10)
    end
  end
  return 0
end

; кусок шаблона шапки [lo, hi) — байты из массива tplb (декод
; HEX-литерала s_tpl — tpl_dec; границы кусков: имя модуля [0,74),
; target [74,112), bss [112,122), хвост [122,199))
func app_tpl(lo, hi)
  var j
  j = lo
  while j < hi
    app_ch(getb(tplb, j))
    j = j + 1
  end
  return 0
end

; K5-E020 (E9.4-4b-2): кусок шаблона ЧУЖОЙ шапки [lo, hi) — байты
; из массива ftplb (декод s_ftpl — ftpl_dec; как app_tpl)
func app_ftpl(lo, hi)
  var j
  j = lo
  while j < hi
    app_ch(getb(ftplb, j))
    j = j + 1
  end
  return 0
end
