; bridge_self_w.wall — спуск от входа: проход кода, тени, target/bss (E9.2-2/3a/4-4a/4-4b-1)
; Паспорт: KERNEL/L5-BRIDGE/bridge_self_w.wall | слой: L5 (исходник — WALL)
; | роль: ветвь W моста — СЛОВАРЬ спуска оракула _walk/_sweep/
; parse_family/parse_foreign (SPEC/15 п. 3, п. 7; E9.4-4b-1: старт —
; entryrva - codevaddr (RVA секции кода — семья 4096), вилка target —
; falign ОБРАЗА (семья 512), границы — глобали секции кода от ветви
; P/P2): K5-W001 walk_code — стек целей
; (куча GlobalAlloc 2097160 — 262145 qword, доказуемый предел
; 1 + rawlim: каждый офсет тела — в стеке РОВНО один раз, карта
; дедупликации pushmap 262145 — K5-W005; прямые цели/кандидаты
; таблиц — повторами не кладутся, холосты для спуска — семантика
; == оракулу), карты стартов insmap 262145 и длин lenmap 262145 —
; байтовые, кучи GlobalAlloc; rawlim = min(vsize, rawsize) —
; эквивалент предела vsize оракула при чтениях, ограниченных телом;
; проход вперёд от каждой цели до обрыва (терминалы ret/int3,
; прямой jmp и КОСВЕННЫЙ FF /4 — класс 5: K5-W004 jtab — кандидаты
; таблицы переходов E9.4-2, затем обрыв; сбой декодирования и
; ВСЕ-НУЛЕВЫЕ байты инструкции — данные); K5-W002 sweep_ins —
; пересечения: младший адрес побеждает (курсор концов; выжившая
; инструкция, конец за vsize — ERR=FAMILY; счёт inscount и maxend)
; + СДАМП ВЫЖИВШИХ sdump (E9.2-3a: куча rawlim*8+8 — по qword на
; старт, эмиссия ветви E идёт по нему в порядке возрастания — без
; повторных сканов insmap; доказуемый предел: выживших <= rawlim —
; каждая занимает >= 1 байт); K5-W003 calc_target — длина тела:
; max(последний ненулевой байт + 1, концы выживших, 1); выравнивающая
; вилка: align_up(target) != rawsize -> target = rawsize - 511
; (минимальная длина той же вилки); target > vsize — ERR=FAMILY;
; bss = vsize - target. Факты INS/TARGET/BSS — факты оракула
; parse_family (диффтест T-E9-18/21); raw-эмиссия по sdump —
; T-E9-22/23 (ветвь E).

; цель в стек — ДЕДУПЛИКАЦИЯ по значению (K5-W005, E9.4-4a):
; каждый офсет тела — в стеке РОВНО один раз (карта pushmap;
; повторы — прямые цели разных переходов и строки таблиц — холосты
; для спуска: ins-карта уже стоит / поставит первый) — семантика
; == оракулу (список Python без предела); вне [0, rawlim) НЕ
; кладётся — цикл спуска отбросил бы сразу (== поведению оракула);
; предел pend: 1 + rawlim < 262145 qword
func push_tgt(v)
  if v >= 0
    if v < rawlim
      if getb(pushmap, v) == 0
        setb(pushmap, v, 1)
        pend[psp] = v
        psp = psp + 1
      end
    end
  end
  return 0
end

; таблица переходов (K5-W004, E9.4-2 -> порт E9.4-4a; == _jtab
; оракула): косвенный jmp qword [rip+X] (память rip БЕЗ базы и
; индекса, размер 64) — qword-строки данных «до первого non-code
; qword» — цели-кандидаты; чтение qword — тело + виртуальные нули
; (за концом файла — нули: fb -1 -> 0, == усечению срезки оракула);
; кандидат 0 < v < vsize -> push_tgt (дедупликация); терминатор —
; первый non-code qword (0 или вне VirtualSize — отрицательное
; переполнение знакового qword гасится тем же условием v <= 0);
; регистровые/индексные формы (jmp r64, [base+idx]) — БЕЗ кандидатов
; (E9.4-1: цель = значение операнда, без исполнения не вычислить).
; Вызов — ТОЛЬКО из walk_code при dcls 5 (терминал)
func jtab
  var off
  var v
  var bt
  var j
  if da1k != 2 || mripon != 1 || da1s != 64 || ombase >= 0 || omidx >= 0
    return 0
  end
  off = omrip
  while off >= 0 && off + 8 <= vsize
    v = 0
    j = 0
    while j < 8
      bt = fb(rawptr + off + j)
      if bt < 0
        bt = 0
      end
      v = v + (bt << (j * 8))
      j = j + 1
    end
    if v <= 0 || v >= vsize
      break
    end
    push_tgt(v)
    off = off + 8
  end
  return 0
end

; спуск от точки входа: карты стартов/длин + стек целей (кучи);
; проход каждой цели вперёд: уже разобрана / сбой декодера / нули —
; обрыв пути; ret/int3 — терминалы; dcls 5 (косвенный jmp FF /4) —
; терминал с кандидатами jtab; jcc/call rel32 кладут цель в стек
; (jmp и jcc/call — путь: jmp только цель, jcc/call и дальше)
func walk_code
  var a
  var z
  var j
  insmap = GlobalAlloc(0, 262145)
  lenmap = GlobalAlloc(0, 262145)
  pend = GlobalAlloc(0, 2097160)
  pushmap = GlobalAlloc(0, 262145)
  if insmap == 0 || lenmap == 0 || pend == 0 || pushmap == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  if vsize < rawsize
    rawlim = vsize
  else
    rawlim = rawsize
  end
  a = entryrva - codevaddr
  pend[0] = a
  psp = 1
  if a >= 0 && a < rawlim
    setb(pushmap, a, 1)
  end
  while psp > 0
    psp = psp - 1
    a = pend[psp]
    while a >= 0 && a < rawlim
      if getb(insmap, a) == 1
        break
      end
      if decode_ins(a) != 0
        break
      end
      z = 0
      j = 0
      while j < dlen
        if getb(exebuf, rawptr + a + j) != 0
          z = 1
          break
        end
        j = j + 1
      end
      if z == 0
        break
      end
      setb(insmap, a, 1)
      setb(lenmap, a, dlen)
      if dcls == 1
        break
      end
      if dcls == 5
        jtab()
        break
      end
      if dcls == 2 || dcls == 3 || dcls == 4
        push_tgt(dtgt)
      end
      if dcls == 2
        break
      end
      a = a + dlen
    end
  end
  return 0
end

; тени: пересечения путей — младший адрес побеждает; выжившие: конец
; (локаль iend — имя «end» занято терминатором блока WALL) за
; VirtualSize — ERR=FAMILY (как BridgeError оракула; проверяются
; ТОЛЬКО выжившие); inscount и maxend (концы выживших) -> глобали;
; СДАМП: старты выживших по возрастанию -> куча sdump (E9.2-3a —
; курс эмиссии ветви E; размер rawlim*8+8 — по qword на выжившего)
func sweep_ins
  var a
  var ln
  var iend
  sdump = GlobalAlloc(0, rawlim * 8 + 8)
  if sdump == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  inscount = 0
  maxend = 0
  swcur = 0
  a = 0
  while a < rawlim
    if getb(insmap, a) == 1 && a >= swcur
      ln = getb(lenmap, a)
      iend = a + ln
      if iend > vsize
        fail_family()
      end
      if iend > maxend
        maxend = iend
      end
      sdump[inscount] = a
      inscount = inscount + 1
      swcur = iend
    end
    a = a + 1
  end
  return 0
end

; длина тела: target = max(последний ненулевой байт + 1, концы
; выживших, 1); выравнивающая вилка (E9.4-4b-1 — falign ОБРАЗА,
; семья: 512): align_up(target, falign) != rawsize — target =
; rawsize - (falign - 1) (та же вилка минимальной длины); target >
; vsize — ERR=FAMILY; bss = vsize - target (SPEC/15 п. 7)
func calc_target
  var k
  var nz
  var fork
  nz = 0
  k = rawsize - 1
  while k >= 0
    if getb(exebuf, rawptr + k) != 0
      nz = k + 1
      break
    end
    k = k - 1
  end
  target = nz
  if target < 1
    target = 1
  end
  if maxend > target
    target = maxend
  end
  fork = (target + falign - 1) / falign * falign
  if fork != rawsize
    target = rawsize - (falign - 1)
  end
  if target > vsize
    fail_family()
  end
  bss = vsize - target
  return 0
end
