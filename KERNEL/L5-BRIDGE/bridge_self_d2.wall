; bridge_self_d2.wall — декодер x86-подмножества SPEC/05, часть 2 (E9.2-3a)
; Паспорт: KERNEL/L5-BRIDGE/bridge_self_d2.wall | слой: L5 (исходник — WALL)
; | роль: ветвь D моста (декодер) — вторая половина: короткие
; без-modrm формы (K5-D008 decimm: push/pop 50..5F — операнд r64 с
; REX.B; cdqe/cqo 98/99; B0..B7 mov r8,imm8; B8..BF mov r,imm — при W
; imm64 ЧИТАЕТСЯ u64 и печатается беззнаковым (вид 7); C3/CC —
; терминалы), сдвиги (K5-D009 decshift: C0/C1 с imm8 — счётчик-целое,
; маска 63 при размере 64, иначе 31 (правило Intel, SPEC/05); D3 — по
; cl), imm-группа (K5-D010 decgrp: 80/81/83 — reg из {add,or,and,sub,
; xor,cmp} с REX.R; imm 4/1 байта, при 81+W — знакорасширение s32),
; хвостовые группы (K5-D011 decgrp2: C6/C7 mov r/m,imm — reg НЕ
; проверяется оракулом; F6/F7 — neg /3 и idiv /7 (только F7)); FF —
; с E9.4-4a в decff (K5-D024, bridge_self_d3.wall: /0 inc, /1 dec,
; /2 call КОСВЕННЫЙ класс 0, /4 jmp КОСВЕННЫЙ класс 5 — терминал
; спуска; разрез по лимиту 500 строк — прецедент m/m2/m3/m4).
; Границы чтений (E9.4-4b-1): fend — конец ТЕЛА секции кода
; (rawptr+rawsize; у семьи == exelen — нейтрально, как len(body)
; оракула — см. bridge_self_d.wall)
; и переходы (K5-D012 decbr: E8 call rel32 класс 4, E9/EB jmp класс 2,
; 70..7F jcc rel8 класс 3 — dcc = условие, операнд-цель; цель -> dtgt
; как конец инструкции + rel). Диспетчер K5-D013 decode_ins — REX-префикс
; (W/R/X/B-биты), 0F-делегация (bridge_self_d.wall) и таблица вызовов;
; результат — глобали dlen/dcls/dtgt + ОПЕРАНДЫ da1*/da2*/om* (E9.2-3a:
; модрм-операнд — регистр mod=3 или память; rip-цель omrip = конец
; инструкции + disp32 — считается здесь, после полного разбора хвоста).
; Часть 1 — bridge_self_d.wall (fb/rel8/rel32/u32/u64/modrm_read/
; setters/dec0f/decalu/decmod); эмиссия — bridge_self_e.wall (ветвь E).

; короткие без-modrm: push/pop (50..5F, длина 1/2 с REX; операнд —
; r64 с REX.B), cdqe (98: операнд rax), cqo/cdq (99: без операндов),
; B0..B7 mov r8,imm8, B8..BF mov r,imm (W: imm64 — вид 7, беззнаковая
; печать), C3 ret / CC int3 — класс 1 (терминал пути спуска)
func decimm(pos, rex, b)
  var w
  var bbit
  var size
  w = rex & 8
  bbit = (rex & 1) * 8
  size = 32
  if w != 0
    size = 64
  end
  if b >= 80 && b <= 87
    dpos = pos
    dname = 10
    dargc = 1
    set_reg(1, (b & 7) + bbit, 64)
    return 0
  end
  if b >= 88 && b <= 95
    dpos = pos
    dname = 11
    dargc = 1
    set_reg(1, (b & 7) + bbit, 64)
    return 0
  end
  if b == 152
    dpos = pos
    dname = 12
    dargc = 1
    set_reg(1, 0, size)
    return 0
  end
  if b == 153
    dpos = pos
    dname = 13
    if w == 0
      dname = 14
    end
    return 0
  end
  if b == 195 || b == 204
    dpos = pos
    dcls = 1
    if b == 195
      dname = 15
    else
      dname = 16
    end
    return 0
  end
  if b >= 176 && b <= 183
    if pos + 1 > fend
      return 1
    end
    dpos = pos + 1
    dname = 8
    dargc = 2
    set_reg(1, (b & 7) + bbit, 8)
    set_imm(2, getb(exebuf, pos), 8)
    return 0
  end
  if w != 0
    if pos + 8 > fend
      return 1
    end
    dpos = pos + 8
    dname = 8
    dargc = 2
    set_reg(1, (b & 7) + bbit, 64)
    set_immu(2, u64(pos), 64)
    return 0
  end
  if pos + 4 > fend
    return 1
  end
  dpos = pos + 4
  dname = 8
  dargc = 2
  set_reg(1, (b & 7) + bbit, 32)
  set_imm(2, u32(pos), 32)
  return 0
end

; сдвиги C0/C1 (imm8) и D3 (по cl): modrm-хвост + reg в {0,4,5,7}
; (rol/shl/shr/sar) с REX.R — прочее: отказ (как UnknownOpcode);
; счётчик C0/C1 — ЦЕЛОЕ (маска 0x3F при размере 64 — REX.W, иначе 0x1F;
; правило Intel, SPEC/05), D3 — операнд «cl»
func decshift(pos, rex, b)
  var opsize
  var w
  var cnt
  w = rex & 8
  opsize = 32
  if w != 0
    opsize = 64
  end
  if b == 192
    opsize = 8
  end
  if modrm_read(pos, rex, opsize) != 0
    return 1
  end
  if mreg != 0 && mreg != 4 && mreg != 5 && mreg != 7
    return 1
  end
  dargc = 2
  set_rm(1, opsize)
  if mreg == 0
    dname = 21
  else
    if mreg == 4
      dname = 22
    else
      if mreg == 5
        dname = 23
      else
        dname = 24
      end
    end
  end
  if b == 192 || b == 193
    if mpos + 1 > fend
      return 1
    end
    cnt = getb(exebuf, mpos)
    if opsize == 64
      cnt = cnt & 63
    else
      cnt = cnt & 31
    end
    set_cnt(cnt)
    dpos = mpos + 1
    return 0
  end
  set_cl()
  dpos = mpos
  return 0
end

; imm-группа 80/81/83: modrm-хвост + reg в {0,1,4,5,6,7} (add/or/and/
; sub/xor/cmp) с REX.R; imm: 81 — 4 байта (при W — знакорасширение
; s32), 80/83 — 1 байт (80 — беззнаковый байт, 83 — знаковый s8)
func decgrp(pos, rex, b)
  var opsize
  var w
  var v
  w = rex & 8
  opsize = 32
  if w != 0
    opsize = 64
  end
  if b == 128
    opsize = 8
  end
  if modrm_read(pos, rex, opsize) != 0
    return 1
  end
  if mreg != 0 && mreg != 1 && mreg != 4 && mreg != 5 && mreg != 6 && mreg != 7
    return 1
  end
  dargc = 2
  set_rm(1, opsize)
  if mreg == 0
    dname = 1
  else
    if mreg == 1
      dname = 2
    else
      if mreg == 4
        dname = 3
      else
        if mreg == 5
          dname = 4
        else
          if mreg == 6
            dname = 5
          else
            dname = 6
          end
        end
      end
    end
  end
  if b == 129
    if mpos + 4 > fend
      return 1
    end
    v = u32(mpos)
    if w != 0 && v > 2147483647
      v = v - 16777216 * 256
    end
    set_imm(2, v, opsize)
    dpos = mpos + 4
    return 0
  end
  if mpos + 1 > fend
    return 1
  end
  v = getb(exebuf, mpos)
  if b == 131
    if v >= 128
      v = v - 256
    end
  end
  set_imm(2, v, opsize)
  dpos = mpos + 1
  return 0
end

; (урок E9.2-2: 0xC6 = 198, не 196 — поймано диффтестом T-E9-18 на
; hexgen/pegen/brick/enc/splice: путь обрывался на mov [rcx],0)
; хвостовые группы: C6/C7 mov r/m,imm (reg НЕ проверяется оракулом —
; длина не зависит; imm 1/4 байта, при C7+W — s32), F6 (только neg /3),
; F7 (neg /3 или idiv /7); FF — делегация в decff (E9.4-4a: /4 —
; косвенный jmp класса 5; peek ext с REX.R до modrm_read — размер /4
; всегда 64; разрез по лимиту 500 строк)
func decgrp2(pos, rex, b)
  var opsize
  var w
  var v
  w = rex & 8
  opsize = 32
  if w != 0
    opsize = 64
  end
  if b == 198
    if modrm_read(pos, rex, 8) != 0
      return 1
    end
    if mpos + 1 > fend
      return 1
    end
    dpos = mpos + 1
    dname = 8
    dargc = 2
    set_rm(1, 8)
    set_imm(2, getb(exebuf, mpos), 8)
    return 0
  end
  if b == 199
    if modrm_read(pos, rex, opsize) != 0
      return 1
    end
    if mpos + 4 > fend
      return 1
    end
    v = u32(mpos)
    if w != 0 && v > 2147483647
      v = v - 16777216 * 256
    end
    dpos = mpos + 4
    dname = 8
    dargc = 2
    set_rm(1, opsize)
    set_imm(2, v, opsize)
    return 0
  end
  if b == 246
    if modrm_read(pos, rex, 8) != 0
      return 1
    end
    if mreg != 3
      return 1
    end
    dpos = mpos
    dname = 25
    dargc = 1
    set_rm(1, 8)
    return 0
  end
  if b == 247
    if modrm_read(pos, rex, opsize) != 0
      return 1
    end
    if mreg != 3 && mreg != 7
      return 1
    end
    dpos = mpos
    if mreg == 3
      dname = 25
    else
      dname = 26
    end
    dargc = 1
    set_rm(1, opsize)
    return 0
  end
  if b == 255
    return decff(pos, rex, w)
  end
  return 1
end

; переходы: E8 call rel32 (класс 4 — цель в стек спуска, путь идёт
; дальше), E9/EB jmp rel32/rel8 (класс 2 — терминал пути), 70..7F jcc
; rel8 (класс 3 — цель + fall-through); dtgt = конец инструкции
; (файловое) - rawptr + rel (смещение от начала тела)
func decbr(pos, b)
  var rel
  if b == 232
    if pos + 4 > fend
      return 1
    end
    rel = rel32(pos)
    dpos = pos + 4
    dtgt = dpos - rawptr + rel
    dcls = 4
    dname = 18
    set_tgt(dtgt)
    return 0
  end
  if b == 233
    if pos + 4 > fend
      return 1
    end
    rel = rel32(pos)
    dpos = pos + 4
    dtgt = dpos - rawptr + rel
    dcls = 2
    dname = 17
    set_tgt(dtgt)
    return 0
  end
  if b == 235
    if pos + 1 > fend
      return 1
    end
    rel = rel8(pos)
    dpos = pos + 1
    dtgt = dpos - rawptr + rel
    dcls = 2
    dname = 17
    set_tgt(dtgt)
    return 0
  end
  if pos + 1 > fend
    return 1
  end
  rel = rel8(pos)
  dpos = pos + 1
  dtgt = dpos - rawptr + rel
  dcls = 3
  dname = 0
  dcc = b & 15
  set_tgt(dtgt)
  return 0
end

; декодер одной инструкции @ a (смещение от начала тела): чтение
; байтов с rawptr+a; REX 40..4F -> W/R/X/B-биты; 0F -> dec0f; диспетчер
; по точным множествам байтов decode оракула (ALU 00..3D, группы 80/81/
; 83, test/mov/lea 84..8D, push/pop 50..5F, cdqe/cqo 98/99, B0..BF,
; сдвиги C0/C1/D3, C3/CC, C6/C7, переходы E8/E9/EB/70..7F, F6/F7,
; FF); прочее — отказ (данные). Результат: dlen (длина), dcls
; (0 прочее / 1 ret,int3 / 2 jmp / 3 jcc / 4 call rel32), dtgt (прямая
; цель — смещение от начала тела, может быть отрицательной или за
; пределами — фильтрует спуск) + ОПЕРАНДЫ (E9.2-3a): dname (id
; мнемоники; 0 = jcc — имя из dcc), dcc, dargc, da1k/da2k (вид:
; 1 рег / 2 память / 3 imm / 4 цель / 5 cl / 6 счётчик / 7 imm-u64),
; da1r/da2r (индекс регистра), da1s/da2s (размер), da1v/da2v (значение
; imm/цель/счётчик), damem (слот памяти), om* (поля памяти; omrip —
; цель rip-ссылки, смещение тела = конец инструкции + disp32).
; 0 = ок, 1 = отказ декодирования
func decode_ins(a)
  var pos
  var b
  var rex
  var w
  var base
  var alu
  var short1
  var short4
  var rc
  dcls = 0
  dtgt = 0
  dargc = 0
  dname = 0
  dcc = 0
  da1k = 0
  da2k = 0
  damem = 0
  mripon = 0
  mrdip = 0
  omrip = 0
  ombase = -1
  omidx = -1
  omscale = 1
  omdisp = 0
  pos = rawptr + a
  b = fb(pos)
  if b < 0
    return 1
  end
  pos = pos + 1
  rex = 0
  if b >= 64 && b <= 79
    rex = b
    b = fb(pos)
    if b < 0
      return 1
    end
    pos = pos + 1
  end
  w = rex & 8
  rc = 1
  if b == 15
    rc = dec0f(pos, rex, w)
  else
    base = b & 248
    alu = 0
    if base == 0 || base == 8 || base == 32 || base == 40 || base == 48 || base == 56
      alu = 1
    end
    short1 = 0
    if b == 4 || b == 12 || b == 36 || b == 44 || b == 60
      short1 = 1
    end
    short4 = 0
    if b == 5 || b == 13 || b == 37 || b == 45 || b == 53 || b == 61
      short4 = 1
    end
    if (b & 7) < 4 && alu == 1 || short1 == 1 || short4 == 1
      rc = decalu(pos, rex, w, b)
    else
      if b == 128 || b == 129 || b == 131
        rc = decgrp(pos, rex, b)
      else
        if b == 132 || b == 133 || b == 136 || b == 137 || b == 138 || b == 139 || b == 141
          rc = decmod(pos, rex, w, b)
        else
          if b >= 80 && b <= 95 || b == 152 || b == 153 || b == 195 || b == 204 || b >= 176 && b <= 191
            rc = decimm(pos, rex, b)
          else
            if b == 192 || b == 193 || b == 211
              rc = decshift(pos, rex, b)
            else
              if b == 198 || b == 199 || b == 246 || b == 247 || b == 255
                rc = decgrp2(pos, rex, b)
              else
                if b == 232 || b == 233 || b == 235 || b >= 112 && b <= 127
                  rc = decbr(pos, b)
                end
              end
            end
          end
        end
      end
    end
  end
  if rc != 0
    return 1
  end
  dlen = dpos - rawptr - a
  if mripon == 1
    omrip = dpos - rawptr + mrdip
  end
  return 0
end
