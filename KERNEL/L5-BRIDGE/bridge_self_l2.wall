; bridge_self_l2.wall — рендер и драйвер эмиссии, часть 2 (E9.2-3b/c; E9.4-4b-2: isf)
; Паспорт: KERNEL/L5-BRIDGE/bridge_self_l2.wall | слой: L5 (исходник —
; WALL) | роль: ветвь L моста, ЧАСТЬ 2 — РЕНДЕР И ДРАЙВЕР (КАНОН:
; E9.2-3c — m_line ветви M ПЕРЕД emit_h, счёты mcount/hcount в
; факт-строку; режимы RAW/H оракула — срезы E9.2-3a/b; E9.4-4b-2:
; шапка — РАЗВИЛКА isf (семейная tplb/модуль | чужая ftplb/факты),
; тело прохода — ОБЩЕЕ, карты построены с base = codevaddr): K5-L011 out_hexl
; (СТРОЧНЫЙ hex без ведущих нулей — имена l*/d*: «l%x»/«d%x»), K5-L012
; emit_labname (имя метки по labmap: d*/l* | iat_ из блоба snam —
; индекс (off-iatoff)/8), K5-L013 emit_cut (строка разреза «:имя ;
; @смещ4»), K5-L014 emit_dollar (dword -> «$имя» по knownoff |
; ЗАГЛАВНЫЙ hex — как _dollar/_hx оракула), K5-L015 emit_sem (DD — 5
; значений дескриптора IDT через пробел; DQ — «$имя» hint-структуры |
; «0» терминатор), K5-L017 emit_body — ДРАЙВЕР: шапка SPEC/15 (шаблон
; tplb + модуль/target/bss) + линейный проход [0, target) по
; событиям (метка -> семантика DD 20 / DQ 8 -> H-строка выжившей ->
; данные DZ-DB до следующего события; поиск вперёд — каждый байт
; <= 2 раз, линейно), запись <выход>.b2 (CreateFile2 WRITE/
; CREATE_ALWAYS — коды 8/9, как wall.exe/uva.exe; outmem 8388608 Б).
; Карты/семантика — часть 1 (bridge_self_l.wall, K5-L001..L010 +
; K5-L016 build_maps); примитивы вывода/H-строки/данные — ветвь E;
; M-строки — ветвь M (bridge_self_m*.wall); эквивалентность оракулу —
; T-E9-22/23 (канон).

; K5-L011: СТРОЧНЫЙ hex без ведущих нулей (имена l*/d*: «l%x»/«d%x»
; оракула), v >= 0
func out_hexl(v)
  var t[20]
  var n
  var j
  var c
  if v == 0
    app_ch(48)
    return 0
  end
  n = 0
  while v > 0
    c = v & 15
    if c < 10
      c = c + 48
    else
      c = c + 87
    end
    setb(t, n, c)
    v = v >> 4
    n = n + 1
  end
  j = 0
  while j < n
    app_ch(getb(t, n - 1 - j))
    j = j + 1
  end
  return 0
end

; K5-L012: имя метки @ off по labmap: d* («d»+hex строчный),
; l* («l»+hex), iat_ (блоб snam — индекс (off-iatoff)/8);
; E9.4-4b-2: имена — RVA = off + codevaddr (base = vaddr секции
; кода — у семьи 4096, нейтрально; оракул «l%x»/(off + base))
func emit_labname(off)
  var k
  var p
  if getb(labmap, off) == 1
    app_ch(100)
    out_hexl(off + codevaddr)
    return 0
  end
  if getb(labmap, off) == 2
    app_ch(108)
    out_hexl(off + codevaddr)
    return 0
  end
  k = (off - iatoff) / 8
  p = noffs[k]
  while getb(snam, p) != 0
    app_ch(getb(snam, p))
    p = p + 1
  end
  return 0
end

; K5-L013: строка разреза «:имя ; @смещ4» (минимум 4 ЗАГЛАВНЫЕ цифры)
func emit_cut(off)
  app_ch(58)
  emit_labname(off)
  outcur = copy_str(outbuf, outcur, s_at, len(s_at))
  out_hex4m(off)
  app_ch(10)
  return 0
end

; K5-L014: значение dword v -> «$имя» (RVA метки из knownoff) |
; ЗАГЛАВНЫЙ hex без ведущих нулей (как _dollar/_hx оракула);
; E9.4-4b-2: RVA = смещение + codevaddr (base; у семьи 4096)
func emit_dollar(v)
  var j
  j = 0
  while j < kn
    if knownoff[j] + codevaddr == v
      app_ch(36)
      emit_labname(knownoff[j])
      return 0
    end
    j = j + 1
  end
  out_hexv(v)
  return 0
end

; K5-L015: строка семантики semrows[i]: DD — 5 значений дескриптора
; IDT (через пробел), DQ — «$имя» hint-структуры | «0» (терминатор);
; хвост « ; @смещ4»
func emit_sem(i)
  var off
  var kind
  var h
  var j
  off = semrows[3 * i]
  kind = semrows[3 * i + 1]
  h = semrows[3 * i + 2]
  if kind == 1
    outcur = copy_str(outbuf, outcur, s_dd, len(s_dd))
    j = 0
    while j < 5
      if j > 0
        app_ch(32)
      end
      emit_dollar(rd32(exebuf, rawptr + h + 4 * j))
      j = j + 1
    end
  else
    outcur = copy_str(outbuf, outcur, s_dq, len(s_dq))
    if h < 0
      app_ch(48)
    else
      app_ch(36)
      emit_labname(h)
    end
  end
  outcur = copy_str(outbuf, outcur, s_at, len(s_at))
  out_hex4m(off)
  app_ch(10)
  return 0
end

; K5-L016: сборка всех карт режима H: sstate (выжившие), импорты
; (записи/имена/базы/метки/known), семантика (кандидаты DD/DQ ->
; приёмка), метки операндов; кучи: labmap/semstate 262145 Б + массивы
; по impn (knownoff <= impn+3, noffs impn, snam <= 64*impn, semrows
; <= 3*(2*impn+3) qword)
func build_maps
  labmap = GlobalAlloc(0, 262145)
  semstate = GlobalAlloc(0, 262145)
  if labmap == 0 || semstate == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  build_sstate()
  imp_hints()
  imp_offs()
  knownoff = GlobalAlloc(0, impn * 8 + 32)
  noffs = GlobalAlloc(0, impn * 8 + 8)
  snam = GlobalAlloc(0, impn * 64 + 64)
  semrows = GlobalAlloc(0, (2 * impn + 3) * 24 + 24)
  if knownoff == 0 || noffs == 0 || snam == 0 || semrows == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  kn = 0
  snlen = 0
  semcnt = 0
  semacc = 0
  imp_labels()
  if impbad == 0
    dd_idt()
    dq_base(iatoff)
    if intoff != iatoff
      dq_base(intoff)
    end
    sem_filter()
  end
  ins_labels()
  return 0
end

; K5-L017: ДРАЙВЕР эмиссии тела b2 (E9.2-3c: КАНОН mode=None —
; выжившая сначала M-строкой m_line ветви M (точное воспроизведение
; enc, иначе H-фолбэк; счёты mcount/hcount — в факт-строку):
; == оракул _emit_lines без mode): шапка (isf == 0 — СЕМЕЙНАЯ:
; шаблон tplb + модуль/target/bss; isf != 0 — ЧУЖАЯ, E9.4-4b-2:
; шаблон ftplb + выводимые факты секций/DLL/RVA секции кода/
; target/bss — == _b2_foreign_text оракула, БЕЗ module), затем
; линейный проход [0, target)
; по разрезам: строка метки (labmap), строка семантики (semstate == 1
; — курсор ri по принятым semrows, размер DD 20 / DQ 8), M/H-строка
; выжившей (sstate == 1 — m_line, при провале emit_h), между разрезами
; — данные DZ/DB (поиск следующего события вперёд — каждый байт
; посещён ≤ 2 раз, линейно); запись <выход>.b2 (CreateFile2
; WRITE/CREATE_ALWAYS — коды 8/9, как wall.exe/uva.exe; outmem
; 8388608 Б). nlen2 — длина слова-пути выхода (аргумент 2 CLI);
; ТЕЛО прохода — ОБЩЕЕ для семьи и чужого (карты L построены с
; base = codevaddr — двойной путь, как оракул _emit_lines)
func emit_body(nlen2, isf)
  var fh
  var rc
  var o
  var hi
  var ri
  outmem = GlobalAlloc(0, 8388608)
  if outmem == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  outbuf = outmem
  outcur = 0
  mcount = 0
  hcount = 0
  if isf == 0
    app_tpl(0, 74)
    outcur = copy_str(outbuf, outcur, exebuf + 77, modlen)
    app_tpl(74, 112)
    out_hexv(target)
    app_tpl(112, 122)
    out_hexv(bss)
    app_tpl(122, 199)
  else
    app_tpl(0, 54)
    app_ftpl(0, 51)
    outcur = out_dec(outbuf, outcur, sectcnt)
    app_ftpl(51, 57)
    outcur = out_dec(outbuf, outcur, dllcnt)
    app_ftpl(57, 94)
    out_hexv(codevaddr)
    app_ftpl(94, 96)
    out_hexv(target)
    app_ftpl(96, 106)
    out_hexv(bss)
    app_ftpl(106, 194)
  end
  o = 0
  ri = 0
  while o < target
    if getb(labmap, o) != 0
      emit_cut(o)
    end
    if getb(semstate, o) == 1
      emit_sem(ri)
      if semrows[3 * ri + 1] == 1
        o = o + 20
      else
        o = o + 8
      end
      ri = ri + 1
    else
      if getb(sstate, o) == 1
        if m_line(o) != 0
          emit_h(o)
          hcount = hcount + 1
        end
        o = o + getb(lenmap, o)
      else
        hi = o + 1
        while hi < target
          if getb(labmap, hi) != 0
            break
          end
          if getb(semstate, hi) != 0
            break
          end
          if getb(sstate, hi) != 0
            break
          end
          hi = hi + 1
        end
        emit_data(o, hi)
        o = hi
      end
    end
  end
  widen(w1, arg2, nlen2)
  fh = CreateFile2(w1, 1073741824, 0, 2, 0)
  if fh == -1
    print_error(s_oout, len(s_oout), 8)
  end
  written = 0
  rc = WriteFile(fh, outbuf, outcur, &written, 0)
  if rc == 0
    print_error(s_wout, len(s_wout), 9)
  end
  CloseHandle(fh)
  return 0
end
