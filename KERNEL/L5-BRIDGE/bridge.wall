str s_gtpl = '3B20554E4956455253414C202F20504547207632202F20D0BCD0BED181D182204252494447452076312028535045432F3135290A3B20D098D181D185D0BED0B4D0BDD0B8D0BA3A20D187D183D0B6D0BED0B920504533322B2028D181D0B5D0BAD186D0B8D0B920'
str s_gdll = ', DLL '
str s_gpev = ')\n!pev2 '
str s_ghdr = '\n!hdr '
str s_gbody = '\n!body '
str s_gsec = '\n!sec '

!include bridge_self_c.wall
!include bridge_self_pe.wall
!include bridge_self_pi.wall
!include bridge_self_pf.wall
!include bridge_self_d.wall
!include bridge_self_d2.wall
!include bridge_self_d3.wall
!include bridge_self_w.wall
!include bridge_self_e.wall
!include bridge_self_l.wall
!include bridge_self_l2.wall
!include bridge_self_m.wall
!include bridge_self_m2.wall
!include bridge_self_m3.wall
!include bridge_self_m4.wall
!include bridge_self_g.wall

func main
  var i
  var fh
  var rc
  var nlen1
  var nlen2
  var nlen3
  hstdout = GetStdHandle(-11)
  cmdline = GetCommandLineA()
  i = skip0()
  i = read_arg(arg1, i)
  nlen1 = wlen
  i = read_arg(arg2, i)
  nlen2 = wlen
  i = read_arg(arg3, i)
  nlen3 = wlen
  check_end(i)
  widen(w1, arg1, nlen1)
  fh = CreateFile2(w1, 1 << 31, 0, 3, 0)
  if fh == -1
    print_error(s_oexe, len(s_oexe), 4)
  end
  exebuf = GlobalAlloc(0, 262145)
  if exebuf == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  exelen = 0
  rc = ReadFile(fh, exebuf, 262145, &exelen, 0)
  if rc == 0
    print_error(s_rexe, len(s_rexe), 5)
  end
  if exelen >= 262145
    print_error(s_big, len(s_big), 7)
  end
  CloseHandle(fh)
  check_head()
  ; РАЗВИЛКА «СЕМЬЯ | ЧУЖОЙ» (E9.4-4b-1/2, SPEC/15 п. 10): общий
  ; check_head (MZ/PE-сигнатура + раскладка от e_lfanew) — далее
  ; семейная цепочка-предикат; не-семья -> ЧУЖОЙ ПУТЬ: фронт P2 ->
  ; импорты (fimp_walk/count_sects — данные шапки и карт L) -> спуск
  ; -> карты (L, base = codevaddr) -> ЭМИССИЯ .b2 КАНОН ЧУЖОГО ТЕЛА
  ; (E9.4-4b-2: шапка из выводимых фактов + M/H-строки, те же ветви
  ; L/M; <выход>.peg — PEG v2, срезы E9.4-4b-3+, файл не создаётся)
  ; -> чужая факт-строка с ВЫХОДОМ M=/H=; отказы обеих сторон —
  ; ERR=FAMILY
  if fam_chain() != 0
    foreign_front()
    fimp_walk()
    count_sects()
    peg2_check()
    walk_code()
    sweep_ins()
    calc_target()
    init_tables()
    build_maps()
    emit_body(nlen2, 1)
    emit_peg2(nlen3)
    print_ffacts()
    ExitProcess(0)
  end
  walk_code()
  sweep_ins()
  calc_target()
  init_tables()
  build_maps()
  emit_body(nlen2, 0)
  emit_peg(nlen3)
  print_facts()
  ExitProcess(0)
end
