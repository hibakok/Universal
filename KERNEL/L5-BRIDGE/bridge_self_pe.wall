; bridge_self_pe.wall — общий фронт PE и семейные проверки моста, часть 1 (E9.2-1, E9.4-4b-1)
; Паспорт: KERNEL/L5-BRIDGE/bridge_self_pe.wall | слой: L5 (исходник — WALL)
; | роль: ветвь P моста, ЧАСТЬ 1 — ОБЩИЙ ФРОНТ ЗАГОЛОВКОВ + СЕМЕЙНЫЕ
; ПРОВЕРКИ-ПРЕДИКАТ (E9.4-4b-1, SPEC/15 п. 10): K5-P005 check_head —
; общий вход (семья и чужой): MZ + сигнатура PE\0\0 по e_lfanew +
; РАСКЛАДКА полей от e_lfanew (lfanew/coffoff/optoff/sizopt/numsect/
; tbloff -> глобали — как lab_pe.parse оракула с E9.4-3a; было —
; фиксированные смещения шаблона SPEC/04); семейные проверки
; K5-P006..P010 — ПРЕДИКАТЫ (0 = ок, 1 = не семейство; было — выход
; ERR=FAMILY; цепочка K5-P018 fam_chain — часть 2 bridge_self_pi.wall,
; развилка «семья | чужой» в main): инварианты SPEC/04 MINUS два
; легальных отклонения (вход 0x1200 SPEC/11 п. 6 и RawSize >
; VirtualSize); чтения — ПО ВЫЧИСЛЯЕМЫМ смещениям (глобали check_head;
; для образов семейства e_lfanew == 0x80 — ЗНАЧЕНИЯ те же,
; нейтральность) и с guard-границами (K5-P004 guard — 0/1; за файлом
; = не семейство, как None/struct.error оракула). Скаляры развилки:
; codevaddr/falign/fend (K5-P008 check_sect: семья 4096/512/
; rawptr+rawsize; спуск ветви W и декодер ветви D работают по ним;
; для семьи rawptr+rawsize == exelen — инвариант P009, нейтрально).
; Имя модуля из DOS-заглушки (K5-P011 stub_name). ИМПОРТЫ семейства
; + ЦЕПОЧКА + ФАКТ-СТРОКА — ЧАСТЬ 2 (bridge_self_pi.wall); ЧУЖОЙ ПУТЬ
; — ЧАСТЬ 3 (bridge_self_pf.wall). Эквивалентность оракулу
; LAB/py/lab_bridge.py (parse_family + lab_pe.parse/check_spec04).

; LE u16 по байтовому смещению i буфера base
func rd16(base, i)
  return getb(base, i) + 256 * getb(base, i + 1)
end

; LE u32 по байтовому смещению i буфера base
func rd32(base, i)
  return getb(base, i) + 256 * getb(base, i + 1) + 65536 * getb(base, i + 2) + 16777216 * getb(base, i + 3)
end

; печать ERR=FAMILY и выход 6 — ОБЩИЙ отказ моста (E9.4-4b-1): не
; семейство И не чужой валидный образ (семейные проверки и чужой
; фронт части 3 сходятся в один код)
func fail_family
  print_error(s_family, len(s_family), 6)
  return 0
end

; проверка границ чтения [off, off+n) из exebuf: 0 — ок, 1 — за
; файлом (как срезка/None/struct.error оракула; вызывающий решает —
; общий отказ check_head или «не семейство» в предикате)
func guard(off, n)
  if off < 0
    return 1
  end
  if off + n > exelen
    return 1
  end
  return 0
end

; K5-P005: ОБЩИЙ фронт заголовков (семья и чужой, E9.4-4b-1): файл
; >= 64 Б (e_lfanew читается), MZ, сигнатура PE\0\0 по e_lfanew
; (границы — guard, общий отказ), раскладка полей ОТ e_lfanew (как
; lab_pe.parse оракула с E9.4-3a): coffoff = lfanew+4, optoff =
; coffoff+0x14, sizopt (SizeOfOptionalHeader) / numsect
; (NumberOfSections) из COFF, tbloff = optoff+sizopt -> глобали.
; Отказ — ОБЩИЙ: не MZ/PE, COFF не читается (ERR=FAMILY)
func check_head
  if exelen < 64
    fail_family()
  end
  if getb(exebuf, 0) != 77 || getb(exebuf, 1) != 90
    fail_family()
  end
  lfanew = rd32(exebuf, 60)
  if guard(lfanew, 4) != 0
    fail_family()
  end
  if getb(exebuf, lfanew) != 80 || getb(exebuf, lfanew + 1) != 69 || getb(exebuf, lfanew + 2) != 0 || getb(exebuf, lfanew + 3) != 0
    fail_family()
  end
  coffoff = lfanew + 4
  if guard(coffoff, 20) != 0
    fail_family()
  end
  optoff = coffoff + 20
  sizopt = rd16(exebuf, coffoff + 16)
  numsect = rd16(exebuf, coffoff + 2)
  tbloff = optoff + sizopt
  return 0
end

; файловый и опциональный заголовки: Machine 0x8664,
; NumberOfSections 1, SizeOfOptionalHeader 0xF0, Characteristics
; 0x0022, Magic 0x020B, Subsystem 3 (SPEC/04); 0 — ок, 1 — не семья
func check_opt
  if guard(optoff, 70) != 0
    return 1
  end
  if rd16(exebuf, coffoff) != 34404
    return 1
  end
  if rd16(exebuf, coffoff + 2) != 1
    return 1
  end
  if rd16(exebuf, coffoff + 16) != 240
    return 1
  end
  if rd16(exebuf, coffoff + 18) != 34
    return 1
  end
  if rd16(exebuf, optoff) != 523
    return 1
  end
  if rd16(exebuf, optoff + 68) != 3
    return 1
  end
  return 0
end

; база и выравнивания: ImageBase 0x140000000 (два dword: низ
; 0x40000000 = 1073741824, верх 1), SectionAlignment 0x1000,
; FileAlignment 0x200; 0 — ок, 1 — не семья
func check_base
  if guard(optoff, 40) != 0
    return 1
  end
  if rd32(exebuf, optoff + 24) != 1073741824
    return 1
  end
  if rd32(exebuf, optoff + 28) != 1
    return 1
  end
  if rd32(exebuf, optoff + 32) != 4096
    return 1
  end
  if rd32(exebuf, optoff + 36) != 512
    return 1
  end
  return 0
end

; секция .text (слот 0 — единственный: numsect == 1 проверен в
; check_opt): имя 8 байт («.text» + нули), VirtualAddress 0x1000,
; Characteristics 0xE0000020; vsize/rawsize/rawptr -> глобали;
; codevaddr/falign/fend — глобали развилки (семья: 4096/512/
; rawptr+rawsize == exelen — инвариант check_size); 0 — ок, 1 — не
; семья (глобали могут быть записаны до отказа — чужой фронт части 3
; перезапишет их до спуска)
func check_sect
  if guard(tbloff, 40) != 0
    return 1
  end
  if getb(exebuf, tbloff) != 46 || getb(exebuf, tbloff + 1) != 116 || getb(exebuf, tbloff + 2) != 101 || getb(exebuf, tbloff + 3) != 120 || getb(exebuf, tbloff + 4) != 116
    return 1
  end
  if getb(exebuf, tbloff + 5) != 0 || getb(exebuf, tbloff + 6) != 0 || getb(exebuf, tbloff + 7) != 0
    return 1
  end
  vsize = rd32(exebuf, tbloff + 8)
  if rd32(exebuf, tbloff + 12) != 4096
    return 1
  end
  rawsize = rd32(exebuf, tbloff + 16)
  rawptr = rd32(exebuf, tbloff + 20)
  ; Characteristics 0xE0000020 (литерали > 2^31-1 в WALL нет — сдвигом)
  if rd32(exebuf, tbloff + 36) != (14 << 28) + 32
    return 1
  end
  codevaddr = 4096
  falign = 512
  fend = rawptr + rawsize
  return 0
end

; размерные инварианты: SizeOfImage == align_up(0x1000+vsize),
; SizeOfHeaders == PointerToRawData (кратно 0x200), SizeOfRawData
; кратно 0x200, размер файла == headers + raw (у семьи exelen ==
; rawptr+rawsize == fend — границы декодера нейтральны), точка входа
; В СЕКЦИИ [0x1000, 0x1000+vsize) — вход 0x1200 легален (SPEC/15
; п. 2); entryrva -> глобаль; 0 — ок, 1 — не семья
func check_size
  var endva
  var hdrs
  if guard(optoff, 64) != 0
    return 1
  end
  endva = (4096 + vsize + 4095) / 4096 * 4096
  if rd32(exebuf, optoff + 56) != endva
    return 1
  end
  hdrs = rd32(exebuf, optoff + 60)
  if hdrs != rawptr
    return 1
  end
  if rawptr % 512 != 0
    return 1
  end
  if rawsize % 512 != 0
    return 1
  end
  if exelen != rawptr + rawsize
    return 1
  end
  entryrva = rd32(exebuf, optoff + 16)
  if entryrva < 4096 || entryrva >= 4096 + vsize
    return 1
  end
  return 0
end

; тело секции не пустое и не состоит из одних нулей (parse_family):
; первый ненулевой байт в [rawptr, rawptr+rawsize); 0 — ок, 1 — не
; семья
func check_body
  var k
  var nz
  if rawsize == 0
    return 1
  end
  nz = 0
  k = 0
  while k < rawsize
    if getb(exebuf, rawptr + k) != 0
      nz = 1
      break
    end
    k = k + 1
  end
  if nz == 0
    return 1
  end
  return 0
end

; DOS-заглушка: префикс «Universal L0 » (13 байт с 0x40), игла
; «. No DOS support.» (16 байт) — первый полный матч в окне
; [0x40+13, 0x80-16]; имя = байты [0x40+13, матч): длина 1..31,
; без пробельных байтов; modlen -> глобаль (имя остаётся в exebuf);
; 0 — ок, 1 — не семья (короткий файл — как усечённая срезка
; оракула: startswith ложен)
func stub_name
  var p
  var j
  var m
  var found
  if guard(64, 48) != 0
    return 1
  end
  p = 0
  while p < 13
    if getb(exebuf, 64 + p) != getb(s_pref, p)
      return 1
    end
    p = p + 1
  end
  found = 0
  p = 77
  while p <= 112
    m = 1
    j = 0
    while j < 16
      if getb(exebuf, p + j) != getb(s_needle, j)
        m = 0
        break
      end
      j = j + 1
    end
    if m == 1
      found = p
      break
    end
    p = p + 1
  end
  if found == 0
    return 1
  end
  modlen = found - 77
  if modlen < 1 || modlen > 31
    return 1
  end
  p = 0
  while p < modlen
    m = getb(exebuf, 77 + p)
    if m >= 9 && m <= 13 || m >= 28 && m <= 31 || m == 32 || m == 133 || m == 160
      return 1
    end
    p = p + 1
  end
  return 0
end
