; uva_self_e.wall — проход 2 ассемблера uva.wall (E7.4-3b)
; Паспорт: KERNEL/L3-UVA/uva_self_e.wall | слой: L3 (исходник — WALL)
; | роль: ветвь E — кодирование инструкций (K3-E001 pass2): повторный
; проход по строкам тем же итератором (проход 1 гарантировал структуру:
; директивы .mem пропускаются, МЕТКИ пропускаются циклом lab_skip — без
; регистрации: структура и дубликаты проверены проходом 1);
; директивы .data (E7.4-3b) — ЭМИССИЯ: тот же итератор K3-T009
; data_next от tend[0], байты пишутся в outbuf+24+pc+dcnt (данные
; заведомо за кодом — pc уже итог прохода 1; dcnt копится заново
; с 0 по порядку появления в исходнике, как datbuf оракула;
; итоговый dcnt для заголовка — по завершении прохода 2);
; мнемоника ищется в таблице (K3-T006 mn_find — индекс i: опкод = i+1,
; 24 имени ISA v0+v1): F1 (i 1..10 и 18..21) — K3-E003 enc_f1
; (mov: 2 операнда, rb = 0; АЛУ v0 и mul/div/mod/sra v1: 3 операнда;
; счёт операндов, потом регистры по порядку — как _enc_f1 оракула),
; halt (i 17) — K3-E002 enc_halt (срез 1: ровно одно число imm32,
; кодировка 12 00 imm32 LE; halt цели-метки НЕ принимает),
; F2 (i 0 или 11..14) — K3-E004 enc_f2 (срез 3: const + ldb/stb/
; ldq/stq — регистры/память по порядку оракула), jmp/jnz (i 15, 16)
; и call (i 22) — K3-E005 enc_f3 (цель — метка или число; call как
; jmp: ровно 1 операнд, байты [23][00][imm32 LE]) и ret (i 23) —
; НОВЫЙ K3-E006 enc_f0 (ровно 0 операндов, 1 байт [24] — формат F0
; SPEC/12 п. 4, как _enc_f0 оракула). Код пишется в outbuf+24
; (за местом заголовка .UP); ошибки операндов — fail_at(lln).
; Срез E7.3-1: только halt (весь остальной разбор — срезы 2-4/E7.4-3a).

; halt imm32 -> outbuf[24+at .. 24+at+6): 12 00 <imm32 LE>
func enc_halt(at)
  setb(outbuf, 24 + at, 18)
  setb(outbuf, 25 + at, 0)
  put32(26 + at, nval)
  return 0
end

; F1: op rd:ra rb -> outbuf[24+at .. 24+at+3); i — индекс мнемоники
; (опкод = i+1): mov (i == 1: ровно 2 операнда, rb = 0), 9 АЛУ v0
; (i = 2..10) и mul/div/mod/sra v1 (i = 18..21) — ровно 3 операнда;
; счёт операндов ПОТОМ регистры по порядку rd, ra, rb (как _enc_f1
; оракула: _want, потом _reg); байты: [op] [rd*16+ra] [rb]
func enc_f1(at, i)
  var rd
  var ra
  if i == 1
    if tcnt != 3
      fail_at(lln)
    end
  else
    if tcnt != 4
      fail_at(lln)
    end
  end
  if parse_reg(1) == 0
    fail_at(lln)
  end
  rd = nval
  if parse_reg(2) == 0
    fail_at(lln)
  end
  ra = nval
  setb(outbuf, 24 + at, i + 1)
  setb(outbuf, 25 + at, rd * 16 + ra)
  if i == 1
    setb(outbuf, 26 + at, 0)
  else
    if parse_reg(3) == 0
      fail_at(lln)
    end
    setb(outbuf, 26 + at, nval)
  end
  return 0
end

; F2: op, rd:ra, imm32 — const (i 0) и память ldb/stb/ldq/stq
; (i 11..14); как _enc_f2 оракула — счёт операндов ПОТОМ операнды
; по порядку: const rD, число (регистр, число; ra = 0; imm32 = число),
; ldb/ldq rD, rA[+смещ] (регистр, память; imm32 = смещ), stb/stq
; rA[+смещ], rB (память, регистр — адрес первым; байт rd:ra =
; адрес:значение; imm32 = смещ). imm32 — младшие 32 бита значения
; (put32; смещение копится mod 2^64 — как маска _i32 оракула)
func enc_f2(at, i)
  var rd
  if tcnt != 3
    fail_at(lln)
  end
  setb(outbuf, 24 + at, i + 1)
  if i == 0
    if parse_reg(1) == 0
      fail_at(lln)
    end
    rd = nval
    if parse_num(2) == 0
      fail_at(lln)
    end
    setb(outbuf, 25 + at, rd * 16)
    put32(26 + at, nval)
  else
    if i == 11 || i == 13
      if parse_reg(1) == 0
        fail_at(lln)
      end
      rd = nval
      if parse_memop(2) == 0
        fail_at(lln)
      end
      setb(outbuf, 25 + at, rd * 16 + nval)
    else
      if parse_memop(1) == 0
        fail_at(lln)
      end
      rd = nval
      if parse_reg(2) == 0
        fail_at(lln)
      end
      setb(outbuf, 25 + at, rd * 16 + nval)
    end
    put32(26 + at, moff)
  end
  return 0
end

; F3-переходы: jmp (i 15), jnz (i 16) и call (i 22) — цель метка
; или число (K3-B004 parse_target); как _enc_f3 оракула — счёт
; операндов ПОТОМ операнды по порядку: jmp/call — ровно 1 (цель),
; байты [16/23][00][imm32 LE] (rd — заполнитель 0, опкод = i+1);
; jnz — ровно 2 (регистр, цель), байты [17][rd][imm32 LE].
; imm32 — младшие 32 бита (put32)
func enc_f3(at, i)
  var rd
  if i == 15 || i == 22
    if tcnt != 2
      fail_at(lln)
    end
    if parse_target(1) == 0
      fail_at(lln)
    end
    setb(outbuf, 24 + at, i + 1)
    setb(outbuf, 25 + at, 0)
    put32(26 + at, nval)
  else
    if tcnt != 3
      fail_at(lln)
    end
    if parse_reg(1) == 0
      fail_at(lln)
    end
    rd = nval
    if parse_target(2) == 0
      fail_at(lln)
    end
    setb(outbuf, 24 + at, 17)
    setb(outbuf, 25 + at, rd)
    put32(26 + at, nval)
  end
  return 0
end

; F0: 1 байт без операндов — ret (i 23): ровно 0 операндов (tcnt == 1
; — только мнемоника, как _want(0) + _enc_f0 оракула), байт [24]
func enc_f0(at)
  if tcnt != 1
    fail_at(lln)
  end
  setb(outbuf, 24 + at, 24)
  return 0
end

; проход 2: кодирование всех инструкций в outbuf+24 + эмиссия байтов
; .data в outbuf+24+pc+dcnt (E7.4-3b; метки строк пропускаются;
; директивы .mem пропускаются — структура проверена проходом 1);
; (идиома итератора — чтение ВПЕРЁД, как pass1: после исчерпания входа
; тело не выполняется, последняя строка не кодируется дважды)
func pass2
  var go
  var at
  var c
  var i
  var more
  at = 0
  dcnt = 0
  lpos = 0
  lln = 0
  go = line_next()
  while go == 1
    if lna < lne
      more = lab_skip()
      while more == 1
        more = lab_skip()
      end
      tokenize(lna, lne)
      if tcnt != 0
        c = getb(srcbuf, tstart[0])
        if c != 46
          i = mn_find(0)
          if i >= 1 && i <= 10 || i >= 18 && i <= 21
            enc_f1(at, i)
            at = at + 3
          else
            if i == 17
              if tcnt != 2
                fail_at(lln)
              end
              if parse_num(1) == 0
                fail_at(lln)
              end
              enc_halt(at)
              at = at + 6
            else
              if i == 0 || i >= 11 && i <= 14
                enc_f2(at, i)
                at = at + 6
              else
                if i == 23
                  enc_f0(at)
                  at = at + 1
                else
                  ; осталось ровно i 15 (jmp), 16 (jnz) и 22 (call)
                  ; — mn_find даёт 0..23, остальные разобраны выше;
                  ; проход 1 гарантировал допустимую мнемонику
                  enc_f3(at, i)
                  at = at + 6
                end
              end
            end
          end
        else
          ; директива: .mem — пропуск (структура проверена проходом 1);
          ; .data — эмиссия байтов (K3-T009 data_next от tend[0];
          ; данные — за кодом: outbuf+24+pc+dcnt, dcnt копится заново
          ; по порядку появления; байты уже валидированы проходом 1)
          if tok_is(0, s_dotdata, len(s_dotdata)) == 1
            dpos = tend[0]
            go = data_next()
            while go == 1
              setb(outbuf, 24 + pc + dcnt, nval)
              dcnt = dcnt + 1
              go = data_next()
            end
          end
        end
      end
    end
    go = line_next()
  end
  return 0
end
