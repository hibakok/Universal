; uva_self_l.wall — проход 1 ассемблера uva.wall (E7.4-3a)
; Паспорт: KERNEL/L3-UVA/uva_self_l.wall | слой: L3 (исходник — WALL)
; | роль: ветвь L — структурный разбор исходника (K3-L001 pass1):
; по строкам (line_next) — комментарии/пустые пропускаются, МЕТКИ
; регистрируются (цикл lab_skip + lab_add — до .mem/мнемоники строки,
; как оракул: дубликат раньше неизвестной мнемоники; метка допустима
; до .mem и на строке с ней; значение = pc до добавления длины
; инструкции строки), затем директива .mem (одна, число 0..67108864;
; повторная/не одно число/плохое число/вне диапазона/неизвестная
; директива — ERR=FORMAT AT=<строка>), мнемоники всех 24 инструкций
; ISA v0+v1 (K3-T006 mn_find: неизвестная — ERR=FORMAT AT=<строка>;
; длины: F1 = 3 (i 1..10 и 18..21 — mov/АЛУ v0 + mul/div/mod/sra v1),
; F3/F2 = 6 (прочие, вкл. call i 22), F0 = 1 (i 23 ret — НОВЫЙ
; одно-байтовый формат, E7.4-3a) — как FMT_LEN оракула). Операнды
; НЕ разбираются (как проход 1 оракула: ошибки операндов — проход 2);
; инструкция без .mem — ERR=FORMAT AT=0001 (строка 1 — как AsmError(1)
; оракула); нет .mem вовсе (включая пустой вход) — AT=0001; .mem без
; инструкций (только метки — pc == 0) — ERR=CODE0 (как make_up
; оракула). Порядок проверок — как у оракула: неизвестная мнемоника
; РАНЬШЕ «нет .mem».

; проход 1: memsize (-1 = нет) + pc (длина кода) + таблица меток
; (lcnt/lsta/lend/lval); ошибки — fail_at
; (идиома итератора: line_next вызывается ВПЕРЁД — тело не выполняется
; после исчерпания входа, иначе lna/lne остались бы от последней строки
; и она обработалась бы дважды)
func pass1
  var go
  var i
  var more
  memsize = -1
  pc = 0
  lcnt = 0
  lpos = 0
  lln = 0
  go = line_next()
  while go == 1
    if lna < lne
      more = lab_skip()
      while more == 1
        lab_add()
        more = lab_skip()
      end
      tokenize(lna, lne)
      if tcnt != 0
        if getb(srcbuf, tstart[0]) == 46
          if tok_is(0, s_dotmem, len(s_dotmem)) == 1
            if memsize != -1
              fail_at(lln)
            end
            if tcnt != 2
              fail_at(lln)
            end
            if parse_num(1) == 0
              fail_at(lln)
            end
            if nval < 0 || nval > 67108864
              fail_at(lln)
            end
            memsize = nval
          else
            fail_at(lln)
          end
        else
          i = mn_find(0)
          if i == -1
            fail_at(lln)
          end
          if memsize == -1
            fail_at(1)
          end
          if i >= 1 && i <= 10 || i >= 18 && i <= 21
            pc = pc + 3
          else
            if i == 23
              pc = pc + 1
            else
              pc = pc + 6
            end
          end
        end
      end
    end
    go = line_next()
  end
  if memsize == -1
    fail_at(1)
  end
  if pc == 0
    print_error(s_code0, len(s_code0), 6)
  end
  return 0
end
