; uva_self_c.wall — сервисный слой ассемблера uva.wall (E7.3-1)
; Паспорт: KERNEL/L3-UVA/uva_self_c.wall | слой: L3 (исходник — WALL)
; | роль: ветвь C ассемблера — печать сообщений (K3-C015 print_error),
; разбор командной строки (K3-C011 skip0 — argv0 с кавычками;
; K3-C012 read_arg — слово-аргумент, предел имени 127; K3-C013
; check_end — ровно два аргумента: вход и выход, третий — справка),
; расширение ANSI -> UTF-16LE (K3-C014 widen — CreateFile2, имя
; LPCWSTR; 7-аргументный CreateFileA недостижим из WALL, SPEC/11 п.3)
; и диагностика разбора (K3-C016 fail_at — ERR=FORMAT AT=<4 hex> + CRLF,
; код 6 — байт-в-байт как fail_format каркаса wall.wall / K2-G002).
; Конвенции — реинкарнации K3-C001..C005 ядра kernel.wall (сериал
; 011 — второй модуль слоя L3, по прецеденту M0-SEED2).

; печать сообщения (msg: адрес, mlen: длина) и выход с кодом code
func print_error(msg, mlen, code)
  WriteFile(hstdout, msg, mlen, &written, 0)
  ExitProcess(code)
end

; пропуск argv0 (кавычки/пробелы/табы) + разделителей; на конце
; командной строки — справка и выход 2; возвращает индекс слова 1
func skip0
  var i
  var c
  var q
  var u
  var d
  i = 0
  c = getb(cmdline, 0)
  if c == 34
    i = i + 1
    q = 1
    while q == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 34
        q = 0
        i = i + 1
      else
        i = i + 1
      end
    end
  else
    u = 1
    while u == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 32
        u = 0
      else
        if c == 9
          u = 0
        else
          i = i + 1
        end
      end
    end
  end
  d = 1
  while d == 1
    c = getb(cmdline, i)
    if c == 0
      print_error(s_use, len(s_use), 2)
    end
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        d = 0
      end
    end
  end
  return i
end

; чтение слова с позиции i в байтовый буфер dst (<= 127 байт + NUL);
; пустое слово (NUL после разделителей) — справка и выход 2;
; слово >= 128 байт — LONG NAME и выход 3; длина слова — в глобаль
; wlen; возвращает позицию после слова
func read_arg(dst, i)
  var c
  var k
  var s
  var w
  s = 1
  while s == 1
    c = getb(cmdline, i)
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        s = 0
      end
    end
  end
  c = getb(cmdline, i)
  if c == 0
    print_error(s_use, len(s_use), 2)
  end
  k = 0
  w = 1
  while w == 1
    c = getb(cmdline, i)
    if c == 0
      w = 0
    else
      if c == 32
        w = 0
      else
        if c == 9
          w = 0
        else
          if k >= 127
            print_error(s_long, len(s_long), 3)
          end
          setb(dst, k, c)
          k = k + 1
          i = i + 1
        end
      end
    end
  end
  wlen = k
  setb(dst, k, 0)
  return i
end

; строго два аргумента (вход + выход): после второго слова — только
; разделители до NUL, иначе (третье слово) — справка и выход 2;
; возвращает позицию конца
func check_end(i)
  var c
  var go
  go = 1
  while go == 1
    c = getb(cmdline, i)
    if c == 0
      go = 0
    else
      if c == 32
        i = i + 1
      else
        if c == 9
          i = i + 1
        else
          print_error(s_use, len(s_use), 2)
        end
      end
    end
  end
  return i
end

; ANSI-имя (n байтов по адресу src) -> UTF-16LE по адресу dst + терминатор
func widen(dst, src, n)
  var k
  var c
  k = 0
  while k < n
    c = getb(src, k)
    setb(dst, 2 * k, c)
    setb(dst, 2 * k + 1, 0)
    k = k + 1
  end
  setb(dst, 2 * n, 0)
  setb(dst, 2 * n + 1, 0)
  return 0
end

; ERR=FORMAT AT=XXXX + CRLF и выход 6: префикс s_fmt, ЗАГЛАВНЫЕ hex-цифры
; номера строки (младшие 16 бит) из s_hexd — как fail_format wall.wall
func fail_at(ln)
  var k
  var sh
  var d
  ln = ln & 65535
  k = 0
  while k < len(s_fmt)
    setb(fmtbuf, k, getb(s_fmt, k))
    k = k + 1
  end
  k = 0
  while k < 4
    sh = 12 - 4 * k
    d = (ln >> sh) & 15
    setb(fmtbuf, len(s_fmt) + k, getb(s_hexd, d))
    k = k + 1
  end
  setb(fmtbuf, len(s_fmt) + 4, 13)
  setb(fmtbuf, len(s_fmt) + 5, 10)
  print_error(fmtbuf, len(s_fmt) + 6, 6)
  return 0
end
