M je $ez_m16 ; K1-E025
M jmp $fail_format ; K1-E025
:ez_m8
M mov eax, B6 ; K1-E025 0F B6
M jmp $ez_mop ; K1-E025
:ez_m16
M mov eax, B7 ; K1-E025 0F B7
:ez_mop
M mov [rip+$t_sub], rax ; K1-E025
M mov eax, 0F ; K1-E025 префикс 0F для emit_rm
M mov [rip+$er_pre], rax ; K1-E016
M mov r8, r13 ; K1-E025 источник (mem)
M add r8, 40 ; K1-E025
M mov ecx, [r13+8] ; K1-E025 regv = dst
M and ecx, 7 ; K1-E025
M xor edx, edx ; K1-E025 НЕТ w (32-бит запись обнуляет)
M cmp qword [r13+8], 8 ; K1-E025
M jl $ez_mem_nor ; K1-E025
M mov edx, 2 ; K1-E025 r
:ez_mem_nor
M mov rax, [rip+$t_sub] ; K1-E025
M call $emit_rm ; K1-E016 (выдаст 0F B6/B7 ...)
M xor eax, eax ; K1-E025
M mov [rip+$er_pre], rax ; K1-E016 сброс префикса
M ret ; K1-E025
; ===== E026 enc_lea (семейство 6) =====
:enc_lea
M cmp qword [r13], 0 ; K1-E026 приёмник — регистр
M jne $fail_format ; K1-E026
M cmp qword [r13+10], 40 ; K1-E026 32/64
M je $le_sz ; K1-E026
M cmp qword [r13+10], 20 ; K1-E026
M jne $fail_format ; K1-E026
:le_sz
M cmp qword [r13+40], 3 ; K1-E026 источник — память
M jne $fail_format ; K1-E026
M cmp qword [r13+50], 0 ; K1-E026 без ключа размера
M jne $fail_format ; K1-E026
M mov eax, 8D ; K1-E026 опк 8D
M mov [rip+$t_opc], rax ; K1-E026
M mov r8, r13 ; K1-E026
M add r8, 40 ; K1-E026 источник
M mov ecx, [r13+8] ; K1-E026 regv = dst
M and ecx, 7 ; K1-E026
M xor edx, edx ; K1-E026
M cmp qword [r13+10], 40 ; K1-E026
M jne $le_now ; K1-E026
M mov edx, 1 ; K1-E026 w
:le_now
M cmp qword [r13+8], 8 ; K1-E026
M jl $le_nor ; K1-E026
M or edx, 2 ; K1-E026
:le_nor
M mov rax, [rip+$t_opc] ; K1-E026
M call $emit_rm ; K1-E016
M ret ; K1-E026
; ===== E027 enc_test (семейство 7) =====
:enc_test
M cmp qword [r13], 0 ; K1-E027 оба регистры
M jne $fail_format ; K1-E027
M cmp qword [r13+40], 0 ; K1-E027
M jne $fail_format ; K1-E027
M mov rax, [r13+10] ; K1-E027 размеры равны
M cmp rax, [r13+50] ; K1-E027
M jne $fail_format ; K1-E027
M mov eax, 85 ; K1-E027 опк 84 (8) / 85
M cmp qword [r13+10], 8 ; K1-E027
M jne $et_have ; K1-E027
M mov eax, 84 ; K1-E027
M jmp $et_go ; K1-E027
:et_have
M mov eax, 85 ; K1-E027
:et_go
M mov [rip+$t_opc], rax ; K1-E027
M mov rcx, [r13+48] ; K1-E027 src
M mov rdx, [r13+8] ; K1-E027 dst
M mov r8, [r13+10] ; K1-E027 размер
M mov rax, [rip+$t_opc] ; K1-E027
M call $emit_rr ; K1-E017
M ret ; K1-E027
; ===== E028 enc_call (семейство 8) =====
:enc_call
M cmp qword [r13], 2 ; K1-E028 ссылка?
M je $ca_ref ; K1-E028
M cmp qword [r13], 3 ; K1-E028 память [rip+..]?
M jne $fail_format ; K1-E028
M cmp qword [r13+30], 0 ; K1-E028 только rip
M je $fail_format ; K1-E028
M cmp qword [r13+10], 0 ; K1-E028 без ключа размера
M jne $fail_format ; K1-E028
M mov eax, 0FF ; K1-E028 FF 15 слот4
M call $emit2 ; K1-E011
M mov eax, 15 ; K1-E028
M call $emit2 ; K1-E011
M mov rcx, [r13+30] ; K1-E028
M mov rdx, [r13+38] ; K1-E028
M mov r8, 4 ; K1-E028
M call $emit_slot ; K1-E013
M ret ; K1-E028
:ca_ref
M cmp qword [r13+28], 4 ; K1-E028 только слот 4
M jne $fail_format ; K1-E028
M mov eax, 0E8 ; K1-E028 E8 слот4
M call $emit2 ; K1-E011
M mov rcx, [r13+18] ; K1-E028
M mov rdx, [r13+20] ; K1-E028
M mov r8, 4 ; K1-E028
M call $emit_slot ; K1-E013
M ret ; K1-E028
; ===== E029 enc_unary: neg/inc/dec (семейство 9) =====
:enc_unary
M cmp qword [r13], 0 ; K1-E029 регистр 32/64
M jne $fail_format ; K1-E029
M cmp qword [r13+10], 40 ; K1-E029
M je $un_sz ; K1-E029
M cmp qword [r13+10], 20 ; K1-E029
M jne $fail_format ; K1-E029
:un_sz
M xor eax, eax ; K1-E029 REX
M cmp qword [r13+10], 40 ; K1-E029
M jne $un_now ; K1-E029
M or eax, 8 ; K1-E029
:un_now
M cmp qword [r13+8], 8 ; K1-E029
M jl $un_nob ; K1-E029
M or eax, 1 ; K1-E029
:un_nob
M or eax, 40 ; K1-E029
M cmp eax, 40 ; K1-E029
M je $un_norex ; K1-E029
M call $emit2 ; K1-E011
:un_norex
M mov eax, [rip+$m_param] ; K1-E029 опк (младший байт)
M movzx eax, al ; K1-E029
M call $emit2 ; K1-E011
M mov eax, [rip+$m_param] ; K1-E029 modrm = C0|ext<<3|код&7
M shr eax, 8 ; K1-E029
M and eax, 7 ; K1-E029
M shl eax, 3 ; K1-E029
M mov rcx, [r13+8] ; K1-E029
M and ecx, 7 ; K1-E029
M or eax, ecx ; K1-E029
M or eax, C0 ; K1-E029
M call $emit2 ; K1-E011
M ret ; K1-E029
; ===== E030 enc_pushpop: push/pop r64 (семейства A/B) =====
:enc_pushpop
M cmp qword [r13], 0 ; K1-E030 регистр 64
M jne $fail_format ; K1-E030
M cmp qword [r13+10], 40 ; K1-E030
M jne $fail_format ; K1-E030
M xor eax, eax ; K1-E030 REX (только B)
M cmp qword [r13+8], 8 ; K1-E030
M jl $pp_nob ; K1-E030
M or eax, 1 ; K1-E030
:pp_nob
M or eax, 40 ; K1-E030
M cmp eax, 40 ; K1-E030
M je $pp_norex ; K1-E030
M call $emit2 ; K1-E011
:pp_norex
M mov eax, [rip+$m_param] ; K1-E030 база 50/58 | код&7
M mov ecx, [r13+8] ; K1-E030
M and ecx, 7 ; K1-E030
M or eax, ecx ; K1-E030
M call $emit2 ; K1-E011
M ret ; K1-E030
; ===== E031 enc_jmp (семейство C) =====
:enc_jmp
M cmp qword [r13], 2 ; K1-E031 только ссылка
M jne $fail_format ; K1-E031
M cmp qword [r13+28], 1 ; K1-E031 rel8?
M je $jm_short ; K1-E031
M cmp qword [r13+28], 4 ; K1-E031 rel32?
M jne $fail_format ; K1-E031
M mov eax, 0E9 ; K1-E031 E9 слот4
M call $emit2 ; K1-E011
M mov rcx, [r13+18] ; K1-E031
M mov rdx, [r13+20] ; K1-E031
M mov r8, 4 ; K1-E031
M call $emit_slot ; K1-E013
M ret ; K1-E031
:jm_short
M mov eax, 0EB ; K1-E031 EB слот1
M call $emit2 ; K1-E011
M mov rcx, [r13+18] ; K1-E031
M mov rdx, [r13+20] ; K1-E031
M mov r8, 1 ; K1-E031
M call $emit_slot ; K1-E013
M ret ; K1-E031
; ===== E032 enc_simple: cdqe/ret/int3 (семейство D) =====
:enc_simple
M mov eax, [rip+$m_param] ; K1-E032 байт 1 (младший)
M movzx eax, al ; K1-E032
M call $emit2 ; K1-E011
M mov rax, [rip+$m_param] ; K1-E032 байт 2 (старший)
M shr eax, 8 ; K1-E032
M test eax, eax ; K1-E032
M jz $sm_done ; K1-E032 однобайтовая
M call $emit2 ; K1-E011
:sm_done
M ret ; K1-E032
; ===== H011 hex16_to_4: 4 hex-цифры в [RDI] =====
:hex16_to_4
M mov ecx, 4 ; K1-H011
M shl eax, 10 ; K1-H011 число в старшие 16 бит
:h4_loop
M rol eax, 4 ; K1-H011
M mov edx, eax ; K1-H011
M and edx, 0F ; K1-H011
M lea r8, [rip+$digits] ; K1-H011
M movzx edx, byte [r8+rdx] ; K1-H011
M mov [rdi], dl ; K1-H011
M inc rdi ; K1-H011
M dec ecx ; K1-H011
M jnz $h4_loop:1 ; K1-H011
M ret ; K1-H011
; ===== G013 fail_format: ERR=FORMAT AT=XXXX + выход 6 =====
:fail_format
M and rsp, -10 ; K1-G013 выравнивание стека (не возвращаемся)
M lea rdi, [rip+$linebuf] ; K1-G013
M lea rsi, [rip+$fmt_pfx] ; K1-G013
M mov ecx, 17 ; K1-G013 23 байта префикса
:ff_loop
M movzx eax, byte [rsi] ; K1-G013
M mov [rdi], al ; K1-G013
M inc rsi ; K1-G013
M inc rdi ; K1-G013
M dec ecx ; K1-G013
M jnz $ff_loop:1 ; K1-G013
M mov eax, [rip+$curline] ; K1-G013
M and eax, 0FFFF ; K1-G013 4 цифры номера строки
M call $hex16_to_4 ; K1-H011
M mov byte [rdi], 0D ; K1-G013
M inc rdi ; K1-G013
M mov byte [rdi], 0A ; K1-G013
M inc rdi ; K1-G013
M lea rdx, [rip+$linebuf] ; K1-G013
M mov r8d, 1D ; K1-G013 29 байт
M call $print_line ; K1-U011
M mov ecx, 6 ; K1-G013 код FORMAT
M call [rip+$iat_ep] ; K1-G013 ExitProcess
M int3 ; K1-G013 страховка
; ===== G012 print_error: errtab[ECX] + выход =====
:print_error
M and rsp, -10 ; K1-G012 выравнивание стека (не возвращаемся)
M sub rsp, 30 ; K1-G012 тень + ячейка кода
M mov eax, ecx ; K1-G012
M shl eax, 4 ; K1-G012 x 16
M cdqe ; K1-G012
M lea rdx, [rip+$errtab] ; K1-G012
M add rdx, rax ; K1-G012 адрес записи
M mov r8d, [rdx+4] ; K1-G012 длина
M mov r9d, [rdx+8] ; K1-G012 код возврата
M mov [rsp+10], r9d ; K1-G012
M mov edx, [rdx] ; K1-G012 RVA строки
M add rdx, rbx ; K1-G012 адрес строки
M call $print_line ; K1-U011
M mov ecx, [rsp+10] ; K1-G012
M call [rip+$iat_ep] ; K1-G012 ExitProcess
M int3 ; K1-G012 страховка
; ===== U011 print_line: RDX = строка, R8D = длина =====
:print_line
M sub rsp, 28 ; K1-U011
M mov rcx, [rip+$hstdout] ; K1-U011
M lea r9, [rip+$written] ; K1-U011
M mov qword [rsp+20], 0 ; K1-U011 без перекрытия
M call [rip+$iat_wf] ; K1-U011 WriteFile
M add rsp, 28 ; K1-U011
M ret ; K1-U011
; ===== C013 next_arg / C014 read_word / C015 copy_word_dst / C016 skip_seps =====
:next_arg
M call $skip_seps ; K1-C016 разделители перед аргументом
M movzx eax, byte [rdi] ; K1-C013
M test al, al ; K1-C013
M jz $na_miss ; K1-C013 аргумента нет
M call $read_word ; K1-C014 RSI/RDI = границы слова
M call $copy_word_dst ; K1-C015 копирование в буфер R8
M test eax, eax ; K1-C013 флаг длинного имени
M jz $na_ok ; K1-C013 уложились
M mov ecx, 1 ; K1-C013 ERR=LONG NAME
M call $print_error ; K1-G012
:na_ok
M ret ; K1-C013
:na_miss
M mov ecx, 0 ; K1-C013 справка
M call $print_error ; K1-G012
:read_word
M mov rsi, rdi ; K1-C014 начало слова
:rw_loop
M movzx eax, byte [rdi] ; K1-C014
M test al, al ; K1-C014
M jz $rw_end ; K1-C014
M cmp al, 20 ; K1-C014
M jz $rw_end ; K1-C014
M cmp al, 09 ; K1-C014
M jz $rw_end ; K1-C014
M inc rdi ; K1-C014
M jmp $rw_loop ; K1-C014
:rw_end
M ret ; K1-C014
:copy_word_dst
M mov r11, r8 ; K1-C015 курсор записи
:cwd_loop
M cmp rsi, rdi ; K1-C015 слово исчерпано?
M jz $cwd_done ; K1-C015
M mov rdx, r11 ; K1-C015
M sub rdx, r8 ; K1-C015 записано байт
M cmp rdx, 7F ; K1-C015 предел буфера
M jae $cwd_long ; K1-C015
M movzx edx, byte [rsi] ; K1-C015
M mov [r11], dl ; K1-C015
M inc rsi ; K1-C015
M inc r11 ; K1-C015
M jmp $cwd_loop ; K1-C015
:cwd_done
M xor eax, eax ; K1-C015 флаг: уложились
M mov [r11], al ; K1-C015 NUL
M ret ; K1-C015
:cwd_long
M mov byte [r11], 0 ; K1-C015 NUL на границе
M mov eax, 1 ; K1-C015 флаг: длиннее 127
M ret ; K1-C015
:skip_seps
M movzx eax, byte [rdi] ; K1-C016
M cmp al, 20 ; K1-C016
M jz $ss_adv ; K1-C016
M cmp al, 09 ; K1-C016
M jz $ss_adv ; K1-C016
M ret ; K1-C016
:ss_adv
M inc rdi ; K1-C016
M jmp $skip_seps ; K1-C016
; ===== F011..F015: файловые операции (реинкарнации K1-F001..F005) =====
:open_file_read
M sub rsp, 38 ; K1-F011
M mov edx, 80000000 ; K1-F011 GENERIC_READ
M mov r8d, 1 ; K1-F011 FILE_SHARE_READ
M xor r9d, r9d ; K1-F011 SA=NULL
M mov qword [rsp+20], 3 ; K1-F011 OPEN_EXISTING
M mov qword [rsp+28], 80 ; K1-F011 NORMAL
M mov qword [rsp+30], 0 ; K1-F011 шаблон
M call [rip+$iat_cf] ; K1-F011 CreateFileA
M add rsp, 38 ; K1-F011
M ret ; K1-F011
:create_file_write
M sub rsp, 38 ; K1-F012
M mov edx, 40000000 ; K1-F012 GENERIC_WRITE
M xor r8d, r8d ; K1-F012
M xor r9d, r9d ; K1-F012
M mov qword [rsp+20], 2 ; K1-F012 CREATE_ALWAYS
M mov qword [rsp+28], 80 ; K1-F012
M mov qword [rsp+30], 0 ; K1-F012
M call [rip+$iat_cf] ; K1-F012
M add rsp, 38 ; K1-F012
M ret ; K1-F012
:close_file
M sub rsp, 28 ; K1-F013
M call [rip+$iat_ch] ; K1-F013 CloseHandle
M add rsp, 28 ; K1-F013
M ret ; K1-F013
:read_whole_dst
M sub rsp, 28 ; K1-F014
M mov qword [rsp+20], 0 ; K1-F014 без перекрытия
M call [rip+$iat_rf] ; K1-F014 ReadFile
M add rsp, 28 ; K1-F014
M test rax, rax ; K1-F014
M jnz $rwf_ok ; K1-F014
M mov rax, -1 ; K1-F014
M ret ; K1-F014
:rwf_ok
M mov eax, [r9] ; K1-F014 счётчик
M ret ; K1-F014
:write_all
M sub rsp, 28 ; K1-F015
M mov [rip+$wa_len], r8 ; K1-F015 длина
M lea r9, [rip+$written] ; K1-F015
M mov qword [rsp+20], 0 ; K1-F015 без перекрытия
M call [rip+$iat_wf] ; K1-F015 WriteFile
M add rsp, 28 ; K1-F015
M test rax, rax ; K1-F015
M jz $wa_err ; K1-F015
M mov rax, [rip+$written] ; K1-F015 записано
M cmp rax, [rip+$wa_len] ; K1-F015 равно длине?
M jne $wa_err ; K1-F015
M xor eax, eax ; K1-F015 успех
M ret ; K1-F015
:wa_err
M mov eax, 1 ; K1-F015
M ret ; K1-F015

