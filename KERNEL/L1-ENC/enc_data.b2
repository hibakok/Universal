; ===== K1-D017 таблица импортов kernel32.dll =====
:idt
DD $intt 0 0 $dll_name $iat ; описатель импорта
DZ 14 ; терминатор IDT (нулевая запись)
:iat
:iat_gsh
DQ $hint_gsh ; IAT: GetStdHandle
:iat_wf
DQ $hint_wf ; IAT: WriteFile
:iat_ep
DQ $hint_ep ; IAT: ExitProcess
:iat_gcl
DQ $hint_gcl ; IAT: GetCommandLineA
:iat_cf
DQ $hint_cf ; IAT: CreateFileA
:iat_rf
DQ $hint_rf ; IAT: ReadFile
:iat_ch
DQ $hint_ch ; IAT: CloseHandle
DQ 0 ; IAT: терминатор
:intt
DQ $hint_gsh $hint_wf $hint_ep $hint_gcl $hint_cf $hint_rf $hint_ch 0 ; INT: копия IAT
:dll_name
DB 6B 65 72 6E 65 6C 33 32 2E 64 6C 6C 00 ; kernel32.dll
DZ 2 ; чётность RVA hint-записей (+1 калибровка E6.4c: код enc_imul нечётен)
:hint_gsh
DB 00 00 47 65 74 53 74 64 48 61 6E 64 6C 65 00 ; GetStdHandle
DZ 1 ; выравнивание
:hint_wf
DB 00 00 57 72 69 74 65 46 69 6C 65 00 ; WriteFile
:hint_ep
DB 00 00 45 78 69 74 50 72 6F 63 65 73 73 00 ; ExitProcess
:hint_gcl
DB 00 00 47 65 74 43 6F 6D 6D 61 6E 64 4C 69 6E 65 ; GetCommandLineA
DB 41 00 ; GetCommandLineA (конец)
:hint_cf
DB 00 00 43 72 65 61 74 65 46 69 6C 65 41 00 ; CreateFileA
:hint_rf
DB 00 00 52 65 61 64 46 69 6C 65 00 ; ReadFile
DZ 1 ; выравнивание
:hint_ch
DB 00 00 43 6C 6F 73 65 48 61 6E 64 6C 65 00 ; CloseHandle

