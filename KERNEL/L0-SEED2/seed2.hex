@01A0 00 00 00 00 ; SH: таблица релокаций = 0
@01A4 00 00 00 00 ; SH: таблица строк = 0
@01A8 00 00 00 00 ; SH: счётчики релокаций/строк = 0
@01AC 20 00 00 E0 ; SH: признаки = CODE|EXEC|READ|WRITE
Z 01B0 0200
