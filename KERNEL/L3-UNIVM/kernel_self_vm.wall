; kernel_self_vm.wall — цикл интерпретатора UNIVM, срез E7.2-2 (E7.2)
; Паспорт: KERNEL/L3-UNIVM/kernel_self_vm.wall | слой: L3 (исходник — WALL)
; | роль: ветвь V ядра — K3-V001 interp (цикл: порядок проверок
; SPEC/12 п. 7 — выборка/опкод/длина/поля/исполнение), кирпичи опкодов
; среза 2: K3-V101 op_const .. K3-V111 op_eq (const/mov/add/sub/and/or/
; xor/shl/shr/lt/eq — регистры UNIVM в глобальном массиве regs[16]),
; K3-V002 op_halt (останов: rd-заполнитель + imm32 = код возврата, шаг
; считается), K3-V003 fail_trap (диагностика «U-L3-UNIVM TRAP=n STEPS=s»,
; код 1) и хелперы K3-C006 copy_str / K3-C007 out_dec (десятичные числа
; в буфер — diagnose-строки).
; Срез E7.2-3: опкоды 0C..0F (память) ИСПОЛНЕНЫ — кирпичи ветви M
; (kernel_self_mem.wall): op_ldb/op_stb/op_ldq/op_stq — RAM, окно
; устройств (окно+0 = консоль — WriteFile байтом) и ловушки 3/4
; (границы SPEC/12 п. 3.3; беззнаковые пределы < 2^31 — фильтр
; «a >> 31» + знаковые сравнения после него, см. шапку mem-части).
; Срез E7.2-4 (ФИНАЛ этапа 7): опкоды 10..11 (переходы) ИСПОЛНЕНЫ —
; кирпичи ветви J (kernel_self_j.wall): op_jmp/op_jnz; ПРЕДЕЛ ШАГОВ —
; проверка «steps >= steplim -> ловушка 6» В НАЧАЛЕ итерации interp,
; ДО выборки pc (порядок как у оракула run(max_steps): программа,
; чей сток кода совпал с пределом, даёт trap 6, не trap 2; halted
; (ExitProcess в op_halt) предел не встречает); глобаль steplim
; задаёт K3-C008 read_lim (2-й аргумент CLI, умолчание 200000000).
; Срез E7.4-2b: опкоды ALU v1 13..16 (mul/div/mod/sra) ИСПОЛНЕНЫ —
; кирпичи части alu (kernel_self_alu.wall, ветвь V): K3-V113 op_mul,
; K3-V114 op_div, K3-V115 op_mod, K3-V116 op_sra + фундамент K3-V112
; udivmod (беззнаковое деление из простых операций — беззнаковое
; сравнение переворотом знакового бита, пути b <= 2^63 (цикл) и
; b > 2^63 (частное 0/1); ловушка 7 — деление на ноль у div/mod).
; Срез E7.4-2c: опкоды 17..18 (call/ret) ИСПОЛНЕНЫ — кирпичи части
; call (kernel_self_call.wall, ветвь V): K3-V117 op_call (занести
; pc+6 в стек вызовов, pc := imm32; полон — ловушка 5) и K3-V118
; op_ret (pc := адрес возврата; пуст — ловушка 5) — аппаратный стек
; вызовов глубины 1024 — глобали cstack[1024]/csp (SPEC/12 п. 3.4).
; ISA v0+v1 исполнена полностью (24 опкода 01..18): заглушек нет,
; для опкодов 00/19+ ловушка 1 — сразу (SPEC/12 п. 7 (2)). RAM
; распределяется в read_up (get_ram, ветвь M) — глобаль ram;
; консоль среза 3 наблюдаема (результаты ALU/памяти видны через
; вывод — T-E7-16; v1-опкоды — T-E7-33/34).

; копия n байтов с адреса src в dst с позиции k; возврат — новая позиция
func copy_str(dst, k, src, n)
  var j
  var c
  j = 0
  while j < n
    c = getb(src, j)
    setb(dst, k + j, c)
    j = j + 1
  end
  return k + n
end

; десятичная запись числа v (>= 0, < 2^31) в dst с позиции k,
; без ведущих нулей; возврат — новая позиция
func out_dec(dst, k, v)
  var t[20]
  var j
  var n
  n = 0
  if v == 0
    setb(dst, k, 48)
    return k + 1
  end
  while v > 0
    setb(t, n, 48 + v % 10)
    v = v / 10
    n = n + 1
  end
  j = 0
  while j < n
    setb(dst, k + j, getb(t, n - 1 - j))
    j = j + 1
  end
  return k + n
end

; диагностика ловушки n со счётчиком шагов steps и выход кодом 1
; (контракт E7.2: «U-L3-UNIVM TRAP=<n> STEPS=<s>\r\n»)
func fail_trap(n)
  var k
  k = 0
  k = copy_str(trapbuf, k, s_trap, len(s_trap))
  k = out_dec(trapbuf, k, n)
  k = copy_str(trapbuf, k, s_steps, len(s_steps))
  k = out_dec(trapbuf, k, steps)
  k = copy_str(trapbuf, k, s_crlf, len(s_crlf))
  written = 0
  WriteFile(hstdout, trapbuf, k, &written, 0)
  ExitProcess(1)
  return 0
end

; исполнение const (F2, опкод 0x01) по pc: rd := sext(imm32) — imm32
; знаковое, расширяется до 64 бит (бит 31 задан -> вычесть 2^32; литерали
; > 2^31-1 в WALL нет — порог вычисляется сдвигом imm >> 31).
; Проверки (1)-(3) — в interp; здесь (4) ra-заполнитель != 0 ->
; ловушка 1, затем (5) исполнение; pc += 6, шаг считается
func op_const
  var b1
  var rd
  var imm
  b1 = getb(codebuf, pc + 1)
  rd = b1 >> 4
  if (b1 & 15) != 0
    fail_trap(1)
  end
  imm = rd32(codebuf, pc + 2)
  if (imm >> 31) == 1
    imm = imm - (1 << 32)
  end
  regs[rd] = imm
  pc = pc + 6
  steps = steps + 1
  return 0
end

; исполнение mov (F1, опкод 0x02) по pc: rd := ra (rb — заполнитель).
; Проверки (1)-(3) — в interp; здесь (4) rb != 0 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_mov
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 != 0
    fail_trap(1)
  end
  regs[rd] = regs[ra]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение add (F1, опкод 0x03) по pc: rd := (ra + rb) mod 2^64
; (аппаратное сложение WALL даёт тот же битовый образ, беззнаковость
; не требуется). Проверки (1)-(3) — в interp; здесь (4) rb > 15 ->
; ловушка 1, затем (5) исполнение; pc += 3, шаг считается
func op_add
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] + regs[b2]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение sub (F1, опкод 0x04) по pc: rd := (ra - rb) mod 2^64.
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_sub
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] - regs[b2]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение and (F1, опкод 0x05) по pc: rd := ra AND rb (побитово).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_and
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] & regs[b2]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение or (F1, опкод 0x06) по pc: rd := ra OR rb (побитово).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_or
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] | regs[b2]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение xor (F1, опкод 0x07) по pc: rd := ra XOR rb (побитово).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_xor
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] ^ regs[b2]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение shl (F1, опкод 0x08) по pc: rd := ra << (rb AND 63)
; (аппаратный shl заворачивается mod 2^64 — битовый образ тот же).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_shl
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] << (regs[b2] & 63)
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение shr (F1, опкод 0x09) по pc: rd := ra >> (rb AND 63) —
; логический сдвиг (WALL >> компилируется в x86 shr — логический,
; битовый образ совпадает с беззнаковым UNIVM).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_shr
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] >> (regs[b2] & 63)
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение lt (F1, опкод 0x0A) по pc: rd := 1, если ra < rb (знаково,
; дополнение до двух), иначе 0 — сравнение WALL знаковое 64-битное,
; семантика та же, что у SPEC/12 п. 5 (отдельные трюки не нужны).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_lt
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  if regs[ra] < regs[b2]
    regs[rd] = 1
  else
    regs[rd] = 0
  end
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение eq (F1, опкод 0x0B) по pc: rd := 1, если ra = rb, иначе 0.
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается. Скобки-обход дефекта
; №23 wall.exe (pp_pcount) СНЯТЫ фиксом E7.2-2F: «индекс == индекс»
; снова легален (скобки были прозрачны для вывода — байт тот же)
func op_eq
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  if regs[ra] == regs[b2]
    regs[rd] = 1
  else
    regs[rd] = 0
  end
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение halt (F3, опкод 0x12) по pc: проверка поля rd и останов.
; Проверки (3) длина и (1)(2) уже сделаны в interp; здесь (4)(5):
; rd-заполнитель -> ловушка 1; imm32 = код возврата; шаг считается
func op_halt
  var rd
  var imm
  rd = getb(codebuf, pc + 1)
  if rd != 0
    fail_trap(1)
  end
  imm = rd32(codebuf, pc + 2)
  steps = steps + 1
  ExitProcess(imm)
  return 0
end

; цикл интерпретатора, срез E7.4-2c: регистры + ALU v0 (01..0B) +
; память и устройства (0C..0F — ветвь M) + переходы (10..11 — ветвь J)
; + halt (12) + ALU v1 (13..16 — часть alu ветви V: mul/div/mod/sra,
; div/mod с ловушкой 7) + call/ret (17..18 — часть call ветви V:
; аппаратный стек вызовов cstack[1024]/csp, ловушка 5); порядок
; проверок — SPEC/12 п. 7:
; (0) предел шагов — steps >= steplim -> ловушка 6 (диагностика
; хозяина исполнения, ДО выборки pc — как оракул run(max_steps));
; (1) pc за кодом -> ловушка 2; (2) опкод вне 01..18 -> ловушка 1
; (ISA v0+v1 полна — 24 опкода);
; (3) длина: F1 (3 Б) для 02..0B и 13..16, F2/F3 (6 Б) для остальных,
; КРОМЕ ret (18, формат F0 — 1 Б: pc < codesize уже доказано в (1),
; обрезка невозможна) — pc+длина за кодом -> ловушка 2;
; (4)(5) — в кирпичах опкодов
func interp
  var op
  var go
  go = 1
  while go == 1
    if steps >= steplim
      fail_trap(6)
    end
    if pc >= codesize
      fail_trap(2)
    end
    op = getb(codebuf, pc)
    if op < 1 || op > 24
      fail_trap(1)
    end
    if op != 24
      if op >= 2 && op <= 11 || op >= 19 && op <= 22
        if pc + 3 > codesize
          fail_trap(2)
        end
      else
        if pc + 6 > codesize
          fail_trap(2)
        end
      end
    end
    if op == 1
      op_const()
      continue
    end
    if op == 2
      op_mov()
      continue
    end
    if op == 3
      op_add()
      continue
    end
    if op == 4
      op_sub()
      continue
    end
    if op == 5
      op_and()
      continue
    end
    if op == 6
      op_or()
      continue
    end
    if op == 7
      op_xor()
      continue
    end
    if op == 8
      op_shl()
      continue
    end
    if op == 9
      op_shr()
      continue
    end
    if op == 10
      op_lt()
      continue
    end
    if op == 11
      op_eq()
      continue
    end
    if op == 12
      op_ldb()
      continue
    end
    if op == 13
      op_stb()
      continue
    end
    if op == 14
      op_ldq()
      continue
    end
    if op == 15
      op_stq()
      continue
    end
    if op == 16
      op_jmp()
      continue
    end
    if op == 17
      op_jnz()
      continue
    end
    if op == 18
      op_halt()
    end
    if op == 19
      op_mul()
      continue
    end
    if op == 20
      op_div()
      continue
    end
    if op == 21
      op_mod()
      continue
    end
    if op == 22
      op_sra()
    end
    if op == 23
      op_call()
      continue
    end
    if op == 24
      op_ret()
      continue
    end
  end
  return 0
end
