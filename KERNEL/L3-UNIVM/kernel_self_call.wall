; kernel_self_call.wall — стек вызовов ядра UNIVM, срез E7.4-2c (E7.4)
; Паспорт: KERNEL/L3-UNIVM/kernel_self_call.wall | слой: L3 (исходник — WALL,
; слой L2) | роль: ветвь V ядра — часть call (выделена из
; kernel_self_vm.wall по лимиту 500 строк, по прецеденту alu-части
; kernel_self_alu.wall): кирпичи call/ret — ISA v1, опкоды 0x17/0x18
; (SPEC/12 п. 5, форматы F3/F0) и АППАРАТНЫЙ СТЕК ВЫЗОВОВ глубины
; 1024 (SPEC/12 п. 3.4) — глобали cstack[1024]/csp.
; Кирпичи: K3-V117 op_call, K3-V118 op_ret (карточки —
; MAP/M3-UNIVM-V.md).
; Стек вызовов — состояние УПРАВЛЕНИЯ (как pc), не данные программы:
; программа не может читать/писать cstack (SPEC/12 п. 3.4 — ошибка
; в данных не искажает адреса возврата; безопасность SPEC/06).
; Адрес возврата — pc+6: аппаратное сложение WALL (pc < 2^31 —
; codesize <= 2^26 по SPEC/13, переполнения нет; тот же образ, что
; у оракула pc+6). imm32 у call — БЕЗЗНАКОВОЕ (F3, как jmp): rd32
; даёт 0..2^32-1 в qword, присваивание pc битово совпадает с
; оракулом (self.pc = imm); цель НЕ проверяется — выход pc за код =
; ловушка 2 на следующей итерации interp (как у jmp, SPEC/12 п. 7).
; ret — формат F0 (1 байт): полей нет, проверять нечего; длина не
; проверяется — pc < codesize уже доказано в interp (п. 7 (1)),
; pc+1 <= codesize всегда.
; Порядок проверок SPEC/12 п. 7: (1)-(3) — в interp; здесь (4) поля
; (rd-заполнитель != 0 -> ловушка 1) ПЕРЕД (5) исполнением (стек
; полон -> ловушка 5): мусорное поле при полном стеке даёт 1, не 5.
; Диффтест — T-E7-34 (секция 14 батареи; корпуса —
; lab_t_kernel_corpus_v1.py).

; исполнение call (F3, опкод 0x17) по pc: занести pc+6 в стек
; вызовов, pc := imm32 (беззнаковое). Проверки (1)-(3) — в interp;
; здесь (4) rd-заполнитель != 0 -> ловушка 1, затем (5) стек полон
; (csp >= 1024) -> ловушка 5 (команда с ловушкой в счётчик шагов
; не входит); затем занос и переход; шаг считается
func op_call
  var rd
  var imm
  rd = getb(codebuf, pc + 1)
  if rd != 0
    fail_trap(1)
  end
  if csp >= 1024
    fail_trap(5)
  end
  cstack[csp] = pc + 6
  csp = csp + 1
  imm = rd32(codebuf, pc + 2)
  pc = imm
  steps = steps + 1
  return 0
end

; исполнение ret (F0, опкод 0x18) по pc: pc := адрес возврата из
; стека вызовов. Поля отсутствуют (формат F0); (5) стек пуст
; (csp = 0) -> ловушка 5 (команда с ловушкой в счётчик шагов не
; входит); иначе извлечение и переход; шаг считается
func op_ret
  if csp == 0
    fail_trap(5)
  end
  csp = csp - 1
  pc = cstack[csp]
  steps = steps + 1
  return 0
end
