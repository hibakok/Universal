; kernel_self_alu.wall — опкоды ALU v1 (13..16) ядра UNIVM, срез E7.4-2b
; Паспорт: KERNEL/L3-UNIVM/kernel_self_alu.wall | слой: L3 (исходник — WALL,
; слой L2) | роль: ветвь V ядра — часть alu (выделена из kernel_self_vm.wall
; по лимиту 500 строк, по прецеденту M1-ENC-E/M1-ENC-S): кирпичи опкодов
; ISA v1 mul/div/mod/sra (SPEC/12 п. 5, опкоды 0x13..0x16, формат F1) и
; их фундамент K3-V112 udivmod — беззнаковое деление, общее для div/mod.
; Кирпичи: K3-V112 udivmod, K3-V113 op_mul, K3-V114 op_div, K3-V115
; op_mod, K3-V116 op_sra (карточки — MAP/M3-UNIVM-V.md).
; Почему деление кирпичом, а не оператором WALL: деление WALL ЗНАКОВОЕ
; (idiv, усечение к нулю — SPEC/11 п. 1), а UNIVM требует БЕЗЗНАКОВОГО
; (SPEC/12 п. 5). Беззнаковость собирается из простых операций (принцип
; кирпичности SPEC/12 п. 2):
;   - беззнаковое сравнение a >= b == знаковое (a ^ 2^63) >= (b ^ 2^63):
;     переворот знакового бита выравнивает порядки (литерали > 2^31-1
;     в WALL нет — 2^63 строится сдвигом s = 1 << 63);
;   - b > 2^63 (беззнаково) — частное 0/1 без цикла: a < 2^64 <= 2b,
;     а в цикле сдвиг r << 1 переполнил бы 64 бита (r может быть >= 2^63);
;   - иначе — восстанавливающее деление бит за битом (64 итерации):
;     инвариант r < b <= 2^63 -> бит 63 у r чист -> r << 1 не переполняет.
; sra собирается из логического сдвига (WALL >> — x86 shr, логический):
;   v >= 0 (знаково) — логический сдвиг совпадает с арифметическим;
;   v < 0 — (v >> n) | маска верхних n битов (маска = -(1 << (64-n)),
;   т.е. ~(2^(64-n) - 1); n = 0 — без изменения).
; mul — прямо оператором WALL (младшие 64 бита знакового и беззнакового
; произведения совпадают — битовый образ тот же).
; Проверки (1)-(3) — в interp (kernel_self_vm.wall); здесь (4) проверка
; полей (rb > 15 -> ловушка 1) и (5) исполнение. Прототип алгоритмов
; (до интеграции) — фаззи LAB/ai/probe_e742b.py: 139 случаев (div 69,
; sra 44, mul 26) против эталона Python — все зелёные.

; беззнаковое деление a на b (ПРЕДУСЛОВИЕ: b != 0 — проверяет вызывающий
; кирпич): глобали uq = a div b, ur = a mod b (SPEC/12 п. 5 — частное и
; остаток беззнакового деления 64-битных слов). Вход/выход через глобали
; — как pc/steps/regs (один фундамент на два кирпича: div берёт uq,
; mod берёт ur; конвенция «один кирпич — одна функция» сохранена)
func udivmod(a, b)
  var i
  var r
  var s
  s = 1 << 63
  if (b ^ s) > 0
    ; b > 2^63 беззнаково (b ^ s > 0 знаково == b - 2^63 > 0):
    ; a < 2^64 <= 2b — частное 0 или 1, остаток a или a - b
    uq = 0
    ur = a
    if (a ^ s) >= (b ^ s)
      uq = 1
      ur = a - b
    end
    return 0
  end
  ; b <= 2^63: восстанавливающее деление бит за битом, старший бит a
  ; вниз: r = 2r + бит; r >= b (беззнаково) — вычесть, бит частного 1.
  ; Инвариант r < b <= 2^63 — сдвиг r << 1 не переполняет 64 бита
  uq = 0
  r = 0
  i = 63
  while i >= 0
    r = (r << 1) | ((a >> i) & 1)
    if (r ^ s) >= (b ^ s)
      r = r - b
      uq = uq | (1 << i)
    end
    i = i - 1
  end
  ur = r
  return 0
end

; исполнение mul (F1, опкод 0x13) по pc: rd := (ra × rb) mod 2^64 —
; младшие 64 бита произведения (WALL * = imul: у знакового и беззнакового
; умножения младшие 64 бита совпадают — трюки не нужны).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_mul
  var b1
  var b2
  var rd
  var ra
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  regs[rd] = regs[ra] * regs[b2]
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение div (F1, опкод 0x14) по pc: rd := ra div rb — беззнаковое
; частное. Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) значение regs[rb] = 0 -> ловушка 7 (деление на ноль —
; ПОСЛЕ проверки полей, порядок SPEC/12 п. 7; команда, вызвавшая
; ловушку, в счётчик шагов не входит); затем udivmod; pc += 3
func op_div
  var b1
  var b2
  var rd
  var ra
  var x
  var y
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  y = regs[b2]
  if y == 0
    fail_trap(7)
  end
  x = regs[ra]
  udivmod(x, y)
  regs[rd] = uq
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение mod (F1, опкод 0x15) по pc: rd := остаток беззнакового
; деления ra на rb. Проверки как у div: (4) rb > 15 -> ловушка 1,
; (5) regs[rb] = 0 -> ловушка 7; фундамент тот же (udivmod, берётся
; ur); pc += 3, шаг считается
func op_mod
  var b1
  var b2
  var rd
  var ra
  var x
  var y
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  y = regs[b2]
  if y == 0
    fail_trap(7)
  end
  x = regs[ra]
  udivmod(x, y)
  regs[rd] = ur
  pc = pc + 3
  steps = steps + 1
  return 0
end

; исполнение sra (F1, опкод 0x16) по pc: rd := sext(ra) >> (rb AND 63) —
; арифметический сдвиг вправо, знак сохраняется (SPEC/12 п. 5). Из
; логического сдвига WALL: v >= 0 (знаково) — совпадает; v < 0 —
; (v >> n) | маска верхних n битов (n > 0; маска = -(1 << (64-n))).
; Проверки (1)-(3) — в interp; здесь (4) rb > 15 -> ловушка 1,
; затем (5) исполнение; pc += 3, шаг считается
func op_sra
  var b1
  var b2
  var rd
  var ra
  var v
  var n
  b1 = getb(codebuf, pc + 1)
  b2 = getb(codebuf, pc + 2)
  ra = b1 & 15
  rd = b1 >> 4
  if b2 > 15
    fail_trap(1)
  end
  v = regs[ra]
  n = regs[b2] & 63
  if v < 0
    if n > 0
      v = (v >> n) | (-(1 << (64 - n)))
    end
  else
    v = v >> n
  end
  regs[rd] = v
  pc = pc + 3
  steps = steps + 1
  return 0
end
