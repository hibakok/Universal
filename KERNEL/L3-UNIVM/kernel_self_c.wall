; kernel_self_c.wall — сервисный слой ядра kernel.wall (E7.2-1)
; Паспорт: KERNEL/L3-UNIVM/kernel_self_c.wall | слой: L3 (исходник — WALL)
; | роль: ветвь C ядра — печать сообщений (K3-C005 print_error),
; разбор командной строки (K3-C001 skip0 — argv0 с кавычками;
; K3-C002 read_arg — слово-аргумент, предел имени 127; K3-C003
; check_end — не более двух аргументов: после пути и необязательного
; предела — только разделители; K3-C008 read_lim — необязательный
; второй аргумент, предел шагов программы, срез E7.2-4)
; и расширение ANSI -> UTF-16LE (K3-C004 widen — CreateFile2, имя
; LPCWSTR; 7-аргументный CreateFileA недостижим из WALL, SPEC/11 п.3).
; Сообщения — байт-в-байт из строк s_* корня kernel.wall; коды выхода
; 2 (usage) и 3 (LONG NAME). Конвенции — как сервис M2-WALL
; wall_self_c.wall (карточки K2-C001/C003 — реинкарнации).

; печать сообщения (msg: адрес, mlen: длина) и выход с кодом code
func print_error(msg, mlen, code)
  WriteFile(hstdout, msg, mlen, &written, 0)
  ExitProcess(code)
end

; пропуск argv0 (кавычки/пробелы/табы, как K3-C001) + разделителей;
; на конце командной строки — usage и выход 2; возвращает индекс слова 1
func skip0
  var i
  var c
  var q
  var u
  var d
  i = 0
  c = getb(cmdline, 0)
  if c == 34
    i = i + 1
    q = 1
    while q == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 34
        q = 0
        i = i + 1
      else
        i = i + 1
      end
    end
  else
    u = 1
    while u == 1
      c = getb(cmdline, i)
      if c == 0
        print_error(s_use, len(s_use), 2)
      end
      if c == 32
        u = 0
      else
        if c == 9
          u = 0
        else
          i = i + 1
        end
      end
    end
  end
  d = 1
  while d == 1
    c = getb(cmdline, i)
    if c == 0
      print_error(s_use, len(s_use), 2)
    end
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        d = 0
      end
    end
  end
  return i
end

; чтение слова с позиции i в байтовый буфер dst (<= 127 байт + NUL);
; пустое слово (NUL после разделителей) — usage и выход 2;
; слово >= 128 байт — LONG NAME и выход 3 (cwd_long);
; длина слова — в глобальную wlen; возвращает позицию после слова
func read_arg(dst, i)
  var c
  var k
  var s
  var w
  s = 1
  while s == 1
    c = getb(cmdline, i)
    if c == 32
      i = i + 1
    else
      if c == 9
        i = i + 1
      else
        s = 0
      end
    end
  end
  c = getb(cmdline, i)
  if c == 0
    print_error(s_use, len(s_use), 2)
  end
  k = 0
  w = 1
  while w == 1
    c = getb(cmdline, i)
    if c == 0
      w = 0
    else
      if c == 32
        w = 0
      else
        if c == 9
          w = 0
        else
          if k >= 127
            print_error(s_long, len(s_long), 3)
          end
          setb(dst, k, c)
          k = k + 1
          i = i + 1
        end
      end
    end
  end
  wlen = k
  setb(dst, k, 0)
  return i
end

; строго не более двух аргументов (путь + необязательный предел
; шагов): после слова — только разделители до NUL, иначе (третье
; слово) — usage и выход 2; возвращает позицию конца
func check_end(i)
  var c
  var go
  go = 1
  while go == 1
    c = getb(cmdline, i)
    if c == 0
      go = 0
    else
      if c == 32
        i = i + 1
      else
        if c == 9
          i = i + 1
        else
          print_error(s_use, len(s_use), 2)
        end
      end
    end
  end
  return i
end

; ANSI-имя (n байтов по адресу src) -> UTF-16LE по адресу dst + терминатор
func widen(dst, src, n)
  var k
  var c
  k = 0
  while k < n
    c = getb(src, k)
    setb(dst, 2 * k, c)
    setb(dst, 2 * k + 1, 0)
    k = k + 1
  end
  setb(dst, 2 * n, 0)
  setb(dst, 2 * n + 1, 0)
  return 0
end

; необязательный второй аргумент CLI — предел шагов программы (срез
; E7.2-4, SPEC/12 п. 7): после слова-пути пропускает разделители;
; конец строки — умолчание 200000000; иначе слово — только десятичные
; цифры 48..57, значение 0..2147483647 (переполнение: v > 214748364
; до умножения — v*10+d < 2^31+2 без заворота, финальная проверка
; v > 2147483647), не-цифра/переполнение — usage и выход 2;
; результат — глобаль steplim; возврат — позиция после слова
func read_lim(i)
  var c
  var v
  var s
  var go
  s = 1
  while s == 1
    c = getb(cmdline, i)
    if c == 0
      s = 0
    else
      if c == 32 || c == 9
        i = i + 1
      else
        s = 0
      end
    end
  end
  c = getb(cmdline, i)
  if c == 0
    steplim = 200000000
    return i
  end
  v = 0
  go = 1
  while go == 1
    c = getb(cmdline, i)
    if c == 0 || c == 32 || c == 9
      go = 0
    else
      if c < 48 || c > 57
        print_error(s_use, len(s_use), 2)
      end
      if v > 214748364
        print_error(s_use, len(s_use), 2)
      end
      v = v * 10 + c - 48
      i = i + 1
    end
  end
  if v > 2147483647
    print_error(s_use, len(s_use), 2)
  end
  steplim = v
  return i
end
