; kernel_self_j.wall — переходы ядра, срез E7.2-4 (E7.2)
; Паспорт: KERNEL/L3-UNIVM/kernel_self_j.wall | слой: L3 (исходник — WALL)
; | роль: ветвь J ядра — кирпичи переходов: K3-J101 op_jmp (опкод 0x10)
; и K3-J102 op_jnz (опкод 0x11), формат F3 (6 байт): [op][rd][imm32 LE]
; (SPEC/12 п. 4-5). Отдельная часть (не расширение vm.wall) — лимит
; 500 строк: interp срезов 2-3 уже 441 строка, предел шагов среза 4
; добавляет проверку в цикл (по образцу разреза kernel_self_mem.wall).
;
; imm32 — БЕЗЗНАКОВОЕ смещение в коде (SPEC/12 п. 4): rd32 даёт
; 0..2^32-1 в qword — присваивание pc битово совпадает с оракулом
; (self.pc = imm). Цель перехода здесь НЕ проверяется: выход pc за
; код — ловушка 2 на следующей итерации interp (порядок проверок
; SPEC/12 п. 7 (1); диффтест: «jnz на плохую цель» — trap 2 после
; выполненного перехода). pc+6 у jnz — аппаратное сложение WALL:
; pc < 2^31 (codesize <= 2^26 по SPEC/13) и imm32 < 2^32 — отдельной
; ловушки переполнения нет, битовый образ совпадает с оракулом.

; исполнение jmp (F3, опкод 0x10) по pc: pc := imm32 (беззнаковое).
; Проверки (1)-(3) — в interp; здесь (4) rd-заполнитель != 0 ->
; ловушка 1 (SPEC/12 п. 7), затем (5) исполнение; шаг считается
func op_jmp
  var rd
  var imm
  rd = getb(codebuf, pc + 1)
  if rd != 0
    fail_trap(1)
  end
  imm = rd32(codebuf, pc + 2)
  pc = imm
  steps = steps + 1
  return 0
end

; исполнение jnz (F3, опкод 0x11) по pc: если regs[rd] != 0, то
; pc := imm32 (беззнаковое), иначе pc := pc + 6 (переход не взят).
; Проверки (1)-(3) — в interp; здесь (4) rd > 15 -> ловушка 1
; (номер регистра; биты 4-7 байта rd — мусор, SPEC/12 п. 7),
; затем (5) исполнение; шаг считается в обоих плечах
func op_jnz
  var rd
  var imm
  rd = getb(codebuf, pc + 1)
  if rd > 15
    fail_trap(1)
  end
  imm = rd32(codebuf, pc + 2)
  if regs[rd] != 0
    pc = imm
  else
    pc = pc + 6
  end
  steps = steps + 1
  return 0
end
